{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% style %}
      main {
        text-align: center;
      }
      main img {
        display: unset;
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main>
      <div class="shopify-section">
        <h1>{{ gift_card.balance | money }}</h1>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p>{{ 'gift_card.expired' | t }}</p>
        {% endif %}

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
          <p>
            {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
          </p>
        {% endif %}

        <p>
          {% if settings.logo %}
            {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
          {% else %}
            <img
              src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.card' | t | escape }}"
              width="300"
              height="200"
            >
          {% endif %}
        </p>

        <h2>{{ shop.name }}</h2>
        <p>{{ 'gift_card.use_at_checkout' | t }}</p>
        <p>{{ gift_card.code | format_code }}</p>
        <div id="GiftCardQrCode" data-identifier="{{ gift_card.qr_identifier }}" aria-label="{{ 'gift_card.qr_code' | t | escape }}"></div>
        <p class="gift-card__actions">
          <button type="button" data-gift-card-print>{{ 'gift_card.print' | t }}</button>
          <a href="{{ routes.root_url | escape }}">{{ 'gift_card.continue_shopping' | t }}</a>
        </p>

        {% if gift_card.pass_url %}
          <a href="{{ gift_card.pass_url | escape }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t | escape }}"
              width="200"
              height="60"
            >
          </a>
        {% endif %}
      </div>
    </main>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>
      window.addEventListener('load', function () {
        var qrCode = document.getElementById('GiftCardQrCode');
        if (qrCode && qrCode.dataset.identifier && window.QRCode) {
          new window.QRCode(qrCode, { text: qrCode.dataset.identifier, width: 120, height: 120 });
        }
        var printButton = document.querySelector('[data-gift-card-print]');
        if (printButton) printButton.addEventListener('click', function () { window.print(); });
      });
    </script>
  </body>
</html>
