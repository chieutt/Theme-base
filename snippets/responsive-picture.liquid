{% doc %}
  Renders a responsive image with an optional mobile source, so the browser
  downloads only the source that matches the current viewport.

  @param {image} image - Desktop or fallback image.
  @param {image} [mobile_image] - Mobile-specific image.
  @param {number} [max_width] - Largest desktop generated image width.
  @param {number} [mobile_max_width] - Largest mobile generated image width.
  @param {number} [mobile_breakpoint] - Largest viewport width that uses the mobile source.
  @param {string} [widths] - Desktop responsive source widths.
  @param {string} [mobile_widths] - Mobile responsive source widths.
  @param {string} [sizes] - Image sizes attribute.
  @param {string} [class] - Image class names.
  @param {string} [alt] - Alternative text override.
  @param {boolean} [decorative] - Whether the image is decorative.
  @param {string} [loading] - Browser loading behavior.
  @param {string} [fetchpriority] - Browser fetch priority.
  @param {boolean} [preload] - Whether Shopify should emit an early preload hint.
  @param {string} [decoding] - Native image decoding behavior.
  @param {string} [style] - Inline style declarations for the fallback image.
{% enddoc %}

{% liquid
  assign responsive_mobile_max_width = mobile_max_width | default: max_width
  assign responsive_mobile_widths = mobile_widths | default: widths | default: responsive_mobile_max_width
  assign responsive_mobile_breakpoint = mobile_breakpoint | default: 749
%}

{% if mobile_image != blank %}
  <picture>
    <source
      media="(max-width: {{ responsive_mobile_breakpoint }}px)"
      srcset="
        {% assign responsive_width_values = responsive_mobile_widths | split: ',' %}
        {% for responsive_width in responsive_width_values %}
          {% assign responsive_width_value = responsive_width | strip %}
          {{ mobile_image | image_url: width: responsive_width_value }} {{ responsive_width_value }}w{% unless forloop.last %}, {% endunless %}
        {% endfor %}
      "
      sizes="{{ sizes }}"
    >
{% endif %}
  {% render 'responsive-image', image: image, max_width: max_width, widths: widths, sizes: sizes, class: class, alt: alt, decorative: decorative, loading: loading, fetchpriority: fetchpriority, preload: preload, decoding: decoding, style: style %}
{% if mobile_image != blank %}
  </picture>
{% endif %}
