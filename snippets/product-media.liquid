{% if media != blank %}
  {% assign media_zoom_mode = zoom_mode | default: 'open_lightbox' %}
  {% assign media_loading = loading | default: 'lazy' %}
  {% assign media_fetchpriority = fetchpriority | default: 'auto' %}
  {% assign media_alt = media.alt | default: product.title %}
  {% if media_alt == blank %}
    {% assign media_alt = 'accessibility.image' | t %}
  {% endif %}
  <figure class="product-media product-media--{{ media.media_type }}{% if selected %} is-selected{% endif %}{% if media.media_type == 'image' and media_zoom_mode != 'none' %} product-media--interactive{% endif %}" data-product-media data-media-id="{{ media.id }}"{% if media.media_type == 'image' and media_zoom_mode != 'none' %} data-zoom-mode="{{ media_zoom_mode }}" tabindex="0" role="button" aria-label="{{ 'product_media.view_image' | t: image: media_alt | escape }}"{% endif %}>
    {% case media.media_type %}
      {% when 'image' %}
        {{ media | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 1150px) 40vw, 100vw', loading: media_loading, fetchpriority: media_fetchpriority, alt: media_alt }}
      {% when 'video', 'external_video' %}
        {{ media | media_tag: image_size: '1200x', controls: true, preload: 'metadata' }}
      {% when 'model' %}
        {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
    {% endcase %}
  </figure>
{% endif %}
