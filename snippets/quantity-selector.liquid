{% doc %}
  Renders a product quantity input.

  @param {variant} variant
  @param {block} block
  @param {string} [form_id]
  @param {string} section_id
  @param {boolean} [associate_with_form]
{% enddoc %}
{% assign quantity_min = variant.quantity_rule.min | default: 1 %}
{% assign quantity_input_key = form_id | default: section_id %}
{% assign quantity_input_id = 'Quantity-' | append: quantity_input_key %}
<div class="quantity-selector" {{ block.shopify_attributes }} data-quantity-selector>
  <label for="{{ quantity_input_id }}">{{ 'quantity.label' | t }}</label>
  <div class="quantity-selector__control">
    <button type="button" data-quantity-decrease aria-label="{{ 'quantity.decrease' | t | escape }}">−</button>
    <input id="{{ quantity_input_id }}" type="number" name="quantity" value="{{ quantity_min }}" min="{{ quantity_min }}"{% if variant.quantity_rule.max != blank %} max="{{ variant.quantity_rule.max }}"{% endif %} step="{{ variant.quantity_rule.increment | default: 1 }}" inputmode="numeric" aria-label="{{ 'quantity.label' | t | escape }}"{% if associate_with_form and form_id != blank %} form="{{ form_id }}"{% endif %} data-quantity-input>
    <button type="button" data-quantity-increase aria-label="{{ 'quantity.increase' | t | escape }}">+</button>
  </div>
</div>
