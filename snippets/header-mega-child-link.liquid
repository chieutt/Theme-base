{% liquid
  assign child_has_destination = false
  if child_link.url != blank and child_link.url != '#'
    assign child_has_destination = true
  endif
%}

{% if child_link.links != blank %}
  {% if is_mobile_navigation %}
    {% if child_has_destination %}
      <a class="header__mobile-menu-direct-link" href="{{ child_link.url | escape }}"{% if child_link.current %} aria-current="page"{% endif %}><span class="{{ navigation_label_class }}">{{ child_link.title | escape }}</span></a>
    {% else %}
      <span class="header__mega-category-title">{{ child_link.title | escape }}</span>
    {% endif %}
  {% elsif child_has_destination %}
    <a class="header__mega-category-link" href="{{ child_link.url | escape }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
  {% else %}
    <span class="header__mega-category-title">{{ child_link.title | escape }}</span>
  {% endif %}
  <ul class="header__mega-nested" role="list">
    {% for grandchild_link in child_link.links %}
      <li>
        {% if grandchild_link.url != blank and grandchild_link.url != '#' %}
          <a class="header__mega-link header__mega-link--nested{% if grandchild_link.current %} header__mega-link--active{% endif %}" href="{{ grandchild_link.url | escape }}"{% if grandchild_link.current %} aria-current="page"{% endif %}><span class="header__mega-link-text hover-underline {{ navigation_label_class }}">{{ grandchild_link.title | escape }}</span></a>
        {% else %}
          <span class="header__mega-link header__mega-link--nested"><span class="header__mega-link-text hover-underline {{ navigation_label_class }}">{{ grandchild_link.title | escape }}</span></span>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% elsif child_has_destination %}
  <a class="header__mega-link{% if child_link.current %} header__mega-link--active{% endif %}" href="{{ child_link.url | escape }}"{% if child_link.current %} aria-current="page"{% endif %}><span class="{{ navigation_label_class }}">{{ child_link.title | escape }}</span></a>
{% else %}
  <span class="header__mega-link"><span class="{{ navigation_label_class }}">{{ child_link.title | escape }}</span></span>
{% endif %}
