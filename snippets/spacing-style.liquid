{%- doc -%}
  Renders responsive spacing custom properties from block or section settings.
  Values above 20px use the shared spacing scale.
{%- enddoc -%}

{%- liquid
  assign scale_min = 20
  assign keys = 'padding-block-start,padding-block-end,padding-inline-start,padding-inline-end' | split: ','
-%}

{%- for key in keys -%}
  {%- assign value = settings[key] -%}
  {%- if value == blank -%}
    {%- case key -%}
      {%- when 'padding-block-start' -%}
        {%- assign value = settings.padding_top -%}
      {%- when 'padding-block-end' -%}
        {%- assign value = settings.padding_bottom -%}
      {%- when 'padding-inline-start' -%}
        {%- assign value = settings.padding_left -%}
      {%- when 'padding-inline-end' -%}
        {%- assign value = settings.padding_right -%}
    {%- endcase -%}
  {%- endif -%}
  {%- if value != blank -%}
    --{{ key }}: {% if value > scale_min %}max({{ scale_min }}px, calc(var(--spacing-scale) * {{ value }}px)){% else %}{{ value }}px{% endif %};
  {%- endif -%}
{%- endfor -%}
