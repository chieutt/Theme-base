{% doc %}
  Renders a storefront interface icon.

  @param {string} name - Icon name.
  @param {string} [class] - Optional class names added to the SVG.
{% enddoc %}

{% liquid
  assign icon_class_attribute = blank
  if class != blank
    assign icon_class_value = class | escape
    assign icon_class_attribute = ' class="' | append: icon_class_value | append: '"'
  endif
%}

{% case name %}
  {% when 'menu' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {% when 'close' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
  {% when 'search' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  {% when 'account' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 20c.6-3.3 3-5.25 6.5-5.25s5.9 1.95 6.5 5.25"/></svg>
  {% when 'bag' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8.5h14l-1 12H6l-1-12Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg>
  {% when 'bag-simple' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8.5h14v11H5zM9 8.5V6a3 3 0 0 1 6 0v2.5"/></svg>
  {% when 'chevron-down' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="m3 4.5 3 3 3-3"/></svg>
  {% when 'chevron-down-wide' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 12 8" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1 5 5 5-5"/></svg>
  {% when 'chevron-up' %}
    <svg{{ icon_class_attribute }} width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M15 12.5 10 7.5 5 12.5"/></svg>
  {% when 'chevron-left' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5 7.5 12l7 7"/></svg>
  {% when 'chevron-right' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9.5 5 7 7-7 7"/></svg>
  {% when 'caret-right' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="rtl-flip-x"><path d="m4.5 3 3 3-3 3"/></svg>
  {% when 'arrow-right' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="rtl-flip-x"><path d="M3 10h13M11 5l5 5-5 5"/></svg>
  {% when 'button-arrow' %}
    <svg{{ icon_class_attribute }} width="11" height="9" viewBox="0 0 11 9" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M0.599976 4.10001H9.59998M6.09998 7.60001L9.59998 4.10001L6.09998 0.600006"/></svg>
  {% when 'arrow-up-right' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 19 5M9 5h10v10"/></svg>
  {% when 'plus' %}
    <svg{{ icon_class_attribute }} width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M10 4V16M4 10H16"/></svg>
  {% when 'minus' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 12 12" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round"><path d="M2 6h8"/></svg>
  {% when 'filter' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 18 18" aria-hidden="true" focusable="false"><path d="M3 5h12M5 9h8M7 13h4" fill="none" stroke="currentColor" stroke-linecap="round"/><circle cx="6" cy="5" r="1.2" fill="currentColor"/><circle cx="11" cy="9" r="1.2" fill="currentColor"/><circle cx="9" cy="13" r="1.2" fill="currentColor"/></svg>
  {% when 'filter-sliders' %}
    <svg{{ icon_class_attribute }} width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15.5312 10.7948H14.4596C14.2319 9.23504 12.8855 8.03336 11.2635 8.03336C9.64159 8.03336 8.29522 9.23504 8.06747 10.7948H0.46875C0.209875 10.7948 0 11.0047 0 11.2635C0 11.5224 0.209875 11.7323 0.46875 11.7323H8.06747C8.29522 13.2921 9.64159 14.4938 11.2635 14.4938C12.8855 14.4938 14.2319 13.2921 14.4596 11.7323H15.5312C15.7901 11.7323 16 11.5224 16 11.2635C16 11.0047 15.7901 10.7948 15.5312 10.7948ZM11.2635 13.5563C9.99934 13.5563 8.97084 12.5278 8.97084 11.2635C8.97084 9.99936 9.99934 8.97086 11.2635 8.97086C12.5278 8.97086 13.5562 9.99936 13.5562 11.2635C13.5562 12.5278 12.5278 13.5563 11.2635 13.5563Z" fill="currentColor"/><path d="M0.46875 5.20522H1.54037C1.76813 6.76497 3.1145 7.96666 4.73647 7.96666C6.35841 7.96666 7.70478 6.76497 7.93253 5.20522H15.5312C15.7901 5.20522 16 4.99535 16 4.73647C16 4.4776 15.7901 4.26772 15.5312 4.26772H7.93253C7.70478 2.70794 6.35841 1.50626 4.73647 1.50626C3.1145 1.50626 1.76813 2.70794 1.54037 4.26772H0.46875C0.209875 4.26772 0 4.4776 0 4.73647C0 4.99535 0.209875 5.20522 0.46875 5.20522ZM4.73647 2.44376C6.00066 2.44376 7.02916 3.47226 7.02916 4.73647C7.02916 6.00066 6.00066 7.02916 4.73647 7.02916C3.47225 7.02916 2.44375 6.00066 2.44375 4.73647C2.44375 3.47226 3.47225 2.44376 4.73647 2.44376Z" fill="currentColor"/></svg>
  {% when 'check' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 14 11" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m1 5.5 3.5 3.5L13 1"/></svg>
  {% when 'globe' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.2 2.3 3.3 5.1 3.3 8.5S14.2 18.2 12 20.5M12 3.5C9.8 5.8 8.7 8.6 8.7 12s1.1 6.2 3.3 8.5"/></svg>
  {% when 'play' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none"><path d="m9 7 8 5-8 5Z" fill="currentColor"/></svg>
  {% when 'play-outline' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 20 20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.4"><path d="m8 5 6 5-6 5Z"/></svg>
  {% when 'pause' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 20 20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"><path d="M7 5v10M13 5v10"/></svg>
  {% when 'truck' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
  {% when 'note' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h11v8H8l-4 4v-12Z"/><path d="m13.5 3 2.5 2.5-5.8 5.8-3 .7.7-3L13.5 3Z"/></svg>
  {% when 'document' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="14" height="17" rx="1"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
  {% when 'shipping' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 9a7 7 0 1 0 1 6.7"/><path d="M18 4v5h-5"/></svg>
  {% when 'tag' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5 11.5 4H18a2 2 0 0 1 2 2v6.5L12.5 20 4 11.5Z"/><circle cx="15.5" cy="8.5" r="1"/></svg>
  {% when 'discount' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="m12 2.8 2.1 1.4 2.5-.1 1.2 2.2 2.2 1.2-.1 2.5 1.4 2.1-1.4 2.1.1 2.5-2.2 1.2-1.2 2.2-2.5-.1L12 21.2l-2.1-1.4-2.5.1-1.2-2.2-2.2-1.2.1-2.5L2.8 12l1.4-2.1-.1-2.5 2.2-1.2 1.2-2.2 2.5.1L12 2.8Z"/><path d="m8.8 15.2 6.4-6.4M9.1 9.3h.1m5.7 5.4h.1" fill="none" stroke="var(--color-background, #fff)" stroke-width="1.7" stroke-linecap="round"/><circle cx="9.15" cy="9.25" r="1.05" fill="none" stroke="var(--color-background, #fff)" stroke-width="1.5"/><circle cx="14.85" cy="14.75" r="1.05" fill="none" stroke="var(--color-background, #fff)" stroke-width="1.5"/></svg>
  {% when 'return' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7H5l3-3M5 7h9a5 5 0 0 1 0 10H9"/></svg>
  {% when 'heart' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.7c0 5.2-8.8 10.1-8.8 10.1S3.2 13.9 3.2 8.7A4.7 4.7 0 0 1 12 6.3a4.7 4.7 0 0 1 8.8 2.4Z"/></svg>
  {% when 'box' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="m4 7 8-4 8 4v10l-8 4-8-4V7Z"/><path d="m4 7 8 4 8-4M12 11v10"/></svg>
  {% when 'shield' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 19 6v5c0 4.5-2.8 7.8-7 10-4.2-2.2-7-5.5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
  {% when 'sparkles' %}
    <svg{{ icon_class_attribute }} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 1.2 4.8L18 9l-4.8 1.2L12 15l-1.2-4.8L6 9l4.8-1.2L12 3Z"/><path d="m19 14 .6 2.4L22 17l-2.4.6L19 20l-.6-2.4L16 17l2.4-.6L19 14Z"/></svg>
{% endcase %}
