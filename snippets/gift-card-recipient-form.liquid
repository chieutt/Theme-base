{% doc %}
  Renders the Shopify gift card recipient properties for gift card products.

  @param {product} product
  @param {string} form_id
  @param {string} section_id
  @param {string} block_id
{% enddoc %}
{% if product.gift_card? %}
  {% assign recipient_form_key = form_id | default: section_id %}
  {% assign recipient_form_id = 'GiftCardRecipient-' | append: recipient_form_key | append: '-' | append: block_id %}
  <details class="gift-card-recipient-form" data-gift-card-recipient-form data-form-id="{{ form_id }}" data-section-id="{{ section_id }}" data-block-id="{{ block_id }}">
    <summary>{{ 'gift_card.recipient_toggle' | t }}</summary>
    <label class="gift-card-recipient-form__toggle">
      <input type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" value="true" aria-controls="{{ recipient_form_id }}" data-gift-card-recipient-toggle>
      <span>{{ 'gift_card.recipient_toggle' | t }}</span>
    </label>
    <div id="{{ recipient_form_id }}" class="gift-card-recipient-form__fields" data-gift-card-recipient-fields hidden>
      <label>
        <span>{{ 'gift_card.recipient_email' | t }}</span>
        <input type="email" name="properties[Recipient email]" autocomplete="email" disabled data-gift-card-recipient-field data-gift-card-recipient-email aria-describedby="{{ recipient_form_id }}-error">
      </label>
      <label>
        <span>{{ 'gift_card.recipient_name' | t }}</span>
        <input type="text" name="properties[Recipient name]" autocomplete="name" disabled data-gift-card-recipient-field>
      </label>
      <label>
        <span>{{ 'gift_card.recipient_message' | t }}</span>
        <textarea name="properties[Message]" rows="3" maxlength="200" disabled data-gift-card-recipient-field></textarea>
      </label>
      <label>
        <span>{{ 'gift_card.recipient_send_on' | t }}</span>
        <input type="date" name="properties[Send on]" disabled data-gift-card-recipient-field data-gift-card-recipient-send-on>
      </label>
      <input type="hidden" name="properties[__shopify_offset]" value="" disabled data-gift-card-recipient-offset>
      <p id="{{ recipient_form_id }}-error" data-gift-card-recipient-error role="alert" hidden></p>
    </div>
  </details>
{% endif %}
