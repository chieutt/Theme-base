{% if variant != blank %}
  {% liquid
    assign selling_plan_allocation = variant.selected_selling_plan_allocation
    if selling_plan_allocation == blank and variant.requires_selling_plan
      assign selling_plan_allocation = variant.selling_plan_allocations | first
    endif
    assign display_price = variant.price
    assign display_compare_at_price = variant.compare_at_price
    assign display_unit_price = variant.unit_price
    if selling_plan_allocation != blank
      assign display_price = selling_plan_allocation.price
      assign display_compare_at_price = selling_plan_allocation.compare_at_price
      assign display_unit_price = selling_plan_allocation.unit_price
    endif
  %}
  {% assign on_sale = false %}
  {% if display_compare_at_price > display_price %}{% assign on_sale = true %}{% endif %}
  {% assign discount_amount = display_compare_at_price | minus: display_price %}
  {% assign discount_percentage = discount_amount | times: 100.0 | divided_by: display_compare_at_price | round %}
  <div class="product-price product-price--{{ block.settings.price_size }}{% if on_sale %} product-price--sale{% endif %}" data-product-price {{ block.shopify_attributes }}>
    <span class="product-price__current" data-price>{% render 'money', amount: display_price %}</span>
    <s class="product-price__compare{% unless on_sale %} is-hidden{% endunless %}" data-compare-price>{% render 'money', amount: display_compare_at_price %}</s>
    <small class="product-price__unit" data-unit-price{% if variant.unit_price_measurement == blank or display_unit_price == blank %} hidden{% endif %}>
      {% if variant.unit_price_measurement != blank and display_unit_price != blank %}{% render 'money', amount: display_unit_price %} / {{ variant.unit_price_measurement.reference_value }}{{ variant.unit_price_measurement.reference_unit }}{% endif %}
    </small>
    {% if settings.show_sale_badge %}
      <span class="product-badge product-badge--sale product-price__sale-badge" data-sale-badge data-discount-mode="{{ block.settings.show_discount_percentage }}"{% unless on_sale %} hidden{% endunless %}>
        <span data-sale-badge-value>{% if block.settings.show_discount_percentage %}{{ discount_percentage }}% OFF{% else %}{% render 'money', amount: discount_amount %} OFF{% endif %}</span>
      </span>
    {% endif %}
    {% unless settings.hide_shipping_content %}
      {% if cart.taxes_included or shop.shipping_policy.body != blank %}
        <small class="product-price__shipping" data-shipping-content>
          {% if cart.taxes_included %}{{ 'product.taxes_included' | t }}{% endif %}
          {% if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url | escape }}">{{ 'product.shipping_at_checkout' | t }}</a>{% endif %}
        </small>
      {% endif %}
    {% endunless %}
  </div>
{% endif %}
