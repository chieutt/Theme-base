<section class="product-payment" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <{{ block.settings.html_tag | default: 'h2' }} class="product-payment__heading {% render 'typography-class', preset: block.settings.heading_size, fallback: 'h5' %}">{{ block.settings.heading | escape }}</{{ block.settings.html_tag | default: 'h2' }}>
  {% endif %}
  {% if shop.enabled_payment_types.size > 0 %}
    <ul class="product-payment__icons" role="list" aria-label="{{ 'payment_methods.accepted' | t | escape }}">
      {% for type in shop.enabled_payment_types %}
        <li>{{ type | payment_type_svg_tag }}</li>
      {% endfor %}
    </ul>
  {% endif %}
  {% if block.settings.note != blank %}
    <p class="product-payment__note spinel-text--{{ block.settings.text_size | default: 'small' }} content-text--{{ block.settings.text_size | default: 'small' }}">{{ block.settings.note | escape }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product payment",
  "settings": [
    {
      "type": "header",
      "content": "Product payment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pay With"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "t:typography_options.display_extra_large"
        },
        {
          "value": "h1",
          "label": "t:typography_options.display_large"
        },
        {
          "value": "h2",
          "label": "t:typography_options.display_medium"
        },
        {
          "value": "h3",
          "label": "t:typography_options.heading_extra_large"
        },
        {
          "value": "h4",
          "label": "t:typography_options.heading_large"
        },
        {
          "value": "h5",
          "label": "t:typography_options.heading_medium"
        },
        {
          "value": "h6",
          "label": "t:typography_options.heading_small"
        },
        {
          "value": "h7",
          "label": "t:typography_options.heading_extra_small"
        },
        {
          "value": "custom",
          "label": "t:typography_options.custom"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "x-large",
          "label": "X-large"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "x-small",
          "label": "X-small"
        }
      ],
      "default": "small"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Your transaction is protected with advanced security measures to keep your information confidential."
    }
  ]
}
{% endschema %}
