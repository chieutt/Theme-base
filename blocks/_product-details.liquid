{% assign product = closest.product | default: product %}
{% assign payment_terms_form_id = 'product-payment-terms-form-' | append: section.id %}
{% if template.suffix != blank %}{% assign payment_terms_form_id = payment_terms_form_id | append: '-' | append: template.suffix %}{% endif %}
{% assign details_class = 'product-form product-details' %}
{% capture details_style %}--product-sticky-offset: {{ block.settings.desktop_top_offset | default: 24 }}px;{% endcapture %}
{% unless block.settings.enable_sticky %}{% assign details_class = details_class | append: ' product-details--not-sticky' %}{% endunless %}
<div class="{{ details_class }}" style="{{ details_style }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
  {% if product != blank %}
    {% form 'product', product, id: payment_terms_form_id, class: 'product-payment-terms', data-payment-terms-form: '' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-payment-terms-variant-id>
      {{ form | payment_terms }}
    {% endform %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Product details",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Keep details sticky on desktop",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_top_offset",
      "label": "Sticky offset",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
