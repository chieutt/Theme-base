{% assign product = closest.product | default: product %}
{% if product != blank %}
  {% render 'product-media-gallery', product: product, selected_variant: product.selected_or_first_available_variant, block: block %}
{% else %}
  <div class="product-gallery product-gallery--placeholder product-gallery--ratio-{{ block.settings.media_ratio | default: '4-5' }}" {{ block.shopify_attributes }}>
    <div class="product-gallery__media">
      <div class="product-gallery__main">
        <figure class="product-media">
          {% render 'media-placeholder', class_name: 'product-media__image', placeholder_name: 'product-1' %}
        </figure>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product media gallery",
  "settings": [
    {
      "type": "header",
      "content": "Product media gallery"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
{
  "type": "select",
  "id": "image_zoom",
  "label": "Image zoom",
  "options": [
    {
      "value": "open_lightbox",
      "label": "Open lightbox"
    },
    {
      "value": "click_hover",
      "label": "Click and hover"
    },
    {
      "value": "none",
      "label": "No zoom"
    }
  ],
  "default": "open_lightbox"
},
{
  "type": "select",
  "id": "grid_columns",
      "label": "Grid columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2",
      "visible_if": "{{ block.settings.desktop_layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "grid_layout",
      "label": "Grid layout",
      "options": [
        {
          "value": "editorial",
          "label": "Editorial 1–2–1–2"
        },
        {
          "value": "uniform",
          "label": "Uniform columns"
        }
      ],
      "default": "editorial",
      "visible_if": "{{ block.settings.desktop_layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "carousel_thumbnails",
      "label": "Carousel thumbnails",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "left",
      "visible_if": "{{ block.settings.desktop_layout == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Media gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Desktop media ratio",
      "options": [
        {
          "value": "adapt", "label": "Adapt"
        },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "2-3", "label": "2:3" },
        { "value": "3-4", "label": "3:4" },
        { "value": "4-5", "label": "4:5" },
        { "value": "6-7", "label": "6:7" },
        { "value": "3-2", "label": "3:2" },
        { "value": "4-3", "label": "4:3" },
        { "value": "16-9", "label": "16:9" }
      ],
      "default": "4-5"
    },
    {
      "type": "select",
      "id": "mobile_media_ratio",
      "label": "Mobile media ratio",
      "options": [
        {
          "value": "adapt", "label": "Adapt"
        },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "2-3", "label": "2:3" },
        { "value": "3-4", "label": "3:4" },
        { "value": "4-5", "label": "4:5" },
        { "value": "6-7", "label": "6:7" },
        { "value": "3-2", "label": "3:2" },
        { "value": "4-3", "label": "4:3" },
        { "value": "16-9", "label": "16:9" }
      ],
      "default": "4-5"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Crop to fill"
        },
        {
          "value": "contain",
          "label": "Full image"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_pagination",
      "label": "Mobile pagination",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile_thumbnails",
      "label": "Mobile thumbnails",
      "default": true
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size",
      "min": 48,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "label": "Thumbnail gap",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ]
}
{% endschema %}
