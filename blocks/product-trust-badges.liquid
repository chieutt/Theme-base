{% doc %}
  Renders merchant-configured purchase reassurance copy.
{% enddoc %}
{% if block.settings.content != blank %}<div class="product-trust-badges rte spinel-text--{{ block.settings.text_size | default: 'medium' }} content-text--{{ block.settings.text_size | default: 'medium' }}" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>{% endif %}
{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "x-large",
          "label": "X-large"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "x-small",
          "label": "X-small"
        }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ]
}
{% endschema %}
