{% liquid
  assign content_alignment = block.settings.content_alignment | default: 'center'
  assign content_justify = 'center'
  if content_alignment == 'left'
    assign content_justify = 'start'
  elsif content_alignment == 'right'
    assign content_justify = 'end'
  endif
%}

<div class="product-usp-list product-usp-list--icon-{{ block.settings.icon_size | default: 'small' }} spinel-text--{{ block.settings.text_size | default: 'small' }}" style="--product-benefits-columns-desktop: {{ block.settings.columns_desktop }}; --product-benefits-columns-mobile: {{ block.settings.columns_mobile }}; --product-benefits-content-alignment: {{ content_alignment }}; --product-benefits-content-justify: {{ content_justify }};" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Product benefits",
  "blocks": [
    {
      "type": "product-benefit-item"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Product benefits"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "x-large",
          "label": "X-large"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "x-small",
          "label": "X-small"
        }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "Icon size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small"
    }
  ],
  "presets": [
    {
      "name": "Product benefits",
      "blocks": [
        {
          "type": "product-benefit-item"
        },
        {
          "type": "product-benefit-item"
        },
        {
          "type": "product-benefit-item"
        },
        {
          "type": "product-benefit-item"
        }
      ]
    }
  ]
}
{% endschema %}
