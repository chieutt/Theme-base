{% assign product = closest.product | default: product %}
{% if product.description != blank %}
  {% assign content_id = 'ProductDescription-' | append: section.id | append: '-' | append: block.id %}
  <div class="product-description rte product-description--{{ block.settings.style }}{% if block.settings.show_view_more %} product-description--clamped{% endif %}"{% if block.settings.show_view_more %} data-expandable{% endif %} {{ block.shopify_attributes }}>
    <div id="{{ content_id }}" class="product-description__content"{% if block.settings.show_view_more %} data-expandable-content data-max-height="{{ block.settings.content_max_height }}" style="--expandable-max-height: {{ block.settings.content_max_height }}px;"{% endif %}>{{ product.description }}</div>
    {% if block.settings.show_view_more %}
      <button class="product-description__toggle" type="button" data-expandable-toggle data-view-more-label="{{ 'product.view_more' | t | escape }}" data-view-less-label="{{ 'product.view_less' | t | escape }}" hidden aria-controls="{{ content_id }}" aria-expanded="false">{{ 'product.view_more' | t }}</button>
    {% endif %}
  </div>
{% endif %}
{% schema %}
{
  "name": "Product description",
  "settings": [
    {
      "type": "header",
      "content": "Product description"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Description style",
      "options": [
        {
          "value": "full",
          "label": "Full description"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "show_view_more",
      "label": "Show View more/Less",
      "default": false
    },
    {
      "type": "range",
      "id": "content_max_height",
      "label": "Content height before View more",
      "min": 120,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 240,
      "visible_if": "{{ block.settings.show_view_more }}"
    }
  ]
}
{% endschema %}
