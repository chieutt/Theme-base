{% assign product = closest.product | default: product %}
<aside
  class="product-recommendations-block"
  data-product-recommendations
  data-recommendation-key="{{ block.id }}"
  data-design-mode="{{ request.design_mode }}"
  data-url="{{ routes.product_recommendations_url | escape }}?section_id=product-recommendations&amp;product_id={{ product.id }}&amp;limit={{ block.settings.limit }}&amp;intent={{ block.settings.source | escape }}"
  aria-busy="true"
  {% unless request.design_mode %}hidden{% endunless %}
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <{{ block.settings.html_tag | default: 'h2' }} class="product-recommendations-block__heading {% render 'typography-class', preset: block.settings.heading_size, fallback: 'h5' %}">{{ block.settings.heading | strip_html | escape }}</{{ block.settings.html_tag | default: 'h2' }}>
  {% endif %}
  <div data-recommendation-list>
    {% if request.design_mode %}
      <ul class="product-recommendations__skeleton" role="list" aria-hidden="true" data-reveal-group>
        {% for placeholder_index in (1..block.settings.limit) %}
          {% liquid
            assign product_placeholder_index = placeholder_index | modulo: 6
            if product_placeholder_index == 0
              assign product_placeholder_index = 6
            endif
          %}
          {% assign placeholder_asset_index = product_placeholder_index | minus: 1 | modulo: 4 | plus: 1 %}
          {% assign placeholder_asset = 'placeholder-image-product-' | append: placeholder_asset_index | append: '.svg' %}
          <li class="product-recommendations__item product-recommendations__item--placeholder" aria-hidden="true" data-reveal-item style="--reveal-order: {{ forloop.index0 }};">
            <span class="product-recommendations__image">
              {% render 'media-placeholder', class_name: 'product-recommendations__placeholder-image', asset_name: placeholder_asset %}
            </span>
            <div class="product-recommendations__details">
              <h3 class="product-title-text heading-h3 heading-text">{{ 'onboarding.product_title' | t }}</h3>
              <div class="product-recommendations__price">
                <span>{% render 'money', amount: 1999 %}</span>
              </div>
            </div>
            <span class="product-recommendations__quick-add">+</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</aside>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "header",
      "content": "Product recommendations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the set"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "t:typography_options.display_extra_large"
        },
        {
          "value": "h1",
          "label": "t:typography_options.display_large"
        },
        {
          "value": "h2",
          "label": "t:typography_options.display_medium"
        },
        {
          "value": "h3",
          "label": "t:typography_options.heading_extra_large"
        },
        {
          "value": "h4",
          "label": "t:typography_options.heading_large"
        },
        {
          "value": "h5",
          "label": "t:typography_options.heading_medium"
        },
        {
          "value": "h6",
          "label": "t:typography_options.heading_small"
        },
        {
          "value": "h7",
          "label": "t:typography_options.heading_extra_small"
        },
        {
          "value": "custom",
          "label": "t:typography_options.custom"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Recommendation source",
      "options": [
        {
          "value": "complementary",
          "label": "Complementary products"
        },
        {
          "value": "related",
          "label": "Related products"
        }
      ],
      "default": "complementary"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 6
    }
  ]
}
{% endschema %}
