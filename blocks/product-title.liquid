{% assign product = closest.product | default: product %}
<{{ block.settings.html_tag | default: 'h1' }} class="product-title product-title-text product-title--{{ block.settings.heading_size | default: 'h1' }} {% render 'typography-class', preset: block.settings.heading_size, fallback: 'h1' %}" {{ block.shopify_attributes }}>{% if product != blank %}{{ product.title | escape }}{% else %}{{ 'onboarding.product_title' | t }}{% endif %}</{{ block.settings.html_tag | default: 'h1' }}>
{% schema %}
{
  "name": "Product title",
  "settings": [
    {
      "type": "header",
      "content": "Product title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "t:typography_options.display_extra_large"
        },
        {
          "value": "h1",
          "label": "t:typography_options.display_large"
        },
        {
          "value": "h2",
          "label": "t:typography_options.display_medium"
        },
        {
          "value": "h3",
          "label": "t:typography_options.heading_extra_large"
        },
        {
          "value": "h4",
          "label": "t:typography_options.heading_large"
        },
        {
          "value": "h5",
          "label": "t:typography_options.heading_medium"
        },
        {
          "value": "h6",
          "label": "t:typography_options.heading_small"
        },
        {
          "value": "h7",
          "label": "t:typography_options.heading_extra_small"
        },
        {
          "value": "custom",
          "label": "t:typography_options.custom"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    }
  ]
}
{% endschema %}
