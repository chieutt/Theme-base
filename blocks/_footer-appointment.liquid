{% doc %}
  Renders the private appointment callout in the footer.

  @example
  {% content_for 'block', type: '_footer-appointment', id: 'appointment' %}
{% enddoc %}

<aside
  class="footer__appointment color-scheme color-{{ block.settings.color_scheme.id }}"
  data-reveal
  style="
    {% if block.settings.background_color != blank %}--footer-appointment-background: {{ block.settings.background_color }};{% endif %}
    --footer-appointment-padding-top: {{ block.settings.padding_top | default: 28 }}px;
    --footer-appointment-padding-right: {{ block.settings.padding_right | default: 32 }}px;
    --footer-appointment-padding-bottom: {{ block.settings.padding_bottom | default: 30 }}px;
    --footer-appointment-padding-left: {{ block.settings.padding_left | default: 32 }}px;
  "
  aria-label="Private appointments"
  {{ block.shopify_attributes }}
>
  <div class="footer__appointment-eyebrow footer__eyebrow">
    {% content_for 'block', type: 'label', id: 'appointment_eyebrow' %}
  </div>

  <div class="footer__appointment-heading">
    {% content_for 'block', type: 'heading', id: 'appointment_heading' %}
  </div>

  <div class="footer__appointment-text">
    {% content_for 'block', type: 'text', id: 'appointment_text' %}
  </div>

  <div class="footer__appointment-button">
    {% content_for 'block', type: 'button', id: 'appointment_button' %}
  </div>
</aside>

{% schema %}
{
  "name": "Private appointments",
  "tag": null,
  "blocks": [
    { "type": "heading" },
    { "type": "label" },
    { "type": "text" },
    { "type": "button" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ]
}
{% endschema %}
