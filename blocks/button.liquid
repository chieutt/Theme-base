{% doc %}
  Renders a reusable button theme block.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}

{% liquid
  assign button_url = block.settings.link | default: routes.all_products_collection_url
%}

{% if block.settings.label != blank %}
  <div
    class="content-button"
    {{ block.shopify_attributes }}
    {% render 'reveal-attributes', settings: block.settings %}
  >
    {% render 'cta',
      label: block.settings.label,
      url: button_url,
      style: block.settings.style,
      icon: block.settings.icon,
      open_in_new_tab: block.settings.open_in_new_tab
    %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "tertiary",
          "label": "Tertiary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in a new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow-right",
          "label": "Arrow right"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "reveal_type",
      "label": "Type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" },
        { "value": "fade-down", "label": "Fade down" },
        { "value": "fade-left", "label": "Fade left" },
        { "value": "fade-right", "label": "Fade right" },
        { "value": "zoom", "label": "Zoom" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "reveal_duration",
      "label": "Duration",
      "min": 300,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 650,
      "visible_if": "{{ block.settings.reveal_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "reveal_delay",
      "label": "Delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.reveal_type != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
