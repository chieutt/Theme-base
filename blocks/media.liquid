{% doc %}
  Renders a reusable image theme block.

  @example
  {% content_for 'block', type: 'media', id: 'media' %}
{% enddoc %}

{% liquid
  assign media_fallback_asset = blank
  if block.settings.image == blank
    if request.page_type == 'page' and section.id contains '__about_intro'
      assign media_fallback_asset = 'page-about-intro-v1.jpg'
    elsif request.page_type == 'page' and section.id contains '__founder_story'
      assign media_fallback_asset = 'page-about-founder-v1.jpg'
    elsif request.page_type == 'page' and section.id contains '__design_vision'
      assign media_fallback_asset = 'page-about-process-v1.jpg'
    elsif request.page_type == 'product' and section.id contains '__image-with-text'
      assign media_fallback_asset = 'product-atelier-v1.jpg'
    endif
  endif
%}

<div
  class="content-media content-media--{{ block.settings.ratio }}{% if block.settings.enable_custom_width %} content-media--custom-width{% endif %}"
  style="--content-media-position: {{ block.settings.focal_point }}; --content-media-width: {{ block.settings.image_width }}px; --content-media-width-mobile: {{ block.settings.image_width_mobile }}px;"
  {{ block.shopify_attributes }}
>
  {% if media_fallback_asset != blank %}
    <img
      class="content-media__image"
      src="{{ media_fallback_asset | asset_url }}"
      alt="{{ block.settings.alt | escape }}"
      width="1122"
      height="1402"
      loading="lazy"
      decoding="async"
    >
  {% else %}
    {% render 'responsive-media',
      image: block.settings.image,
      max_width: 2000,
      widths: '160, 240, 320, 480, 750, 960, 1200, 1600, 2000',
      sizes: '(max-width: 767px) 50vw, (min-width: 1600px) 1600px, 100vw',
      class: 'content-media__image',
      alt: block.settings.alt,
      placeholder_asset: 'placeholder-image-default-1.svg',
      placeholder_class: 'content-media__placeholder'
    %}
  {% endif %}
</div>

{% stylesheet %}
  .content-media--custom-width {
    width: min(100%, var(--content-media-width));
  }

  @media screen and (max-width: 767.98px) {
    .content-media--custom-width {
      width: min(100%, var(--content-media-width-mobile));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Natural" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "4-3", "label": "Landscape (4:3)" },
        { "value": "2-3", "label": "Portrait (2:3)" },
        { "value": "16-9", "label": "Wide (16:9)" },
        { "value": "3-4", "label": "Standard (3:4)" },
        { "value": "4-5", "label": "Portrait (4:5)" },
        { "value": "6-7", "label": "Classic (6:7)" },
        { "value": "3-2", "label": "Landscape (3:2)" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Focal point",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_width",
      "label": "Use custom image width",
      "default": false
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 32,
      "max": 600,
      "step": 8,
      "unit": "px",
      "label": "Desktop image width",
      "default": 96,
      "visible_if": "{{ block.settings.enable_custom_width }}"
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "min": 24,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Mobile image width",
      "default": 72,
      "visible_if": "{{ block.settings.enable_custom_width }}"
    }
  ],
  "presets": [
    {
      "name": "Image"
    }
  ]
}
{% endschema %}
