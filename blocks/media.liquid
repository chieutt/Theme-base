{% doc %}
  Renders a reusable image theme block.

  @example
  {% content_for 'block', type: 'media', id: 'media' %}
{% enddoc %}

<div
  class="content-media content-media--{{ block.settings.ratio }}"
  style="--content-media-position: {{ block.settings.focal_point }}"
  {{ block.shopify_attributes }}
>
  {% render 'responsive-media',
    image: block.settings.image,
    max_width: 2000,
    widths: '320, 480, 750, 960, 1200, 1600, 2000',
    sizes: '(min-width: 1600px) 1600px, 100vw',
    class: 'content-media__image',
    alt: block.settings.alt,
    placeholder_asset: 'placeholder-image-default-1.svg',
    placeholder_class: 'content-media__placeholder'
  %}
</div>

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Natural" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "4-3", "label": "Landscape (4:3)" },
        { "value": "2-3", "label": "Portrait (2:3)" },
        { "value": "16-9", "label": "Wide (16:9)" },
        { "value": "3-4", "label": "Standard (3:4)" },
        { "value": "4-5", "label": "Portrait (4:5)" },
        { "value": "6-7", "label": "Classic (6:7)" },
        { "value": "3-2", "label": "Landscape (3:2)" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Focal point",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    }
  ],
  "presets": [
    {
      "name": "Image"
    }
  ]
}
{% endschema %}
