{% doc %}
  Renders a review card with an image and nested content blocks.

  @example
  {% content_for 'block', type: 'review', id: 'review' %}
{% enddoc %}

<article
  class="review-parallax__card"
  data-review-card
  data-block-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <div class="review-parallax__media">
    {% render 'responsive-media',
      image: block.settings.image,
      max_width: 600,
      widths: '260, 390, 520, 600',
      sizes: '(min-width: 1150px) 260px, min(75vw, 292px)',
      class: 'review-parallax__image',
      alt: block.settings.image_alt,
      loading: 'lazy',
      placeholder_asset: 'placeholder-image-default-5.svg',
      placeholder_class: 'review-parallax__placeholder'
    %}
  </div>

  <div class="review-parallax__content">
    {% content_for 'blocks' %}
  </div>
</article>

{% schema %}
{
  "name": "Review card",
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "heading"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text"
    }
  ],
  "presets": [
    {
      "name": "Review card",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "<p>Amazing look and quality! The piece is beautiful, fits perfectly, and feels exceptionally made.</p>",
            "type_preset": "md",
            "alignment": "left"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "<h6>Tony S.</h6>",
            "type_preset": "h6",
            "alignment": "left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
