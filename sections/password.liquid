{% liquid
  assign newsletter_form_id = 'PasswordNewsletter-' | append: section.id
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign desktop_image = desktop_image | default: mobile_image
%}

<div
  class="password-page password-page--horizontal-{{ section.settings.content_horizontal }} password-page--vertical-{{ section.settings.content_vertical }} color-scheme color-{{ section.settings.color_scheme.id }} full-width"
  style="--password-height-desktop: {{ section.settings.height_desktop }}px; --password-height-mobile: {{ section.settings.height_mobile }}px; --password-content-width: {{ section.settings.content_width }}px; --password-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="password-page__media" aria-hidden="true">
    {% render 'responsive-media', image: desktop_image, mobile_image: mobile_image, max_width: 2400, mobile_max_width: 1400, widths: '640, 960, 1200, 1600, 2000, 2400', mobile_widths: '480, 640, 750, 960, 1200, 1400', sizes: '100vw', class: 'password-page__image password-page__image--desktop', loading: 'eager', fetchpriority: 'high', decorative: true, placeholder_asset: 'placeholder-image-default-2.svg', placeholder_class: 'password-page__image password-page__image--desktop' %}
    <span class="password-page__overlay"></span>
  </div>

  <div class="password-page__main">
    <div class="password-page__content{% if section.settings.content_surface %} password-page__content--surface{% endif %}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              <div class="password-page__heading">
                {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h1', default_font: 'heading' %}
              </div>
            {% endif %}
          {% when 'text' %}
            {% if block.settings.text != blank %}
              <div class="password-page__text">
                {% render 'content-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'md', default_font: 'body' %}
              </div>
            {% endif %}
          {% when 'newsletter' %}
            <div class="password-page__newsletter" {{ block.shopify_attributes }}>
              {% form 'customer', id: newsletter_form_id, class: 'password-page__newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="password-page__field-label form-label" for="{{ newsletter_form_id }}-email">{{ block.settings.email_label | escape }}</label>
                <input class="form-control form-input" id="{{ newsletter_form_id }}-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ block.settings.email_placeholder | escape }}" required>
                <button class="btn-primary" type="submit">{{ block.settings.button_label | escape }}</button>
                {% if form.posted_successfully? %}
                  <p class="password-page__form-message form-message" role="status" tabindex="-1">{{ 'password.newsletter_success' | t }}</p>
                {% endif %}
                {% if form.errors %}
                  <div class="password-page__form-message password-page__form-message--error form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
                {% endif %}
              {% endform %}
            </div>
        {% endcase %}
      {% endfor %}

      {% if section.settings.show_store_message and shop.password_message != blank %}
        <p class="password-page__store-message">{{ shop.password_message }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .password-page { position: relative; display: grid; min-height: var(--password-height-desktop); overflow: hidden; isolation: isolate; background: var(--gradient-background, var(--color-background)); }
  .password-page__media, .password-page__image, .password-page__overlay { position: absolute; inset: 0; }
  .password-page__media { z-index: -2; }
  .password-page__image { width: 100%; height: 100%; object-fit: cover; }
  .password-page__overlay { z-index: 1; background: rgb(0 0 0 / var(--password-overlay-opacity)); }
  .password-page__newsletter-form input { width: 100%; min-width: 0; min-height: var(--control-height); padding: 0 14px; border: 1px solid var(--color-variant-border); border-radius: var(--style-border-radius-inputs); background: var(--color-background); color: var(--color-text); font: inherit; }
  .password-page__newsletter-form input:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  .password-page__main { position: relative; z-index: 2; display: flex; min-height: 0; flex: 1; align-items: center; padding: 40px var(--page-margin) 72px; }
  .password-page--horizontal-left .password-page__main { justify-content: flex-start; }
  .password-page--horizontal-center .password-page__main { justify-content: center; }
  .password-page--horizontal-right .password-page__main { justify-content: flex-end; }
  .password-page--vertical-top .password-page__main { align-items: flex-start; }
  .password-page--vertical-center .password-page__main { align-items: center; }
  .password-page--vertical-bottom .password-page__main { align-items: flex-end; }
  .password-page__content { display: grid; width: min(100%, var(--password-content-width)); gap: 18px; color: var(--color-text); }
  .password-page__content--surface { padding: clamp(28px, 5vw, 56px); border: 1px solid var(--color-variant-border); background: color-mix(in srgb, var(--color-background) 94%, transparent); }
  .password-page--horizontal-center .password-page__content { text-align: center; }
  .password-page__heading { margin: 0; color: var(--color-heading); }
  .password-page__text, .password-page__store-message { color: var(--color-text); line-height: var(--body-line-height); }
  .password-page__text > * { margin: 0; }
  .password-page__newsletter { margin-top: 6px; }
  .password-page__newsletter-form { display: grid; gap: 12px; }
  .password-page__field-label { color: var(--color-heading); font-size: var(--label-size); letter-spacing: var(--subheading-letter-spacing); line-height: var(--subheading-line-height); text-transform: var(--subheading-text-transform); }
  .password-page__newsletter-form .button { width: 100%; }
  .password-page__form-message { margin: 0; color: var(--color-text); font-size: var(--p2-size-sm); line-height: 1.45; }
  .password-page__form-message--error { color: var(--color-sale-price); }
  .password-page__form-message--error ul { margin: 0; padding-left: 18px; }
  .password-page__store-message { margin: 4px 0 0; font-size: var(--p2-size-sm); }
  @media screen and (max-width: 767.98px) { .password-page { min-height: var(--password-height-mobile); } .password-page__main { padding-top: 28px; padding-bottom: 48px; } .password-page__content--surface { padding: 28px 22px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 75,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 440,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 320,
      "max": 680,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "select",
      "id": "content_horizontal",
      "label": "Horizontal position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Vertical position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "content_surface",
      "label": "Show content surface",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_store_message",
      "label": "Show store password message",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:typography_blocks.text",
          "default": "<h1>Opening soon</h1>"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.heading_size",
          "options": [
            {
              "value": "h0",
              "label": "t:typography_options.display_extra_large"
            },
            {
              "value": "h1",
              "label": "t:typography_options.display_large"
            },
            {
              "value": "h2",
              "label": "t:typography_options.display_medium"
            },
            {
              "value": "h3",
              "label": "t:typography_options.heading_extra_large"
            },
            {
              "value": "h4",
              "label": "t:typography_options.heading_large"
            },
            {
              "value": "h5",
              "label": "t:typography_options.heading_medium"
            },
            {
              "value": "h6",
              "label": "t:typography_options.heading_small"
            },
            {
              "value": "h7",
              "label": "t:typography_options.heading_extra_small"
            },
            {
              "value": "custom",
              "label": "t:typography_options.custom"
            }
          ],
          "default": "h1"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "t:typography_blocks.size",
          "min": 8,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 50,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "t:typography_blocks.mobile_size",
          "min": 8,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 30,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "t:typography_blocks.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:typography_blocks.width",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "t:typography_blocks.width_mobile",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:typography_blocks.alignment",
          "default": "left",
          "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
        },
        {
          "type": "header",
          "content": "t:typography_blocks.padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:typography_blocks.top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:typography_blocks.bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-start",
          "label": "t:typography_blocks.left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-end",
          "label": "t:typography_blocks.right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:typography_blocks.text",
          "default": "<p>Be the first to know when we launch.</p>"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.text_size",
          "options": [
            {
              "value": "lg",
              "label": "t:typography_options.body_large"
            },
            {
              "value": "md",
              "label": "t:typography_options.body_medium"
            },
            {
              "value": "sm",
              "label": "t:typography_options.body_small"
            },
            {
              "value": "xs",
              "label": "t:typography_options.body_extra_small"
            },
            {
              "value": "custom",
              "label": "t:typography_options.custom"
            }
          ],
          "default": "md"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "t:typography_blocks.size",
          "min": 8,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 16,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "t:typography_blocks.mobile_size",
          "min": 8,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "t:typography_blocks.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:typography_blocks.width",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "t:typography_blocks.width_mobile",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:typography_blocks.alignment",
          "default": "left",
          "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
        },
        {
          "type": "header",
          "content": "t:typography_blocks.padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:typography_blocks.top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:typography_blocks.bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-start",
          "label": "t:typography_blocks.left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-end",
          "label": "t:typography_blocks.right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Newsletter"
        },
        {
          "type": "text",
          "id": "email_label",
          "label": "Email label",
          "default": "Email address"
        },
        {
          "type": "text",
          "id": "email_placeholder",
          "label": "Email placeholder",
          "default": "Enter your email"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Notify me"
        }
      ]
    }
  ]
}
{% endschema %}
