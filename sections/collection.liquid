    .main-collection__filter-dialog.is-closing { animation-name: main-collection-filter-drawer-out-mobile; }
    .main-collection__filter-handle { display: grid; width: 100%; height: 28px; place-items: center; background: var(--color-background); cursor: grab; touch-action: none; user-select: none; -webkit-tap-highlight-color: transparent; }
    .main-collection__filter-handle::before { width: 48px; height: 4px; border-radius: 999px; background: color-mix(in srgb, var(--color-heading) 14%, transparent); content: ''; }
    .main-collection__filter-dialog.is-handle-dragging .main-collection__filter-handle { cursor: grabbing; }
    .main-collection__filter-header { min-height: 64px; }

    @keyframes main-collection-filter-drawer-in-mobile { from { transform: translateY(100%); } to { transform: translateY(0); } }
    @keyframes main-collection-filter-drawer-out-mobile { from { transform: translateY(0); } to { transform: translateY(100%); } }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-collection__products,
    .main-collection__promotion-image,
    .main-collection__sort-trigger,
    .main-collection__sort-trigger svg,
    .main-collection__sort-radio::before,
    .main-collection__filter-backdrop-pointer,
    .main-collection__filter-group summary svg,
    .main-collection__filter-dialog[open],
    .main-collection__filter-dialog[open]::backdrop,
    .main-collection__filter-dialog.is-closing,
    .main-collection__filter-dialog.is-closing::backdrop {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}


