{% liquid
  assign studio_block = section.blocks | where: 'type', 'studio_details' | first
  assign intro_block = section.blocks | where: 'type', 'form_intro' | first
  assign field_blocks = section.blocks | where: 'type', 'form_field'
  assign contact_form_id = 'ContactForm-' | append: section.id
%}

<div
  class="contact-form{% if section.settings.section_width == 'full' %} contact-form--full full-width{% endif %}"
  style="--contact-form-height-desktop: {{ section.settings.height_desktop }}px; --contact-form-height-tablet: {{ section.settings.height_tablet }}px; --contact-form-height-mobile: {{ section.settings.height_mobile }}px; --contact-form-media-width: {{ section.settings.media_width }}%; --contact-form-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --contact-form-padding-top: {{ section.settings.padding_top }}px; --contact-form-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="contact-form__inner">
    <div class="contact-form__layout">
      <div
        class="contact-form__media color-scheme color-{{ section.settings.media_color_scheme.id }}"
        style="--contact-form-media-padding: {{ section.settings.media_padding }}px; --contact-form-media-padding-mobile: {{ section.settings.media_padding | divided_by: 2 }}px;"
      >
        {% render 'responsive-media',
          image: section.settings.image,
          max_width: 1600,
          widths: '480, 720, 960, 1200, 1600',
          sizes: '(min-width: 1150px) 50vw, 100vw',
          class: 'contact-form__image',
          loading: 'lazy',
          alt: section.settings.image.alt,
          placeholder_asset: 'placeholder-image-default-2.svg',
          placeholder_class: 'contact-form__placeholder'
        %}
        <div class="contact-form__media-overlay" aria-hidden="true"></div>

        {% if studio_block != blank %}
          <div class="contact-form__studio" {{ studio_block.shopify_attributes }}>
            {% if studio_block.settings.heading != blank %}
              <{{ studio_block.settings.heading_tag | default: 'h2' }} class="contact-form__studio-title heading-{{ studio_block.settings.heading_size | default: 'h3' }} heading-text">{{ studio_block.settings.heading | escape }}</{{ studio_block.settings.heading_tag | default: 'h2' }}>
            {% endif %}
            <div class="contact-form__studio-details">
              {% if studio_block.settings.address != blank %}<p>{{ studio_block.settings.address | escape }}</p>{% endif %}
              {% if studio_block.settings.phone != blank %}<p>{{ studio_block.settings.phone | escape }}</p>{% endif %}
              {% if studio_block.settings.hours != blank %}<p>{{ studio_block.settings.hours | escape }}</p>{% endif %}
            </div>
            {% if studio_block.settings.button_label != blank and studio_block.settings.button_link != blank %}
              <a class="contact-form__studio-button btn-secondary" href="{{ studio_block.settings.button_link | escape }}">
                {{ studio_block.settings.button_label | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div
        class="contact-form__content color-scheme color-{{ section.settings.content_color_scheme.id }}"
        style="--contact-form-content-padding: {{ section.settings.content_padding }}px; --contact-form-content-padding-mobile: {{ section.settings.content_padding | divided_by: 2 }}px;"
      >
        {% if intro_block != blank %}
          <div class="contact-form__intro" {{ intro_block.shopify_attributes }}>
            {% if intro_block.settings.subheading != blank %}
              <p class="contact-form__subheading subheading-text">{{ intro_block.settings.subheading | escape }}</p>
            {% endif %}
            {% if intro_block.settings.heading != blank %}
              <{{ intro_block.settings.heading_tag | default: 'h2' }} class="contact-form__heading {% render 'typography-class', preset: intro_block.settings.heading_size, fallback: 'h2' %}">{{ intro_block.settings.heading | escape }}</{{ intro_block.settings.heading_tag | default: 'h2' }}>
            {% endif %}
            {% if intro_block.settings.text != blank %}
              <div class="contact-form__description content-text spinel-text--{{ intro_block.settings.text_size | default: 'medium' }} content-text--{{ intro_block.settings.text_size | default: 'medium' }} rte">{{ intro_block.settings.text }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% form 'contact', id: contact_form_id, class: 'contact-form__form' %}
          {% if form.posted_successfully? %}
            <p class="contact-form__status contact-form__status--success form-message" tabindex="-1">{{ section.settings.success_message | escape }}</p>
          {% endif %}
          {% if form.errors %}
            <div class="contact-form__status contact-form__status--error form-message form-message--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="contact-form__fields" data-reveal-group>
            {% for block in field_blocks %}
              {% liquid
                assign field_id = contact_form_id | append: '-' | append: forloop.index
                assign field_name = 'contact[' | append: block.settings.field_type | append: ']'
                assign field_class = 'contact-form__field form-field'
                if block.settings.field_type == 'name' or block.settings.field_type == 'email'
                  assign field_class = field_class | append: ' contact-form__field--half'
                endif
              %}
              <div class="{{ field_class }}" data-reveal-item style="--reveal-order: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
                <label class="form-label" for="{{ field_id }}">{{ block.settings.label | escape }}{% if block.settings.required %}<span aria-hidden="true">*</span>{% endif %}</label>
                {% if block.settings.field_type == 'message' %}
                  <textarea class="form-control form-textarea" id="{{ field_id }}" name="{{ field_name }}" rows="4" placeholder="{{ block.settings.placeholder | escape }}"{% if block.settings.required %} required{% endif %}>{{ form.body | escape }}</textarea>
                {% else %}
                  <input
                    class="form-control form-input"
                    id="{{ field_id }}"
                    type="{% if block.settings.field_type == 'email' %}email{% elsif block.settings.field_type == 'phone' %}tel{% else %}text{% endif %}"
                    name="{{ field_name }}"
                    value="{% if block.settings.field_type == 'name' %}{{ form.name | escape }}{% elsif block.settings.field_type == 'email' %}{{ form.email | escape }}{% endif %}"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if block.settings.required %}required{% endif %}
                  >
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <button type="submit" class="contact-form__submit btn-primary">
            {{ section.settings.submit_label | escape }}
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-form {
    padding-block: var(--contact-form-padding-top) var(--contact-form-padding-bottom);
  }

  .contact-form__inner {
    width: min(100%, var(--page-width));
    margin-inline: auto;
  }

  .contact-form--full .contact-form__inner {
    width: 100%;
  }

  .contact-form__layout {
    display: grid;
    min-height: var(--contact-form-height-desktop);
    grid-template-columns: minmax(0, var(--contact-form-media-width)) minmax(0, 1fr);
  }

  .contact-form__media {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: var(--contact-form-height-desktop);
    padding: var(--contact-form-media-padding);
    overflow: hidden;
    background: var(--color-variant-component-background);
    color: var(--color-foreground);
  }

  .contact-form__image,
  .contact-form__placeholder,
  .contact-form__media-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .contact-form__image,
  .contact-form__placeholder {
    object-fit: cover;
  }

  .contact-form__placeholder {
    color: color-mix(in srgb, var(--color-heading) 18%, transparent);
  }

  .contact-form__media-overlay {
    background: rgb(0 0 0 / var(--contact-form-overlay-opacity));
  }

  .contact-form__studio {
    position: relative;
    z-index: 1;
  }

  .contact-form__studio-title {
    margin: 0 0 10px;
    color: inherit;
  }

  .contact-form__studio-details {
    display: grid;
    gap: 2px;
    color: color-mix(in srgb, currentcolor 88%, transparent);
    font-size: var(--p2-size-sm);
    line-height: 1.5;
  }

  .contact-form__studio-details p {
    margin: 0;
  }

  .contact-form__studio-button {
    margin-top: 22px;
  }

  .contact-form__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--contact-form-content-padding);
    background: var(--gradient-background, var(--color-background));
  }

  .contact-form__intro {
    max-width: 560px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .contact-form__subheading {
    margin: 0 0 10px;
    color: var(--color-text);
    font-size: var(--label-size);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .contact-form__heading {
    margin: 0;
    color: var(--color-heading);
  }

  .contact-form__description {
    margin: 8px auto 0;
    color: var(--color-text);
  }

  .contact-form__form {
    width: min(100%, 560px);
    margin-inline: auto;
  }

  .contact-form__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 12px;
  }

  .contact-form__field {
    display: grid;
    gap: 5px;
  }

  .contact-form__field:not(.contact-form__field--half) {
    grid-column: 1 / -1;
  }

  .contact-form__field label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    border: 1px solid transparent;
    border-radius: var(--style-border-radius-inputs);
    background: #fff;
    color: var(--color-heading);
    font-size: var(--label-size);
    line-height: 1.4;
    outline: none;
    padding: 10px 12px;
  }

  .contact-form__field input {
    min-height: var(--control-height);
  }

  .contact-form__field textarea {
    min-height: 84px;
    resize: vertical;
  }

  .contact-form__field input::placeholder,
  .contact-form__field textarea::placeholder {
    color: #a0a0a0;
    opacity: 1;
  }

  .contact-form__field input:focus-visible,
  .contact-form__field textarea:focus-visible {
    border-color: currentcolor;
  }

  .contact-form__submit {
    display: flex;
    min-height: var(--control-height);
    margin: 20px auto 0;
    padding-inline: var(--button-inline-padding);
    font-size: var(--label-size);
  }

  .contact-form__status {
    margin: 0 0 16px;
    font-size: var(--label-size);
    line-height: 1.5;
    text-align: center;
  }

  .contact-form__status--success { color: #246b3e; }
  .contact-form__status--error { color: #a22727; }

  @media screen and (max-width: 1149.98px) {
    .contact-form__layout,
    .contact-form__media {
      min-height: var(--contact-form-height-tablet);
    }
  }

  @media screen and (max-width: 767.98px) {
    .contact-form__layout {
      display: block;
      min-height: 0;
    }

    .contact-form__media {
      min-height: var(--contact-form-height-mobile);
      padding: var(--contact-form-media-padding-mobile);
    }

    .contact-form__content {
      padding: var(--contact-form-content-padding-mobile);
    }

    .contact-form__fields {
      grid-template-columns: 1fr;
    }

    .contact-form__field--half,
    .contact-form__field:not(.contact-form__field--half) {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
