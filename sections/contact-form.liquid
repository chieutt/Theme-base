    {
      "type": "header",
      "content": "Media column"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Studio image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 25
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 420,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Desktop height",
      "default": 620
    },
    {
      "type": "range",
      "id": "height_tablet",
      "min": 420,
      "max": 760,
      "step": 10,
      "unit": "px",
      "label": "Tablet height",
      "default": 560
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 360,
      "max": 760,
      "step": 10,
      "unit": "px",
      "label": "Mobile image height",
      "default": 520
    },
    {
      "type": "range",
      "id": "media_padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 64
    },
    {
      "type": "header",
      "content": "Form column"
    },
    {
      "type": "text",
