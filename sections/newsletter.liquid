    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Uses the desktop image when empty."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Height mode",
      "options": [
        {
          "value": "percent",
          "label": "Percent of viewport"
        },
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "adapt",
          "label": "Adapt to content"
        }
      ],
      "default": "percent"
    },
    {
      "type": "range",
      "id": "height_percent",
