{% render 'section-stylesheet', asset: 'section-countdown-timer.css', defer_on_home: true %}

{% liquid
  assign has_button = false

  for block in section.blocks
    if block.type == 'button' and block.settings.label != blank and block.settings.link != blank
      assign has_button = true
      break
    endif
  endfor
%}

{% if section.blocks.size > 0 %}
  <div
    class="countdown-timer color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} countdown-timer--full full-width{% endif %}{% if has_button %} countdown-timer--has-button{% endif %} countdown-timer--mobile-{{ section.settings.mobile_alignment }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --countdown-timer-column-gap: {{ section.settings.column_gap }}px; --countdown-timer-mobile-row-gap: {{ section.settings.mobile_row_gap }}px;"
    data-deferred-module="{{ 'section-countdown-timer.js' | asset_url }}"
  >
    <div class="countdown-timer__inner section-spacing">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              <div class="countdown-timer__heading-block countdown-timer__heading">
                {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h2', default_font: 'heading' %}
              </div>
            {% endif %}

          {% when 'text' %}
            {% if block.settings.text != blank %}
              <div class="countdown-timer__text">
                {% render 'content-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'md', default_font: 'body' %}
              </div>
            {% endif %}

          {% when 'countdown' %}
            {% liquid
              assign countdown_is_configured = false
              assign countdown_is_preview = false

              if block.settings.end_at != blank
                assign countdown_is_configured = true
              else
                assign countdown_is_preview = true
              endif
            %}
            <countdown-timer
              class="countdown-timer__timer"
              {% if countdown_is_configured %}
                data-end-at="{{ block.settings.end_at | escape }}"
                data-show-completion-message="{{ block.settings.show_completion_message }}"
              {% elsif countdown_is_preview %}
                data-countdown-preview
              {% endif %}
              {{ block.shopify_attributes }}
            >
                <time
                  class="countdown-timer__units"
                  {% if countdown_is_configured %}datetime="{{ block.settings.end_at | escape }}"{% endif %}
                  data-countdown-units
                  aria-label="{{ block.settings.aria_label | escape }}"
                >
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-days>{% if countdown_is_preview %}02{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.days_label | escape }}</span>
                  </span>
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-hours>{% if countdown_is_preview %}16{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.hours_label | escape }}</span>
                  </span>
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-minutes>{% if countdown_is_preview %}23{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.minutes_label | escape }}</span>
                  </span>
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-seconds>{% if countdown_is_preview %}16{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.seconds_label | escape }}</span>
                  </span>
                </time>
                <p class="countdown-timer__complete" data-countdown-complete hidden aria-live="polite">
                  {{ block.settings.completion_message | escape }}
                </p>
            </countdown-timer>

          {% when 'button' %}
            {% if block.settings.label != blank and block.settings.link != blank %}
              <div class="countdown-timer__button-block" {{ block.shopify_attributes }}>
                {% render 'cta', label: block.settings.label, url: block.settings.link, style: block.settings.style, icon: block.settings.icon, open_in_new_tab: block.settings.open_in_new_tab %}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
{% endif %}




