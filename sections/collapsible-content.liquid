<div class="collapsible-content color-scheme color-{{ section.settings.color_scheme.id }} full-width{% if section.settings.section_width == 'full' %} collapsible-content--full{% endif %}" style="--collapsible-padding-top: {{ section.settings.padding_top }}px; --collapsible-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="collapsible-content__inner">
    {% for block in section.blocks %}
      {% if block.type == 'heading' and block.settings.heading != blank %}
        <div class="collapsible-content__header collapsible-content__heading">
          {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h2', default_font: 'heading' %}
        </div>
      {% endif %}
    {% endfor %}
    <div class="collapsible-content__items" data-reveal-group>
      {% assign collapsible_reveal_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <details class="collapsible-content__item" data-animated-details data-reveal-item style="--reveal-order: {{ collapsible_reveal_index }};" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
            <summary><{{ block.settings.heading_tag | default: 'h3' }} class="collapsible-content__item-heading {% render 'typography-class', preset: block.settings.heading_size, fallback: 'h4' %}">{{ block.settings.heading | escape }}</{{ block.settings.heading_tag | default: 'h3' }}><span class="collapsible-content__icon" aria-hidden="true">{% render 'icon', name: 'chevron-up' %}</span></summary>
            <div class="collapsible-content__body content-text spinel-text--{{ block.settings.text_size | default: 'medium' }} content-text--{{ block.settings.text_size | default: 'medium' }} rte" data-accordion-content>{{ block.settings.content }}</div>
          </details>
          {% assign collapsible_reveal_index = collapsible_reveal_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="btn-tertiary collapsible-content__button" href="{{ section.settings.button_link | escape }}">
        {{ section.settings.button_label | escape }}
        {% comment %}
        <span aria-hidden="true">›</span>
        {% endcomment %}
        <span class="button__icon" aria-hidden="true">{% render 'icon', name: 'button-arrow' %}</span>
      </a>
    {% endif %}
  </div>
</div>
{% stylesheet %}
  .collapsible-content { padding: var(--collapsible-padding-top) var(--page-margin) var(--collapsible-padding-bottom); }
  .collapsible-content__inner { display: flex; width: min(100%, 880px); flex-direction: column; gap: 48px; margin-inline: auto; }
  .collapsible-content--full .collapsible-content__inner { width: min(100%, var(--page-width)); }
  .collapsible-content__heading { margin: 0; text-align: center; font-weight: 400; }
  .collapsible-content__items { border-block-start: 1px solid var(--product-border, #dedbd7); }
  .collapsible-content__item { border-block-end: 1px solid var(--product-border, #dedbd7); }
  .collapsible-content__item summary { display: flex; justify-content: space-between; gap: 16px; padding: 20px 0; cursor: pointer; list-style: none; }
  .collapsible-content__item summary::-webkit-details-marker { display: none; }
  .collapsible-content__item-heading { margin: 0; font-weight: 400; }
  .collapsible-content__icon { display: inline-grid; width: 20px; height: 20px; place-items: center; color: var(--color-text); transform: rotate(180deg); transition: transform .25s ease; }
  .collapsible-content__icon svg { display: block; width: 20px; height: 20px; }
  .collapsible-content__item[open] .collapsible-content__icon { transform: rotate(360deg); }
  .collapsible-content__item.is-closing .collapsible-content__icon { transform: rotate(180deg); }
  .collapsible-content__button { align-self: center; }
  .collapsible-content__body { padding: 0 32px 20px 0; color: var(--color-text, #686560); }
  @media (max-width: 1149.98px) { .collapsible-content { padding-inline: 16px; } .collapsible-content__inner { gap: 24px; } }
  @media (max-width: 767.98px) { .collapsible-content { padding-block: calc(var(--collapsible-padding-top) * 0.5) calc(var(--collapsible-padding-bottom) * 0.5); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Collapsible content",
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:typography_blocks.text",
          "default": "<h2>More information</h2>"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.heading_size",
          "options": [
            {
              "value": "h0",
              "label": "t:typography_options.display_extra_large"
            },
            {
              "value": "h1",
              "label": "t:typography_options.display_large"
            },
            {
              "value": "h2",
              "label": "t:typography_options.display_medium"
            },
            {
              "value": "h3",
              "label": "t:typography_options.heading_extra_large"
            },
            {
              "value": "h4",
              "label": "t:typography_options.heading_large"
            },
            {
              "value": "h5",
              "label": "t:typography_options.heading_medium"
            },
            {
              "value": "h6",
              "label": "t:typography_options.heading_small"
            },
            {
              "value": "h7",
              "label": "t:typography_options.heading_extra_small"
            },
            {
              "value": "custom",
              "label": "t:typography_options.custom"
            }
          ],
          "default": "h2"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "t:typography_blocks.size",
          "min": 8,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 50,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "t:typography_blocks.mobile_size",
          "min": 8,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 30,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "t:typography_blocks.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:typography_blocks.width",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "t:typography_blocks.width_mobile",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:typography_blocks.alignment",
          "default": "left",
          "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
        },
        {
          "type": "header",
          "content": "t:typography_blocks.padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:typography_blocks.top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:typography_blocks.bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-start",
          "label": "t:typography_blocks.left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-end",
          "label": "t:typography_blocks.right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    },
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "header",
          "content": "Item"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Frequently asked question"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "h0",
              "label": "t:typography_options.display_extra_large"
            },
            {
              "value": "h1",
              "label": "t:typography_options.display_large"
            },
            {
              "value": "h2",
              "label": "t:typography_options.display_medium"
            },
            {
              "value": "h3",
              "label": "t:typography_options.heading_extra_large"
            },
            {
              "value": "h4",
              "label": "t:typography_options.heading_large"
            },
            {
              "value": "h5",
              "label": "t:typography_options.heading_medium"
            },
            {
              "value": "h6",
              "label": "t:typography_options.heading_small"
            },
            {
              "value": "h7",
              "label": "t:typography_options.heading_extra_small"
            },
            {
              "value": "custom",
              "label": "t:typography_options.custom"
            }
          ],
          "default": "h4"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "HTML Tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ],
          "default": "h3"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add helpful information for customers.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "options": [
            {
              "value": "x-large",
              "label": "X-large"
            },
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "x-small",
              "label": "X-small"
            }
          ],
          "default": "medium"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all FAQs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Collapsible content",
      "category": "Brand trust",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
