{% render 'section-stylesheet', asset: 'section-slideshow-critical.css', inline_on_home: true %}
{% render 'section-stylesheet', asset: 'swiper-12.2.0-a11y.min.css', defer_on_home: true, shared_key: 'swiper' %}

{% comment %}
  Theme blocks are manually rendered below so section.blocks can provide the
  first-slide metadata needed for layout and fallback decisions. Nested slide
  content remains delegated to the slide block.
{% endcomment %}
{% liquid
  assign configured_slide_count = section.blocks.size
  assign first_slide = section.blocks | first
  assign first_slide_image = first_slide.settings.image | default: first_slide.settings.mobile_image
  assign desktop_ratio = first_slide_image.aspect_ratio | default: 1.7778
  assign mobile_ratio = first_slide.settings.mobile_image.aspect_ratio | default: desktop_ratio
  assign slide_count = configured_slide_count
  assign is_double_slide = false
  if section.settings.slideshow_style == 'double'
    assign is_double_slide = true
    if slide_count < 2
      assign slide_count = 2
    endif
  endif
  assign slide_total = slide_count
  if is_double_slide
    assign slide_total = slide_count | minus: 1
  endif
  assign has_multiple_slides = false
  if slide_count > 1
    assign has_multiple_slides = true
  endif
  assign fallback_cta_label = 'slideshow.fallback_cta' | t
%}

<spinel-slideshow
  class="slideshow color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}{% if section.settings.enable_image_zoom %} slideshow--image-zoom{% endif %} slideshow--style-{{ section.settings.slideshow_style }} slideshow--height-desktop-{{ section.settings.height_desktop }} slideshow--height-mobile-{{ section.settings.height_mobile }}"
  style="
    --slideshow-gap: {{ section.settings.slide_gap }}px;
    --slideshow-desktop-ratio: {{ desktop_ratio }};
    --slideshow-mobile-ratio: {{ mobile_ratio }};
    --slideshow-arrow-color: {{ section.settings.arrow_color }};
    --slideshow-arrow-background: {{ section.settings.arrow_background }};
    --slideshow-progress-color: {{ section.settings.progress_color }};
    --slideshow-progress-track-color: {{ section.settings.progress_track_color }};
  "
  data-section-id="{{ section.id }}"
  data-desktop-style="{{ section.settings.slideshow_style }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay }}"
  data-slide-gap="{{ section.settings.slide_gap }}"
  data-deferred-module="{{ 'slideshow.js' | asset_url }}"
>
  <div class="slideshow__viewport swiper" data-slideshow-slider>
    <div class="slideshow__wrapper swiper-wrapper">
      {% for block in section.blocks %}
        {% render block %}
      {% endfor %}

      {% if is_double_slide and configured_slide_count < 2 %}
        <article
          class="slideshow__slide slideshow__slide--default swiper-slide color-scheme color-scheme-3 slideshow__slide--desktop-bottom-left slideshow__slide--mobile-bottom-left slideshow__slide--align-left"
          style="
            --slideshow-overlay-color: #000000;
            --slideshow-overlay-opacity: 0.3;
            --slideshow-content-width: 520px;
          "
          data-block-id="default-double-slide"
        >
          <div class="slideshow__media" data-swiper-parallax-x="100%">
            {% render 'media-placeholder',
              class_name: 'slideshow__placeholder',
              asset_name: 'placeholder-image-default-2.svg'
            %}
          </div>

          <div class="slideshow__overlay" aria-hidden="true"></div>

          <div
            class="slideshow__content-positioner"
            data-swiper-parallax-x="30%"
            data-swiper-parallax-opacity="0"
            data-swiper-parallax-duration="1000"
          >
            <div class="slideshow__content">
              <h2 class="slideshow__heading heading heading-h2 heading-text">
                {{ 'slideshow.fallback_heading' | t }}
              </h2>

              <div class="slideshow__description content-text spinel-text--medium content-text--medium rte">
                <p>{{ 'slideshow.fallback_description' | t }}</p>
              </div>

              <div class="slideshow__buttons">
                {% render 'cta',
                  label: fallback_cta_label,
                  url: routes.all_products_collection_url,
                  style: 'primary',
                  class: 'slideshow__button slideshow__button--size-medium slideshow__button--hover-standard'
                %}
              </div>
            </div>
          </div>
        </article>
      {% endif %}
    </div>
  </div>

  {% if has_multiple_slides %}
    <div class="slideshow__controls">
      <div class="slideshow__progress-group">
        <p class="slideshow__counter" aria-live="polite">
          <span data-slideshow-current>1</span><span aria-hidden="true"> / </span><span data-slideshow-total>{{ slide_total }}</span>
        </p>
        <span
          class="slideshow__progress"
          role="progressbar"
          aria-label="{{ 'slideshow.progress' | t | escape }}"
          aria-valuemin="1"
          aria-valuemax="{{ slide_total }}"
          aria-valuenow="1"
          data-slideshow-progress
        ><span class="slideshow__progress-bar" data-slideshow-progress-bar></span></span>
      </div>
      <div class="slideshow__arrows">
        {% if section.settings.autoplay and section.blocks.size > 1 %}
          <button
            class="slideshow__arrow slideshow__autoplay-toggle"
            type="button"
            aria-label="{{ 'slideshow.pause' | t | escape }}"
            aria-pressed="false"
            data-slideshow-autoplay-toggle
            data-pause-label="{{ 'slideshow.pause' | t | escape }}"
            data-resume-label="{{ 'slideshow.resume' | t | escape }}"
          >
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M7 5.5v9M13 5.5v9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" data-slideshow-autoplay-icon/>
            </svg>
          </button>
        {% endif %}
        <button
          class="slideshow__arrow slideshow__arrow--previous"
          type="button"
          aria-label="{{ 'slideshow.previous' | t | escape }}"
          data-slideshow-previous
        >
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button
          class="slideshow__arrow slideshow__arrow--next"
          type="button"
          aria-label="{{ 'slideshow.next' | t | escape }}"
          data-slideshow-next
        >
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>
    </div>
  {% endif %}
</spinel-slideshow>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "section-slideshow",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "select",
      "id": "slideshow_style",
      "label": "Slideshow style",
      "options": [
        { "value": "single", "label": "Single slide" },
        { "value": "double", "label": "Double slide" }
      ],
      "default": "single"
    },
    {
      "type": "header",
      "content": "Slide layout"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Slide height desktop",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "X-large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Slide height mobile",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "X-large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Slide gap",
      "default": 0,
      "visible_if": "{{ section.settings.slideshow_style == 'double' }}"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom animation",
      "info": "Inactive images are enlarged and smoothly return to their original size when active.",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Progress"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Text and progress color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "progress_track_color",
      "label": "Progress track color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "slide"
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "category": "Banners",
      "blocks": [
        {
          "type": "slide",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "<h1>Designed for every day</h1>",
                "type_preset": "h1",
                "alignment": "left"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Discover pieces designed to bring a refined finish to every day.</p>",
                "type_preset": "md",
                "alignment": "left"
              }
            },
            {
              "type": "button-group",
              "settings": {
                "layout_direction": "horizontal",
                "alignment": "left",
                "gap": 12
              },
              "blocks": [
                {
                  "type": "button",
                  "settings": {
                    "label": "Shop all",
                    "link": "/collections/all",
                    "style": "primary"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "slide",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "<h1>Made for every moment</h1>",
                "type_preset": "h1",
                "alignment": "left"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Timeless forms, thoughtful details, and a finish made to be worn your way.</p>",
                "type_preset": "md",
                "alignment": "left"
              }
            },
            {
              "type": "button-group",
              "settings": {
                "layout_direction": "horizontal",
                "alignment": "left",
                "gap": 12
              },
              "blocks": [
                {
                  "type": "button",
                  "settings": {
                    "label": "Discover more",
                    "link": "/collections/all",
                    "style": "primary"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
