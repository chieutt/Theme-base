          "label": "t:typography_options.custom"
        }
      ],
      "default": "h2"
    },
    { "type": "select", "id": "heading_tag", "label": "HTML Tag", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }, { "value": "h5", "label": "H5" }, { "value": "h6", "label": "H6" }], "default": "h2" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "text_size", "label": "Text size", "options": [{ "value": "x-large", "label": "X-large" }, { "value": "large", "label": "Large" }, { "value": "medium", "label": "Medium" }, { "value": "small", "label": "Small" }, { "value": "x-small", "label": "X-small" }], "default": "medium" },
    { "type": "header", "content": "Appearance" },
    { "type": "text", "id": "empty_message", "label": "Empty state message", "default": "Add FAQ questions from the Theme Editor." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "group_heading",
      "name": "FAQ group heading",
      "settings": [
        {
          "type": "header",
          "content": "FAQ group heading"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Orders" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "h0",
              "label": "t:typography_options.display_extra_large"
            },
            {
              "value": "h1",
              "label": "t:typography_options.display_large"
            },
            {
              "value": "h2",
              "label": "t:typography_options.display_medium"
            },
            {
              "value": "h3",
              "label": "t:typography_options.heading_extra_large"
            },
            {
              "value": "h4",
              "label": "t:typography_options.heading_large"
            },
            {
              "value": "h5",
              "label": "t:typography_options.heading_medium"
            },
            {
              "value": "h6",
              "label": "t:typography_options.heading_small"
            },
            {
              "value": "h7",
              "label": "t:typography_options.heading_extra_small"
            },
            {
              "value": "custom",
              "label": "t:typography_options.custom"
            }
          ],
          "default": "h3"
        },
        { "type": "select", "id": "heading_tag", "label": "HTML Tag", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }, { "value": "h5", "label": "H5" }, { "value": "h6", "label": "H6" }], "default": "h3" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "select", "id": "text_size", "label": "Text size", "options": [{ "value": "x-large", "label": "X-large" }, { "value": "large", "label": "Large" }, { "value": "medium", "label": "Medium" }, { "value": "small", "label": "Small" }, { "value": "x-small", "label": "X-small" }], "default": "medium" },
