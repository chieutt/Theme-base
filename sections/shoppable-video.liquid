{% render 'section-stylesheet', asset: 'section-shoppable-video.css', defer_on_home: true %}
{% render 'section-stylesheet', asset: 'component-carousel-navigator.css', defer_on_home: true %}
{% render 'swiper-stylesheet', defer_on_home: true %}

{% liquid
  assign shoppable_video_background = section.settings.background_color
  assign shoppable_video_media_ratio = 'auto'
  case section.settings.media_ratio
    when 'square', '1'
      assign shoppable_video_media_ratio = '1 / 1'
    when '2-3', '0.6667'
      assign shoppable_video_media_ratio = '2 / 3'
    when '3-4', '0.75'
      assign shoppable_video_media_ratio = '3 / 4'
    when '4-5'
      assign shoppable_video_media_ratio = '4 / 5'
    when '6-7'
      assign shoppable_video_media_ratio = '6 / 7'
    when '3-2'
      assign shoppable_video_media_ratio = '3 / 2'
    when '4-3'
      assign shoppable_video_media_ratio = '4 / 3'
    when '16-9'
      assign shoppable_video_media_ratio = '16 / 9'
  endcase
  if shoppable_video_background == blank
    assign shoppable_video_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ shoppable_video_background }};
  }

  #shopify-section-{{ section.id }} .shoppable-video-section {
    background: transparent;
  }
{% endstyle %}

<shoppable-video-section
  class="shoppable-video-section color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  data-desktop-columns="{{ section.settings.columns_desktop }}"
  data-mobile-columns="{{ section.settings.columns_mobile }}"
  data-section-id="{{ section.id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --shoppable-video-gap: {{ section.settings.column_gap }}px; --shoppable-video-mobile-gap: {{ section.settings.mobile_column_gap }}px; --shoppable-video-media-ratio: {{ shoppable_video_media_ratio }};"
>
  <div class="shoppable-video-section__inner section-spacing{% if section.settings.section_width == 'page' %} page-width{% endif %}">
    <header class="shoppable-video-section__header">
      <div class="shoppable-video-section__title-group" data-reveal>
        {% content_for 'block', type: 'label', id: 'label' %}
        {% content_for 'block', type: 'heading', id: 'heading' %}
      </div>
      <div class="shoppable-video-section__description" data-reveal>
        {% content_for 'block', type: 'text', id: 'description' %}
      </div>
    </header>

    <div class="shoppable-video-section__panel">
      <div class="shoppable-video-section__carousel swiper" data-shoppable-video-carousel>
        <div class="shoppable-video-section__slides swiper-wrapper" role="list" data-reveal-group>
          {% content_for 'blocks' %}
        </div>
      </div>

      <button class="shoppable-video-section__arrow shoppable-video-section__arrow--previous carousel-navigator__arrow carousel-navigator__arrow--previous" type="button" aria-label="Previous videos" data-shoppable-video-previous>
        {% render 'icon', name: 'chevron-left' %}
      </button>
      <button class="shoppable-video-section__arrow shoppable-video-section__arrow--next carousel-navigator__arrow carousel-navigator__arrow--next" type="button" aria-label="Next videos" data-shoppable-video-next>
        {% render 'icon', name: 'chevron-right' %}
      </button>

      <footer class="shoppable-video-section__footer" data-reveal hidden>
        <span
          class="shoppable-video-section__count"
          data-shoppable-video-showing
          data-total="0"
        >Showing 0 of 0</span>
        <div class="shoppable-video-section__progress" aria-hidden="true">
          <span data-shoppable-video-progress></span>
        </div>
        <span class="shoppable-video-section__footer-label" data-shoppable-video-page-label>
          {{ section.settings.footer_label | escape }} / Page 01
        </span>
      </footer>
    </div>
  </div>
</shoppable-video-section>

<script type="module" src="{{ 'shoppable-video.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Shoppable video",
  "tag": "section",
  "class": "section-shoppable-video",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 6,
  "blocks": [
    { "type": "shoppable-video" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "footer_label",
      "label": "Footer label",
      "default": "Nocturne films"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "info": "Shows an additional 0.15 card as a swipe preview.",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Desktop column gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile column gap",
      "default": 12
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Video ratio",
      "options": [{ "value": "adapt", "label": "Natural" }, { "value": "square", "label": "Square (1:1)" }, { "value": "4-3", "label": "Landscape (4:3)" }, { "value": "2-3", "label": "Portrait (2:3)" }, { "value": "16-9", "label": "Wide (16:9)" }, { "value": "3-4", "label": "Standard (3:4)" }, { "value": "4-5", "label": "Portrait (4:5)" }, { "value": "6-7", "label": "Classic (6:7)" }, { "value": "3-2", "label": "Landscape (3:2)" }],
      "default": "3-4"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "color_scheme",
      "id": "modal_color_scheme",
      "label": "Product modal color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Shoppable video",
      "category": "Media",
      "settings": {
        "section_width": "full",
        "columns_desktop": 3,
        "columns_mobile": "1",
        "color_scheme": "scheme-2",
        "modal_color_scheme": "scheme-1"
      },
      "blocks": [
        {
          "type": "label",
          "id": "label",
          "static": true,
          "settings": {
            "text": "<p>04 / JEWELS IN MOTION</p>"
          }
        },
        {
          "type": "heading",
          "id": "heading",
          "static": true,
          "settings": {
            "heading": "<h2>The Nocturne,<br>seen in motion.</h2>",
            "type_preset": "h2"
          }
        },
        {
          "type": "text",
          "id": "description",
          "static": true,
          "settings": {
            "text": "<p>Nocturne objects, caught in motion.<br>Three gestures, held in light.</p>",
            "type_preset": "sm"
          }
        },
        { "type": "shoppable-video" },
        { "type": "shoppable-video" },
        { "type": "shoppable-video" }
      ]
    }
  ]
}
{% endschema %}
