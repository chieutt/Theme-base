{% render 'section-stylesheet', asset: 'section-editorial-slideshow.css' %}
{% render 'swiper-stylesheet' %}

{% liquid
  assign desktop_height = section.settings.desktop_height | default: 'full'
  assign mobile_height = section.settings.mobile_height | default: 'full'
  assign slideshow_description = section.settings.slideshow_description | default: 'Slideshow about our brand'
  assign autoplay_delay_display = section.settings.autoplay_delay
  if section.settings.autoplay_delay < 10
    assign autoplay_delay_display = '0' | append: section.settings.autoplay_delay
  endif
%}

<editorial-slideshow
  class="editorial-slideshow editorial-slideshow--desktop-height-{{ desktop_height }} editorial-slideshow--mobile-height-{{ mobile_height }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}{% if section.settings.enable_image_zoom %} editorial-slideshow--image-zoom{% endif %}{% if request.visual_preview_mode %} editorial-slideshow--visual-preview{% endif %}"
  role="region"
  aria-label="{{ slideshow_description | escape }}"
  data-section-id="{{ section.id }}"
  data-motion-enabled="{{ settings.enable_motion }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  {% unless request.visual_preview_mode %}
    data-deferred-module="{{ 'editorial-slideshow.js' | asset_url }}"
  {% endunless %}
  style="--editorial-navigator-background-opacity: {{ section.settings.navigator_background_opacity | default: 80 }}%;"
>
  <div class="editorial-slideshow__viewport swiper" data-editorial-slideshow-slider>
    <div class="editorial-slideshow__wrapper swiper-wrapper">
      {% content_for 'blocks' %}
    </div>
  </div>

  <div class="editorial-slideshow__lower-rail" data-editorial-lower-rail>
    <div class="editorial-slideshow__product-stage" data-editorial-product-stage></div>

    {% if section.settings.show_slideshow_controls %}
      <nav
      id="EditorialSlideshowNavigator-{{ section.id }}"
      class="editorial-slideshow__navigator{% if request.visual_preview_mode %} editorial-slideshow__navigator--preview{% endif %}"
      aria-label="{{ 'slideshow.pagination' | t | escape }}"
      data-editorial-navigator
      {% unless request.visual_preview_mode %}hidden{% endunless %}
    >
      <button
        class="editorial-slideshow__navigator-arrow editorial-slideshow__navigator-arrow--previous"
        type="button"
        aria-label="{{ 'slideshow.previous' | t | escape }}"
        data-editorial-previous
        {% if request.visual_preview_mode %}disabled{% endif %}
      >
        {% render 'icon', name: 'chevron-left' %}
        <span class="editorial-slideshow__navigator-arrow-label">{{ 'slideshow.previous_short' | t | escape }}</span>
      </button>

      <span class="editorial-slideshow__mobile-count" aria-hidden="true">
        <span data-editorial-mobile-current>01</span>
        <span>/</span>
        <span data-editorial-mobile-total>01</span>
      </span>

      <div class="editorial-slideshow__tabs" role="tablist" data-editorial-slide-tabs></div>

      <span class="editorial-slideshow__mobile-label" data-editorial-mobile-label aria-hidden="true">Slide</span>

      <button
        class="editorial-slideshow__navigator-arrow editorial-slideshow__navigator-arrow--next"
        type="button"
        aria-label="{{ 'slideshow.next' | t | escape }}"
        data-editorial-next
        {% if request.visual_preview_mode %}disabled{% endif %}
      >
        <span class="editorial-slideshow__navigator-arrow-label">{{ 'slideshow.next_short' | t | escape }}</span>
        {% render 'icon', name: 'chevron-right' %}
      </button>

      {% if section.settings.autoplay and section.blocks.size > 1 %}
        <button
          class="editorial-slideshow__autoplay"
          type="button"
          aria-label="{{ 'slideshow.pause' | t | escape }}"
          aria-pressed="true"
          data-label-pause="{{ 'slideshow.pause' | t | escape }}"
          data-label-resume="{{ 'slideshow.resume' | t | escape }}"
          data-editorial-autoplay-toggle
        >
          <span class="editorial-slideshow__autoplay-icon" aria-hidden="true">
            {% render 'icon', name: 'pause', class: 'editorial-slideshow__autoplay-icon--pause' %}
            {% render 'icon', name: 'play-outline', class: 'editorial-slideshow__autoplay-icon--play' %}
          </span>
          <span class="editorial-slideshow__autoplay-copy">
            <span class="editorial-slideshow__autoplay-label">{{ 'slideshow.autoplay' | t | escape }}</span>
            <span class="editorial-slideshow__autoplay-value" data-editorial-autoplay-value>{{ autoplay_delay_display }} {{ 'slideshow.seconds_short' | t | escape }}</span>
          </span>
        </button>
      {% endif %}

      </nav>
    {% endif %}
  </div>
</editorial-slideshow>

{% schema %}
