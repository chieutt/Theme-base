{% liquid
  assign article_blog = article.blog
  assign article_id = 'Article-' | append: section.id
%}

<article
  class="article color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  style="--article-hero-height: {{ section.settings.hero_height }}px; --article-hero-mobile-ratio: {{ article.image.aspect_ratio | default: 1.7777778 }}; --article-content-width: {{ section.settings.content_width }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="article__inner section-spacing">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'article_header' %}
            <header class="article__hero" {{ block.shopify_attributes }}>
              {% if block.settings.show_image %}
                <div class="article__hero-media">
                  {% assign article_image_alt = article.image.alt | default: article.title %}
                  {% render 'responsive-media', image: article.image, max_width: 1800, widths: '640, 960, 1200, 1600, 1800', sizes: '(min-width: 1150px) 56vw, 100vw', class: 'article__hero-image media-cover', loading: 'eager', fetchpriority: 'high', alt: article_image_alt, placeholder_asset: 'placeholder-image-default-2.svg', placeholder_class: 'article__hero-image media-cover' %}
                </div>
              {% endif %}
              <div class="article__hero-copy{% unless block.settings.show_image %} article__hero-copy--wide{% endunless %}">
                {% if block.settings.show_tag and article.tags.first != blank %}<p class="article__subheading subheading-text">{{ article.tags.first | escape }}</p>{% endif %}
                <h1 class="article__title heading-h1 heading-text">{{ article.title | escape }}</h1>
                {% if block.settings.show_excerpt and article.excerpt != blank %}<p class="article__excerpt">{{ article.excerpt | strip_html | escape }}</p>{% endif %}
                {% if block.settings.show_date or block.settings.show_author %}
                  <div class="article__meta">
                    {% if block.settings.show_date %}{{ article.published_at | time_tag: format: 'date' }}{% endif %}
                    {% if block.settings.show_date and block.settings.show_author %}<span aria-hidden="true"> · </span>{% endif %}
                    {% if block.settings.show_author %}{{ article.author | escape }}{% endif %}
                  </div>
                {% endif %}
              </div>
            </header>

          {% when 'article_content' %}
            <div class="article__body rte" {{ block.shopify_attributes }}>{{ article.content }}</div>

          {% when 'share_links' %}
            <div class="article__share" {{ block.shopify_attributes }}>
              {% if block.settings.label != blank %}<span>{{ block.settings.label | escape }}</span>{% endif %}
              {% if block.settings.show_facebook %}<a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener">{{ 'article.share_facebook' | t }}</a>{% endif %}
              {% if block.settings.show_x %}<a href="https://twitter.com/intent/tweet?url={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener">{{ 'article.share_x' | t }}</a>{% endif %}
              {% if block.settings.show_email %}<a href="mailto:?subject={{ article.title | url_encode | escape }}&amp;body={{ shop.url | append: article.url | url_encode | escape }}">{{ 'article.share_email' | t }}</a>{% endif %}
            </div>

          {% when 'related_articles' %}
            {% if article_blog != blank %}
              <div class="article__related"{% if block.settings.heading != blank %} role="region" aria-labelledby="ArticleRelated-{{ block.id }}"{% endif %} style="--article-related-columns: {{ block.settings.article_count }};" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}<h2 id="ArticleRelated-{{ block.id }}" class="heading-h2 heading-text">{{ block.settings.heading | escape }}</h2>{% endif %}
                <div class="article__related-grid" data-reveal-group>
                  {% assign related_count = 0 %}
                  {% for related in article_blog.articles %}
                    {% if related.id != article.id and related_count < block.settings.article_count %}
                      {% assign related_count = related_count | plus: 1 %}
                      <article class="article__related-card" data-reveal-item style="--reveal-order: {{ related_count | minus: 1 }};">
                        <a class="article__related-media" href="{{ related.url | escape }}">
                          {% assign related_image_alt = related.image.alt | default: related.title %}
                          {% render 'responsive-media', image: related.image, max_width: 700, widths: '320, 480, 700', sizes: '(min-width: 1150px) 33vw, (min-width: 768px) 50vw, 100vw', class: 'article__related-image media-cover', loading: 'lazy', alt: related_image_alt, placeholder_asset: 'placeholder-image-product-1.svg', placeholder_class: 'article__related-image media-cover' %}
                        </a>
                        <h3 class="heading-h3 heading-text"><a href="{{ related.url | escape }}">{{ related.title | escape }}</a></h3>
                        {% if block.settings.show_date %}<p class="article__meta">{{ related.published_at | time_tag: format: 'date' }}</p>{% endif %}
                      </article>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

          {% when 'comments' %}
            {% if article_blog.comments_enabled? %}
              {% liquid
                assign comments_id = 'Comments-' | append: section.id | append: '-' | append: block.id
                if section.id == 'main' or section.id contains '__main'
                  assign comments_id = 'comments'
                endif
              %}
              <div class="article__comments" id="{{ comments_id }}"{% if block.settings.heading != blank %} role="region" aria-labelledby="ArticleComments-{{ block.id }}"{% endif %} {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}<h2 id="ArticleComments-{{ block.id }}" class="heading-h2 heading-text">{{ block.settings.heading | escape }}</h2>{% endif %}
                {% paginate article.comments by 10 %}
                  {% if article.comments_count > 0 %}
                    <div class="article__comment-list" data-reveal-group>
                      {% for comment in article.comments %}
                        <div class="article__comment" data-reveal-item style="--reveal-order: {{ forloop.index0 }};"><p>{{ comment.content }}</p><p class="article__meta">{{ comment.author | escape }} · {{ comment.created_at | time_tag: format: 'date' }}</p></div>
                      {% endfor %}
                    </div>
                    {% render 'pagination',
                      paginate: paginate,
                      base_class: 'article__comment-pagination',
                      aria_label: 'article.comment_pagination' | t,
                      previous_label: 'article.previous_page' | t,
                      next_label: 'article.next_page' | t
                    %}
                  {% endif %}
                {% endpaginate %}
                {% if block.settings.show_form %}
                  {% assign comment_form_id = article_id | append: '-comment-form' %}
                  {% form 'new_comment', article, id: comment_form_id, class: 'article__comment-form' %}
                    {% if form.posted_successfully? %}<p class="article__form-status form-message" tabindex="-1">{{ block.settings.success_message | escape }}</p>{% endif %}
                    {{ form.errors | default_errors }}
                    <div class="article__comment-fields">
                      <label class="form-label" for="{{ article_id }}-author">{{ 'article.comment_name' | t }}</label><input class="form-control form-input" id="{{ article_id }}-author" type="text" name="comment[author]" value="{{ form.author | escape }}" required>
                      <label class="form-label" for="{{ article_id }}-email">{{ 'article.comment_email' | t }}</label><input class="form-control form-input" id="{{ article_id }}-email" type="email" name="comment[email]" value="{{ form.email | escape }}" required>
                      <label class="form-label" for="{{ article_id }}-body">{{ 'article.comment_body' | t }}</label><textarea class="form-control form-textarea" id="{{ article_id }}-body" name="comment[body]" rows="5" required>{{ form.body | escape }}</textarea>
                    </div>
                    <button class="btn-primary" type="submit">{{ block.settings.submit_label | escape }}</button>
                  {% endform %}
                {% endif %}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    {% elsif request.design_mode %}
      <p class="article__empty">{{ 'article.add_block' | t }}</p>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .article { display: block; background: var(--gradient-background, var(--color-background)); color: var(--color-text); }
  .article__inner { width: 100%; max-width: var(--page-width); margin-inline: auto; }
  .article.full-width .article__inner { max-width: none; padding-inline: var(--page-margin); }
  .article__hero { display: grid; min-height: var(--article-hero-height); grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .article__hero-media { min-height: var(--article-hero-height); overflow: hidden; background: var(--color-variant-component-background); }
  .article__hero-image { width: 100%; height: 100%; object-fit: cover; }
  .article__hero-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(32px, 6vw, 92px); background: var(--color-variant-component-background); }
  .article__hero-copy--wide { grid-column: 1 / -1; }
  .article__subheading { font-size: var(--label-size); letter-spacing: .12em; text-transform: uppercase; }
  .article__title { margin-top: 16px; font-size: clamp(34px, 4vw, 60px); line-height: 1.05; }
  .article__excerpt { margin-top: 20px; max-width: 500px; line-height: 1.55; }
  .article__meta { margin-top: 18px; color: var(--color-text); font-size: var(--label-size); }
  .article__body { width: min(100%, var(--article-content-width)); margin: clamp(56px, 8vw, 110px) auto 0; font-size: 16px; line-height: 1.7; }
  .article__body > * + * { margin-top: 28px; }
  .article__body img { width: 100%; height: auto; margin-block: 42px; }
  .article__body h2, .article__body h3 { margin-top: 52px; text-align: center; }
  .article__body blockquote { margin: 52px auto; padding: 24px 0 24px 26px; border-left: 1px solid currentcolor; font-family: var(--heading-font-family); font-size: clamp(24px, 3vw, 38px); line-height: 1.2; }
  .article__share { display: flex; align-items: center; justify-content: center; gap: 18px; margin: 48px auto 0; padding-top: 22px; border-top: 1px solid var(--color-variant-border); font-size: var(--label-size); }
  .article__share a { color: inherit; text-decoration: none; }
  .article__related, .article__comments { width: min(100%, 1100px); margin: clamp(72px, 10vw, 140px) auto 0; }
  .article__related > h2, .article__comments > h2 { text-align: center; font-size: clamp(28px, 3vw, 42px); }
  .article__related-grid { display: grid; grid-template-columns: repeat(var(--article-related-columns, 3), minmax(0, 1fr)); gap: 20px; margin-top: 34px; }
  .article__related-media { display: block; aspect-ratio: 1.25; overflow: hidden; background: var(--color-variant-component-background); }
  .article__related-image { width: 100%; height: 100%; object-fit: cover; }
  .article__related-card h3 { margin-top: 14px; font-size: 20px; line-height: 1.15; }
  .article__related-card h3 a { color: inherit; text-decoration: none; }
  .article__related-card .article__meta { margin-top: 8px; }
  .article__comment-list { display: grid; gap: 18px; margin: 32px auto; }
  .article__comment { padding: 20px; border: 1px solid var(--color-variant-border); }
  .article__comment p:first-child { line-height: 1.55; }
  .article__comment .article__meta { margin-top: 12px; }
  .article__comment-pagination { display: flex; justify-content: center; padding-top: 24px; }
  .article__comment-form { display: grid; gap: 20px; max-width: 700px; margin: 36px auto 0; }
  .article__comment-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .article__comment-fields label { align-self: end; font-size: var(--label-size); }
  .article__comment-fields textarea { grid-column: 1 / -1; }
  .article__comment-fields input, .article__comment-fields textarea { width: 100%; padding: 12px; border: 1px solid var(--color-variant-border); border-radius: var(--style-border-radius-inputs); background: transparent; color: inherit; }
  .article__comment-form .button { justify-self: center; }
  .article__form-status { text-align: center; color: #246b3e; }
  .article__empty { margin: 32px auto; text-align: center; }
  @media screen and (max-width: 767.98px) { .article__inner, .article.full-width .article__inner { padding-inline: var(--page-margin); } .article__hero { display: block; } .article__hero-media { min-height: 0; aspect-ratio: var(--article-hero-mobile-ratio); } .article__hero-copy { min-height: 0; padding: 42px 28px; } .article__body { margin-top: 56px; } .article__related-grid { grid-template-columns: 1fr; } .article__comment-fields { grid-template-columns: 1fr; } .article__comment-fields textarea { grid-column: auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section-article",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    { "type": "range", "id": "content_width", "min": 560, "max": 980, "step": 20, "unit": "px", "label": "Content width", "default": 760 },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{"value":"page","label":"Page width"},{"value":"full","label":"Full width"}], "default": "page" },
    {
      "type": "header",
      "content": "Article"
    },
    { "type": "range", "id": "hero_height", "min": 320, "max": 760, "step": 20, "unit": "px", "label": "Hero height", "default": 520 },
    {
      "type": "header",
      "content": "Section padding"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 80 },
    {
      "type": "header",
      "content": "Appearance"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "article_header",
      "name": "Article header",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Article header"
        },
        { "type": "checkbox", "id": "show_image", "label": "Article image", "default": true },
        { "type": "checkbox", "id": "show_tag", "label": "Show tag", "default": true },
        { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
        { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
        { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true }
      ]
    },
    { "type": "article_content", "name": "Article content", "limit": 1, "settings": [] },
    {
      "type": "share_links",
      "name": "Share links",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Share links"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Share this story" },
        { "type": "checkbox", "id": "show_facebook", "label": "Show Facebook", "default": true },
        { "type": "checkbox", "id": "show_x", "label": "Show X", "default": true },
        { "type": "checkbox", "id": "show_email", "label": "Show email", "default": true }
      ]
    },
    {
      "type": "related_articles",
      "name": "Related articles",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Related articles"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Related Posts" },
        { "type": "range", "id": "article_count", "min": 2, "max": 4, "step": 1, "label": "Article count", "default": 3 },
        { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true }
      ]
    },
    {
      "type": "comments",
      "name": "Comments",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Comments"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join Our Community" },
        { "type": "checkbox", "id": "show_form", "label": "Comment form", "default": true },
        { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Post comment" },
        { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for sharing your thoughts." }
      ]
    }
  ],
  "presets": [{ "name": "Article", "category": "Blog and pages", "blocks": [{"type":"article_header"},{"type":"article_content"},{"type":"share_links"},{"type":"related_articles"},{"type":"comments"}] }]
}
{% endschema %}
