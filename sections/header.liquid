{% comment %}Header styles are loaded once from layout/theme.liquid so section re-renders cannot create a stylesheet gap in the Theme Editor.{% endcomment %}

{% liquid
  assign header_cart_action = settings.cart_action
  assign header_show_currency_code = settings.show_currency_code
  assign country_form_id = 'HeaderCountrySelector-' | append: section.id
  assign language_form_id = 'HeaderLanguageSelector-' | append: section.id
  assign legacy_logo_width_desktop = section.settings.logo_width_desktop | default: 170
  assign legacy_logo_width_mobile = section.settings.logo_width_mobile | default: 120
  assign logo_block = section.blocks | where: 'type', 'logo' | first
  assign logo_width_desktop = legacy_logo_width_desktop
  assign logo_width_mobile = legacy_logo_width_mobile
  assign logo_height_desktop = 48
  assign logo_height_mobile = 38
  assign logo_block_type = 'image'
  assign logo_block_image = blank
  assign logo_block_mobile_image = blank
  assign logo_block_text = blank
  assign logo_alignment = 'center'
  assign render_logo = false

  if logo_block != blank
    assign render_logo = true
    assign logo_block_type = logo_block.settings.logo_type | default: 'image'
    assign logo_block_image = logo_block.settings.image
    assign logo_block_mobile_image = logo_block.settings.mobile_image
    assign logo_block_text = logo_block.settings.logo_text
    assign logo_alignment = logo_block.settings.alignment | default: 'center'
    assign logo_width_desktop = logo_block.settings.width_desktop | default: 170
    assign logo_width_mobile = logo_block.settings.width_mobile | default: 120
    assign logo_height_desktop = logo_block.settings.height_desktop | default: 48
    assign logo_height_mobile = logo_block.settings.height_mobile | default: 38

    if logo_width_desktop == 170 and legacy_logo_width_desktop != 170
      assign logo_width_desktop = legacy_logo_width_desktop
    endif

    if logo_width_mobile == 120 and legacy_logo_width_mobile != 120
      assign logo_width_mobile = legacy_logo_width_mobile
    endif
  elsif section.settings.logo_block_migrated != true
    assign render_logo = true
  endif

  if logo_block_type == 'text'
    assign logo_image = blank
    assign logo_image_mobile = blank
    assign logo_image_transparent = blank
    assign logo_image_transparent_mobile = blank
    assign logo_text = logo_block_text | default: shop.name
  else
    assign logo_image = logo_block_image | default: settings.logo | default: settings.logo_mobile
    assign logo_image_mobile = logo_block_mobile_image | default: settings.logo_mobile | default: logo_image
    assign logo_image_transparent = logo_image
    assign logo_image_transparent_mobile = logo_image_mobile
    assign logo_text = shop.name
  endif

  assign logo_text_size_desktop = logo_width_desktop | times: 16.0 | divided_by: 170.0 | round: 2
  assign logo_text_size_mobile = logo_width_mobile | times: 14.0 | divided_by: 120.0 | round: 2
  assign navigation_menu = section.settings.menu
  assign menu_links = navigation_menu.links
  assign header_color_scheme = section.settings.color_scheme
  assign floating_header_enabled = false
  assign transparent_header_enabled = false
  assign header_sticky_behavior = section.settings.sticky_behavior
  assign has_menu = false
  assign has_mobile_utilities = false
  assign can_change_country = false
  assign can_change_language = false
  assign show_language = true
  assign header_social_count = 0

  if section.settings.show_language == false
    assign show_language = false
  endif

  if settings.facebook_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.instagram_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.youtube_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.tiktok_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.x_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.snapchat_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.pinterest_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.tumblr_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.vimeo_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.linkedin_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.threads_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.whatsapp_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.wechat_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.reddit_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.line_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.spotify_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.discord_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.twitch_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.kakaotalk_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif
  if settings.weibo_url != blank
    assign header_social_count = header_social_count | plus: 1
  endif

  if template.name == 'index'
    if section.settings.header_style == 'floating'
      assign floating_header_enabled = true
    elsif section.settings.header_style == 'transparent'
      assign transparent_header_enabled = true
    endif
  endif

  if section.settings.header_style == 'floating'
    assign header_sticky_behavior = 'none'
  endif

  if transparent_header_enabled
    assign header_color_scheme = section.settings.transparent_color_scheme
  endif

  if section.settings.show_account and shop.customer_accounts_enabled
    assign has_mobile_utilities = true
  elsif section.settings.show_localization
    assign has_mobile_utilities = true
  elsif show_language and localization.available_languages.size > 1
    assign has_mobile_utilities = true
  elsif header_social_count > 0
    assign has_mobile_utilities = true
  endif

  if localization.available_countries.size > 1
    assign can_change_country = true
  endif

  if show_language and localization.available_languages.size > 1
    assign can_change_language = true
  endif

  if menu_links == blank and navigation_menu != blank
    assign navigation_menu_handle = navigation_menu.handle | default: navigation_menu
    assign navigation_menu = linklists[navigation_menu_handle]
    assign menu_links = navigation_menu.links
  endif

  if menu_links != blank
    assign has_menu = true
  endif

  assign default_logo_loading = 'eager'
  assign transparent_logo_loading = 'lazy'
  if transparent_header_enabled
    assign default_logo_loading = 'lazy'
    assign transparent_logo_loading = 'eager'
  endif

  assign cart_accessible_label = 'header.cart' | t
  if cart.item_count > 0
    if cart.item_count == 1
      assign cart_accessible_label = 'header.cart_count_one' | t: count: cart.item_count
    else
      assign cart_accessible_label = 'header.cart_count' | t: count: cart.item_count
    endif
  endif
%}

<span
  class="header__menu-overlay header__menu-overlay--desktop"
  data-header-menu-overlay="Header-{{ section.id }}"
  aria-hidden="true"
></span>

<header
  id="Header-{{ section.id }}"
  class="header header--logo-{{ section.settings.header_layout }} header--burger-two_stripes_wide header--drawer-mega color-scheme color-{{ header_color_scheme.id }} full-width{% if section.settings.underline_active_link %} header--underline-active{% endif %}{% if header_sticky_behavior != 'none' %} header--sticky{% endif %}{% if template.name != 'index' %} header--bordered{% endif %}{% if transparent_header_enabled %} header--transparent{% endif %}{% if floating_header_enabled %} header--floating{% endif %}"
  style="--header-height: {{ section.settings.height_desktop }}px; --header-height-mobile: {{ section.settings.height_mobile }}px; --header-surface-background: {{ section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background }}; --header-transparent-scrim-opacity: {{ section.settings.transparent_scrim_opacity | divided_by: 100.0 }};"
  data-sticky-behavior="{{ header_sticky_behavior }}"
  data-mega-menu-animation="slide_down"
  data-mega-menu-animation-duration="300"
  data-floating-header="{{ floating_header_enabled }}"
  data-transparent-header="{{ transparent_header_enabled }}"
  data-default-color-class="color-{{ section.settings.color_scheme.id }}"
  data-transparent-color-class="color-{{ section.settings.transparent_color_scheme.id }}"
  data-deferred-module="{{ 'section-header.js' | asset_url }}"
  data-header
>
  <span class="header__mega-background" aria-hidden="true"></span>
  <div class="header__inner">
    {% if has_menu or has_mobile_utilities %}
      <details class="header__menu-disclosure" data-open-label="{{ 'header.open_menu' | t | escape }}" data-close-label="{{ 'header.close_menu' | t | escape }}">
        <summary class="header__menu-toggle" aria-label="{{ 'header.open_menu' | t | escape }}" aria-controls="HeaderMobileDrawer-{{ section.id }}">
          <span class="header__menu-icon header__menu-icon--open header__burger-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </summary>
      </details>

      <div
        id="HeaderMobileDrawer-{{ section.id }}"
        class="header__mobile-drawer"
        data-header-mobile-drawer
      >
        <span
          class="header__menu-overlay header__menu-overlay--mobile"
          data-header-menu-overlay="Header-{{ section.id }}"
          aria-hidden="true"
        ></span>
        <div class="header__mobile-drawer-surface color-scheme color-{{ section.settings.color_scheme.id }}">
          <div class="header__mobile-drawer-header">
            <span id="HeaderMobileDrawerTitle-{{ section.id }}" class="visually-hidden">{{ 'header.primary_navigation' | t }}</span>
            {% if render_logo %}
              <a class="header__mobile-drawer-logo" href="{{ routes.root_url | escape }}" aria-label="{{ logo_text | escape }}" style="--header-logo-width-mobile: {{ logo_width_mobile }}px; --header-logo-height-mobile: {{ logo_height_mobile }}px; --header-logo-text-size-mobile: {{ logo_text_size_mobile }}px;">
                {% if logo_image_mobile != blank %}
                  {{ logo_image_mobile | image_url: width: 360 | image_tag: widths: '120, 180, 240, 360', sizes: '(max-width: 1023.98px) var(--header-logo-width-mobile), 120px', alt: shop.name, loading: 'lazy' }}
                {% else %}
                  <span class="header__logo-text">{{ logo_text | escape }}</span>
                {% endif %}
              </a>
            {% endif %}
            <button class="header__mobile-drawer-close modal-close-button close-icon" type="button" aria-label="{{ 'header.close_menu' | t | escape }}" data-header-mobile-close></button>
          </div>

          {% render 'header-navigation',
            section: section,
            menu_links: menu_links,
            navigation_variant: 'mobile',
            has_menu: has_menu,
            can_change_country: can_change_country
          %}
        </div>
      </div>
    {% endif %}

    {% if has_menu %}
      {% render 'header-navigation',
        section: section,
        menu_links: menu_links,
        navigation_variant: 'desktop',
        has_menu: has_menu,
        can_change_country: can_change_country
      %}
    {% endif %}

    {% if render_logo %}
      <div
        class="header__logo header__logo--align-{{ logo_alignment }}"
        style="--header-logo-width: {{ logo_width_desktop }}px; --header-logo-width-mobile: {{ logo_width_mobile }}px; --header-logo-height: {{ logo_height_desktop }}px; --header-logo-height-mobile: {{ logo_height_mobile }}px; --header-logo-text-size: {{ logo_text_size_desktop }}px; --header-logo-text-size-mobile: {{ logo_text_size_mobile }}px;"
        {% if logo_block != blank %}{{ logo_block.shopify_attributes }}{% endif %}
      >
          <a href="{{ routes.root_url | escape }}" aria-label="{{ logo_text | escape }}">
            {% if logo_image != blank %}
              <picture class="header__logo-image header__logo-image--dark">
                {% if logo_image_mobile != blank %}<source media="(max-width: 1023.98px)" srcset="{{ logo_image_mobile | image_url: width: 360 }}">{% endif %}
                {{ logo_image | image_url: width: 600 | image_tag: widths: '120, 180, 240, 360, 480, 600', sizes: '(max-width: 1023.98px) var(--header-logo-width-mobile), var(--header-logo-width)', alt: logo_image.alt | default: shop.name, loading: default_logo_loading }}
              </picture>
              <picture class="header__logo-image header__logo-image--light">
                {% if logo_image_transparent_mobile != blank %}<source media="(max-width: 1023.98px)" srcset="{{ logo_image_transparent_mobile | image_url: width: 360 }}">{% endif %}
                {{ logo_image_transparent | image_url: width: 600 | image_tag: widths: '120, 180, 240, 360, 480, 600', sizes: '(max-width: 1023.98px) var(--header-logo-width-mobile), var(--header-logo-width)', alt: logo_image_transparent.alt | default: shop.name, loading: transparent_logo_loading }}
              </picture>
            {% else %}
              <span class="header__logo-text">{{ logo_text | escape }}</span>
            {% endif %}
          </a>
      </div>
    {% endif %}

    <div class="header__actions">
      {% if section.settings.show_localization or can_change_language %}
        <div class="header__localization header__localization--combined{% if can_change_language %} header__localization--with-language{% endif %}">
          {% if can_change_country or can_change_language %}
            <details class="header__localization-selector{% if section.settings.dropdown_trigger == 'hover' %} header__localization-selector--hover{% endif %}">
              <summary aria-label="{% if section.settings.show_localization %}{{ 'header.country_region' | t | escape }}: {{ localization.country.currency.iso_code | escape }} {{ localization.country.currency.symbol | escape }}{% endif %}{% if section.settings.show_localization and can_change_language %}, {% endif %}{% if can_change_language %}{{ 'header.language' | t | escape }}: {{ localization.language.endonym_name | default: localization.language.name | capitalize | escape }}{% endif %}">
                {% if section.settings.show_localization %}
                  {% if section.settings.show_country_flag %}
                    {{ localization.country | image_url: width: 32 | image_tag: class: 'header__localization-flag', widths: '16, 32', alt: localization.country.name, loading: 'lazy' }}
                  {% endif %}
                  <span class="header__localization-label">{{ localization.country.currency.iso_code | escape }} {{ localization.country.currency.symbol | escape }}</span>
                {% endif %}
                {% if section.settings.show_localization and can_change_language %}
                  <span class="header__localization-separator" aria-hidden="true">/</span>
                {% endif %}
                {% if can_change_language %}
                  <span class="header__localization-language-code" aria-hidden="true">{{ localization.language.iso_code | upcase }}</span>
                {% endif %}
                <span class="header__dropdown-icon header__dropdown-icon--chevron" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
              </summary>
              <div class="header__localization-popover">
                {% if can_change_country %}
                  {% form 'localization', id: country_form_id %}
                    <div class="header__localization-panel-section header__localization-select" data-header-country-picker>
                      <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-header-country-input>
                      <div id="{{ country_form_id }}-Options" class="header__localization-options theme-scrollbar" role="listbox" aria-label="{{ 'header.country_region' | t | escape }}">
                        {% for country in localization.available_countries %}
                          <button class="header__localization-option{% if country.iso_code == localization.country.iso_code %} header__localization-option--selected{% endif %}" type="button" role="option" aria-selected="{% if country.iso_code == localization.country.iso_code %}true{% else %}false{% endif %}" data-header-country-option data-country-code="{{ country.iso_code }}">
                            {{ country | image_url: width: 32 | image_tag: class: 'header__localization-option-flag', widths: '16, 32', alt: '', loading: 'lazy' }}
                            <span class="header__localization-option-name">{{ country.name | escape }}</span>
                            <span class="header__localization-option-currency">{{ country.currency.iso_code | escape }} {{ country.currency.symbol | escape }}</span>
                          </button>
                        {% endfor %}
                      </div>
                    </div>
                    <noscript>
                      <select name="country_code">
                        {% for country in localization.available_countries %}
                          <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code | escape }} {{ country.currency.symbol | escape }})</option>
                        {% endfor %}
                      </select>
                      <button type="submit">{{ 'header.apply' | t }}</button>
                    </noscript>
                  {% endform %}
                {% endif %}

                {% if can_change_language %}
                  {% form 'localization', id: language_form_id %}
                    <div class="header__localization-panel-section header__localization-panel-section--language header__localization-select{% if can_change_country %} header__localization-panel-section--separated{% endif %}" data-header-language-picker>
                      {% if can_change_country %}<p class="header__localization-panel-heading">{{ 'header.language' | t }}</p>{% endif %}
                      <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}" data-header-language-input>
                      <div id="{{ language_form_id }}-Options" class="header__localization-options theme-scrollbar" role="listbox" aria-label="{{ 'header.language' | t | escape }}">
                        {% for language in localization.available_languages %}
                          <button class="header__localization-option{% if language.iso_code == localization.language.iso_code %} header__localization-option--selected{% endif %}" type="button" role="option" aria-selected="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}" data-header-language-option data-language-code="{{ language.iso_code }}">
                            <span>{{ language.endonym_name | default: language.name | capitalize | escape }}</span>
                          </button>
                        {% endfor %}
                      </div>
                    </div>
                    <noscript>
                      <select name="language_code">
                        {% for language in localization.available_languages %}
                          <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | default: language.name | capitalize | escape }}</option>
                        {% endfor %}
                      </select>
                      <button type="submit">{{ 'header.apply' | t }}</button>
                    </noscript>
                  {% endform %}
                {% endif %}
              </div>
            </details>
          {% elsif section.settings.show_localization %}
            <span class="header__localization-current" aria-label="{{ 'header.country_region' | t | escape }}">
              {% if section.settings.show_country_flag %}
                {{ localization.country | image_url: width: 32 | image_tag: class: 'header__localization-flag', widths: '16, 32', alt: localization.country.name, loading: 'lazy' }}
              {% endif %}
              <span class="header__localization-label">{{ localization.country.currency.iso_code | escape }} {{ localization.country.currency.symbol | escape }}</span>
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_search %}
        <a class="header__action header__search-trigger" href="{{ routes.search_url | escape }}" aria-label="{{ 'header.search' | t | escape }}" aria-haspopup="dialog" aria-controls="SearchDrawer" aria-expanded="false" data-search-drawer-open>
          {% render 'icon', name: 'search' %}
        </a>
      {% endif %}

      {% if shop.customer_accounts_enabled %}
        <shopify-account class="header__action header__action--account"{% if section.settings.customer_account_menu != blank and section.settings.customer_account_menu != 'customer-account-main-menu' %} menu="{{ section.settings.customer_account_menu }}"{% endif %}>
          <span slot="signed-out-avatar" class="header__account-avatar" aria-hidden="true">{% render 'icon', name: 'account' %}</span>
        </shopify-account>
      {% endif %}

      {% if section.settings.show_cart %}
        <a class="header__action header__cart" href="{{ routes.cart_url | escape }}" aria-label="{{ cart_accessible_label | escape }}" data-cart-current-count="{{ cart.item_count }}" data-cart-empty-label="{{ 'header.cart' | t | escape }}" data-cart-count-one-label="{{ 'header.cart_count_one' | t: count: '__count__' | escape }}" data-cart-count-label="{{ 'header.cart_count' | t: count: '__count__' | escape }}"{% if header_cart_action == 'drawer' %} data-cart-drawer-open aria-controls="CartDrawer" aria-expanded="false"{% endif %}>
          {% render 'icon', name: 'bag' %}
          {% if cart.item_count > 0 %}
            <span class="header__cart-count" aria-hidden="true">
              {% if cart.item_count > 99 %}99+{% else %}{{ cart.item_count }}{% endif %}
            </span>
          {% endif %}
        </a>
        <span class="visually-hidden" data-cart-count-status role="status" aria-live="polite" aria-atomic="true"></span>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_search %}
    <dialog scroll-lock data-scroll-lock-owner="search" class="header-search-modal color-scheme color-{{ section.settings.color_scheme.id }}" id="HeaderSearch-{{ section.id }}" aria-labelledby="HeaderSearchLabel-{{ section.id }}" data-header-search-modal data-predictive-search-url="{{ routes.predictive_search_url | escape }}" data-currency-code="{{ localization.country.currency.iso_code | default: shop.currency | escape }}" data-show-currency-code="{{ header_show_currency_code }}" data-no-products-text="{{ 'search.no_products' | t | escape }}" data-no-results-text="{{ 'search.no_results' | t: term: '__term__' | escape }}" data-results-found-text="{{ 'search.results_found' | t: count: '__count__' | escape }}" data-searching-text="{{ 'search.searching' | t | escape }}" data-search-error-text="{{ 'search.error' | t | escape }}" data-product-count-one="{{ 'search.product_count.one' | t: count: '__count__' | escape }}" data-product-count-other="{{ 'search.product_count.other' | t: count: '__count__' | escape }}">
      <div class="header-search-modal__inner">
        <button class="header-search-modal__close modal-close-button close-icon" type="button" aria-label="{{ 'header.close_search' | t | escape }}" data-header-search-close></button>
        <form class="header-search-modal__form search-field" action="{{ routes.search_url | escape }}" method="get" role="search" data-header-search-form>
          <label class="visually-hidden" id="HeaderSearchLabel-{{ section.id }}" for="HeaderSearchInput-{{ section.id }}">{{ 'search.label' | t }}</label>
          <input id="HeaderSearchInput-{{ section.id }}" class="header-search-modal__input search-field__input" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" data-header-search-input>
          <button class="header-search-modal__clear search-field__clear" type="button" aria-label="{{ 'search.clear_search' | t | escape }}" data-header-search-clear hidden>
            {% render 'icon', name: 'close' %}
          </button>
          <button class="header-search-modal__submit search-field__submit" type="submit" aria-label="{{ 'search.submit' | t | escape }}">
            {% render 'icon', name: 'search' %}
          </button>
        </form>

        <div class="header-search-modal__predictive" data-header-search-predictive aria-busy="false" hidden>
          <p class="header-search-modal__status" data-header-search-status role="status" aria-live="polite" aria-atomic="true" hidden></p>
          <div class="header-search-modal__tabs" role="tablist" aria-label="{{ 'search.result_tabs' | t | escape }}">
            <button id="HeaderSearchTab-{{ section.id }}-products" type="button" role="tab" aria-selected="true" aria-controls="HeaderSearchPanel-{{ section.id }}-products" tabindex="0" data-header-search-tab="products">{{ 'search.products' | t }}</button>
            <button id="HeaderSearchTab-{{ section.id }}-collections" type="button" role="tab" aria-selected="false" aria-controls="HeaderSearchPanel-{{ section.id }}-collections" tabindex="-1" data-header-search-tab="collections">{{ 'search.collections' | t }}</button>
          </div>
          <div class="header-search-modal__panels">
            <div id="HeaderSearchPanel-{{ section.id }}-products" role="tabpanel" aria-labelledby="HeaderSearchTab-{{ section.id }}-products" data-header-search-panel="products"></div>
            <div id="HeaderSearchPanel-{{ section.id }}-collections" role="tabpanel" aria-labelledby="HeaderSearchTab-{{ section.id }}-collections" hidden data-header-search-panel="collections"></div>
            <p class="header-search-modal__empty" data-header-search-empty hidden></p>
          </div>
          <a class="btn-primary header-search-modal__view-all" href="{{ routes.search_url | escape }}" data-header-search-view-all>{{ 'search.view_all_results' | t }}</a>
        </div>
      </div>
    </dialog>
  {% endif %}
</header>




{% schema %}
{
  "name": "Header",
  "max_blocks": 6,
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "dropdown_trigger",
      "label": "Dropdown trigger",
      "info": "Mobile navigation always opens with a tap.",
      "options": [
