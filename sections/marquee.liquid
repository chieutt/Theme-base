{% render 'section-stylesheet', asset: 'section-marquee-critical.css', inline_on_home: true %}

<div
  class="marquee-section color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  style="--marquee-section-gap: {{ section.settings.marquee_gap }}px; --marquee-section-padding-top: {{ section.settings.padding_top }}px; --marquee-section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-deferred-module="{{ 'section-marquee.js' | asset_url }}"
  data-marquee-parallax="{{ section.settings.enable_parallax }}"
  data-marquee-parallax-strength="{{ section.settings.parallax_strength }}"
  data-marquee-parallax-strength-mobile="{{ section.settings.parallax_strength_mobile }}"
  aria-label="{{ 'marquee.announcements' | t | escape }}"
>
  <div class="marquee-section__inner{% if section.settings.section_width == 'page' %} marquee-section__inner--page{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section-marquee",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "marquee"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "marquee_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Marquee gap",
      "default": 0
    },
    {
      "type": "header",
      "content": "Scroll motion"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable scroll parallax",
      "default": true
    },
    {
      "type": "range",
      "id": "parallax_strength",
      "min": 0,
      "max": 360,
      "step": 10,
      "unit": "px",
      "label": "Desktop parallax strength",
      "default": 180,
      "visible_if": "{{ section.settings.enable_parallax }}"
    },
    {
      "type": "range",
      "id": "parallax_strength_mobile",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Mobile parallax strength",
      "default": 72,
      "visible_if": "{{ section.settings.enable_parallax }}"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "category": "Marketing",
      "blocks": [
        {
          "type": "marquee",
          "settings": {
            "direction": "left",
            "speed": 30,
            "pause_on_hover": false
          },
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "<p>Objects of light · Made to order</p>",
                "type_preset": "custom",
                "font_size": 56,
                "font_size_mobile": 34
              }
            }
          ]
        },
        {
          "type": "marquee",
          "settings": {
            "direction": "right",
            "speed": 35,
            "pause_on_hover": false
          },
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "<p>Natural spinel · Sculpted gold · Quietly made</p>",
                "type_preset": "custom",
                "font_size": 30,
                "font_size_mobile": 20
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
