{% render 'section-stylesheet', asset: 'section-marquee-critical.css', inline_on_home: true %}

<div
  class="marquee-section color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  style="--marquee-section-gap: {{ section.settings.marquee_gap }}px; --marquee-section-padding-top: {{ section.settings.padding_top }}px; --marquee-section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-deferred-module="{{ 'section-marquee.js' | asset_url }}"
  data-marquee-parallax="{{ section.settings.enable_parallax }}"
  data-marquee-parallax-strength="{{ section.settings.parallax_strength }}"
  data-marquee-parallax-strength-mobile="{{ section.settings.parallax_strength_mobile }}"
  aria-label="{{ 'marquee.announcements' | t | escape }}"
>
  <div class="marquee-section__inner{% if section.settings.section_width == 'page' %} marquee-section__inner--page{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section-marquee",
  "enabled_on": {
    "templates": ["index"]
  },
  "max_blocks": 2,
  "blocks": [
    {
      "type": "marquee"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "marquee_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Marquee gap",
      "default": 0
    },
    {
      "type": "header",
      "content": "Scroll motion"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable scroll parallax",
      "default": true
    },
    {
      "type": "range",
      "id": "parallax_strength",
      "min": 0,
      "max": 360,
      "step": 10,
      "unit": "px",
      "label": "Desktop parallax strength",
      "default": 180,
      "visible_if": "{{ section.settings.enable_parallax }}"
    },
    {
      "type": "range",
      "id": "parallax_strength_mobile",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Mobile parallax strength",
      "default": 72,
      "visible_if": "{{ section.settings.enable_parallax }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "category": "Marketing",
      "settings": {
        "section_width": "full",
        "marquee_gap": 0,
        "enable_parallax": true,
        "parallax_strength": 180,
        "parallax_strength_mobile": 72,
        "color_scheme": "scheme-2",
        "padding_top": 12,
        "padding_bottom": 12
      },
      "blocks": [
        {
          "type": "marquee",
          "settings": {
            "direction": "left",
            "speed": 35,
            "pause_on_hover": false,
            "item_gap": 48,
            "height_desktop": 54,
            "height_mobile": 46
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "<p>Form · light · movement · memory</p>",
                "type_preset": "custom",
                "font_size": 24,
                "font_size_mobile": 20
              }
            },
            {
              "type": "label",
              "settings": {
                "text": "<p>HAND FINISHED</p>"
              }
            },
            {
              "type": "heading",
              "settings": {
