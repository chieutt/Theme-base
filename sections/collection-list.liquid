{% if request.page_type == 'collection' and request.design_mode == false %}
  <style>{{ 'section-collection-list.css' | inline_asset_content }}</style>
{% else %}
  {% render 'section-stylesheet', asset: 'section-collection-list.css', defer_on_home: true %}
{% endif %}
{% render 'swiper-stylesheet', defer_on_home: true %}

{% liquid
  assign collection_list_background = section.settings.background_color
  if collection_list_background == blank
    assign collection_list_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif

  assign collection_card_count = 0
  assign split_header_block_count = 0
  for block in section.blocks
    if block.type == 'collection_card'
      assign collection_card_count = collection_card_count | plus: 1
    endif
    if block.type == 'split_label' or block.type == 'heading' or block.type == 'split_text' or block.type == 'split_button'
      assign split_header_block_count = split_header_block_count | plus: 1
    endif
  endfor

  assign split_height_desktop = 768
  assign split_height_tablet = 480
  case section.settings.height_desktop
    when 'small'
      assign split_height_desktop = 600
      assign split_height_tablet = 400
    when 'large'
      assign split_height_desktop = 920
      assign split_height_tablet = 560
  endcase

  assign split_height_mobile = 360
  case section.settings.height_mobile
    when 'small'
      assign split_height_mobile = 280
    when 'large'
      assign split_height_mobile = 480
  endcase

  assign collection_image_ratio = 'auto'
  case section.settings.image_ratio
    when 'portrait'
      assign collection_image_ratio = '5 / 6'
    when 'square'
      assign collection_image_ratio = '1 / 1'
    when '2-3'
      assign collection_image_ratio = '2 / 3'
    when '3-4'
      assign collection_image_ratio = '3 / 4'
    when '6-7'
      assign collection_image_ratio = '6 / 7'
    when '3-2'
      assign collection_image_ratio = '3 / 2'
    when '4-5'
      assign collection_image_ratio = '4 / 5'
    when '4-3', 'landscape'
      assign collection_image_ratio = '4 / 3'
    when '16-9'
      assign collection_image_ratio = '16 / 9'
  endcase
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ collection_list_background }};
  }

  #shopify-section-{{ section.id }} .collection-list {
    background: transparent;
  }
{% endstyle %}

{% if collection_card_count > 0 %}
  <collection-list
    {% if section.settings.layout == 'grid' %}data-deferred-module="{{ 'collection-list.js' | asset_url }}"{% endif %}
    class="collection-list collection-list--{{ section.settings.layout }} collection-list--layout-desktop-{{ section.settings.layout_desktop | default: 'slider' }} collection-list--layout-tablet-{{ section.settings.layout_desktop | default: 'slider' }} collection-list--layout-mobile-{{ section.settings.layout_mobile | default: 'slider' }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
    data-section-id="{{ section.id }}"
    data-layout-desktop="{{ section.settings.layout_desktop | default: 'slider' }}"
    data-layout-tablet="{{ section.settings.layout_desktop | default: 'slider' }}"
    data-layout-mobile="{{ section.settings.layout_mobile | default: 'slider' }}"
    data-columns-desktop="{{ section.settings.columns_desktop }}"
    data-columns-tablet="{{ section.settings.columns_desktop }}"
    data-columns-mobile="{{ section.settings.columns_mobile }}"
    data-show-pagination="{{ section.settings.show_pagination }}"
    style="--collection-list-columns-desktop: {{ section.settings.columns_desktop }}; --collection-list-columns-tablet: {{ section.settings.columns_desktop }}; --collection-list-columns-mobile: {{ section.settings.columns_mobile }}; --collection-list-column-gap: {{ section.settings.column_gap }}px; --collection-list-mobile-column-gap: {{ section.settings.mobile_column_gap }}px; --collection-list-header-gap: {{ section.settings.header_gap }}px; --collection-list-card-gap: {{ section.settings.card_gap }}px; --collection-list-image-ratio: {{ collection_image_ratio }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --collection-list-height-desktop: {{ split_height_desktop }}px; --collection-list-height-tablet: {{ split_height_tablet }}px; --collection-list-height-mobile: {{ split_height_mobile }}px;"
  >
    <div class="collection-list__inner section-spacing{% if section.settings.section_width == 'page' %} collection-list__inner--page{% endif %}">
      {% assign has_prioritized_collection_image = false %}
      {% if section.settings.layout == 'split-promotions' %}
        <header class="collection-list__editorial-header">
          <div class="collection-list__editorial-title" data-reveal>
            {% if split_header_block_count == 0 %}
              {% if section.settings.split_label != blank %}<p class="collection-list__editorial-label label-text">{{ section.settings.split_label | escape }}</p>{% endif %}
              {% if section.settings.split_heading != blank %}<h2 class="collection-list__editorial-heading {% render 'typography-class', preset: section.settings.split_heading_size, fallback: 'h2' %}">{{ section.settings.split_heading | escape | newline_to_br }}</h2>{% endif %}
            {% else %}
              {% for block in section.blocks %}
                {% if block.type == 'split_label' %}
                  {% render 'content-block', block: block, content: block.settings.text, kind: 'label', default_preset: 'label', default_font: 'label', force_preset: 'label' %}
                {% elsif block.type == 'heading' %}
                  {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h2', default_font: 'heading' %}
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
          <div class="collection-list__editorial-aside" data-reveal>
            {% for block in section.blocks %}
              {% if block.type == 'split_text' %}
                {% render 'content-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'sm', default_font: 'body' %}
              {% elsif block.type == 'split_button' and block.settings.label != blank %}
                <div class="content-button" {{ block.shopify_attributes }} {% render 'reveal-attributes', settings: block.settings %}>
                  {% render 'cta', label: block.settings.label, url: block.settings.link, style: block.settings.style, icon: block.settings.icon, open_in_new_tab: block.settings.open_in_new_tab %}
                </div>
              {% endif %}
            {% endfor %}
            {% if split_header_block_count == 0 %}
              {% if section.settings.split_text != blank %}<div class="collection-list__editorial-text rte">{{ section.settings.split_text }}</div>{% endif %}
              {% if section.settings.split_button_label != blank %}{% render 'cta', label: section.settings.split_button_label, url: section.settings.split_button_link, style: 'tertiary', icon: 'arrow-right', class: 'collection-list__editorial-button' %}{% endif %}
            {% endif %}
          </div>
        </header>
      {% else %}
        {% for block in section.blocks %}
          {% if block.type == 'heading' and block.settings.heading != blank %}
            <div class="collection-list__header collection-list__heading">
              {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h2', default_font: 'heading' %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}

      <div class="collection-list__carousel">
        <div class="collection-list__slider{% if section.settings.layout == 'grid' %} swiper{% endif %}"{% if section.settings.layout == 'grid' %} data-collection-list-slider{% endif %}>
          <ul class="collection-list__grid collection-list__grid--{{ section.settings.layout }}{% if section.settings.layout == 'grid' %} swiper-wrapper{% endif %}" role="list"{% if section.settings.layout == 'split-promotions' %} data-reveal-group{% endif %}>
        {% assign split_card_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'collection_card' %}
            {% assign split_card_index = split_card_index | plus: 1 %}
            {% liquid
              assign card_collection = block.settings.collection
              assign card_image = block.settings.image
              assign card_title = block.settings.title
              assign card_link = card_collection.url
              assign card_product_count = card_collection.all_products_count
              assign card_overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
              if section.settings.layout != 'split-promotions' and card_overlay_opacity < 0.45
                assign card_overlay_opacity = 0.45
              endif
              assign card_overlay_color = '#000000' | color_modify: 'alpha', card_overlay_opacity

              if card_image == blank and card_collection != blank
                assign card_image = card_collection.image
                if card_image == blank
                  assign first_product = card_collection.products.first
                  assign card_image = first_product.featured_image
                endif
              endif

              if card_title == blank
                assign card_title = card_collection.title
              endif
              if card_title == blank
                assign card_title = 'collection_list.collection' | t
              endif

              assign card_color_scheme = section.settings.color_scheme
              if block.settings.color_scheme != blank
                assign card_color_scheme = block.settings.color_scheme
              endif

              assign card_alt = card_image.alt | default: card_title
              assign columns_desktop = section.settings.columns_desktop | default: 1
              assign columns_tablet = section.settings.columns_desktop | default: 1
              assign columns_mobile = section.settings.columns_mobile | default: 1
              assign desktop_card_width = 100 | divided_by: columns_desktop
              assign tablet_card_width = 100 | divided_by: columns_tablet
              assign mobile_card_width = 100 | divided_by: columns_mobile
              assign card_sizes = '(min-width: 1150px) ' | append: desktop_card_width | append: 'vw, (min-width: 768px) ' | append: tablet_card_width | append: 'vw, ' | append: mobile_card_width | append: 'vw'
              if section.settings.layout == 'split-promotions'
                if split_card_index == 1
                  assign card_sizes = '(min-width: 1150px) 46vw, (min-width: 768px) 42vw, 100vw'
                else
                  assign card_sizes = '(min-width: 1150px) 24vw, (min-width: 768px) 29vw, 50vw'
                endif
              endif

              assign card_placeholder_asset = 'collection-1'
              if section.settings.layout == 'split-promotions'
                assign card_placeholder_index = split_card_index | minus: 1 | modulo: 5 | plus: 1
                assign card_placeholder_asset = 'collection-' | append: card_placeholder_index
              endif

              assign card_loading = 'lazy'
              assign card_fetchpriority = 'auto'
              assign card_preload = false
              assign card_decoding = 'async'
              if request.page_type == 'collection'
                assign card_fetchpriority = 'low'
              endif
              if request.page_type == 'collection' and card_image != blank and has_prioritized_collection_image == false
                assign card_loading = 'eager'
                assign card_fetchpriority = 'high'
                assign card_preload = true
                assign card_decoding = 'sync'
                assign has_prioritized_collection_image = true
              endif
            %}

            <li class="collection-list__item{% if section.settings.layout == 'grid' %} swiper-slide{% else %} collection-list__item--split-{{ split_card_index }}{% endif %}" data-block-id="{{ block.id }}"{% if section.settings.layout == 'split-promotions' %} data-reveal-item style="--reveal-order: {{ split_card_index | minus: 1 }};"{% endif %} {{ block.shopify_attributes }}>
              {% if card_link != blank %}
                <a
                  class="collection-list__card collection-list__card--{{ section.settings.layout }} color-scheme color-{{ card_color_scheme.id }}"
                  href="{{ card_link | escape }}"
                  style="--collection-list-image-position: {{ block.settings.focal_point }}; --collection-list-overlay-color: {{ card_overlay_color }};"
                >
              {% else %}
                <div
                  class="collection-list__card collection-list__card--{{ section.settings.layout }} color-scheme color-{{ card_color_scheme.id }}"
                  style="--collection-list-image-position: {{ block.settings.focal_point }}; --collection-list-overlay-color: {{ card_overlay_color }};"
                >
              {% endif %}

                <div class="collection-list__media collection-list__media--{{ section.settings.image_ratio }}">
                  {% render 'responsive-media',
                    image: card_image,
                    max_width: 1400,
                    widths: '320, 480, 640, 800, 1000, 1200, 1400',
                    sizes: card_sizes,
                    class: 'collection-list__image',
                    loading: card_loading,
                    fetchpriority: card_fetchpriority,
                    preload: card_preload,
                    decoding: card_decoding,
                    alt: card_alt,
                    placeholder_asset: card_placeholder_asset,
                    placeholder_class: 'collection-list__placeholder'
                  %}
                </div>

                {% if section.settings.layout == 'split-promotions' %}
                  <span class="collection-list__overlay" aria-hidden="true"></span>
                  <div class="collection-list__content collection-list__content--{{ section.settings.card_alignment }} collection-list__content--position-{{ block.settings.content_position }}">
                    {% if block.settings.subheading != blank %}
                      <span class="collection-list__subheading subheading-text">{{ block.settings.subheading | escape }}</span>
                    {% endif %}
                    <{{ section.settings.card_heading_tag | default: 'h3' }} class="collection-list__promotion-heading collection-list__promotion-heading--{{ section.settings.card_heading_size | default: 'h3' }} {% render 'typography-class', preset: section.settings.card_heading_size, fallback: 'h3' %}">
                      {{ card_title | escape }}
                    </{{ section.settings.card_heading_tag | default: 'h3' }}>
                    {% if block.settings.description != blank %}
                      <p class="collection-list__promotion-description">{{ block.settings.description | escape }}</p>
                    {% endif %}
                    {% if card_link != blank %}
                      <span class="btn-tertiary collection-list__button" aria-hidden="true">
                        <span>{{ block.settings.button_label | default: 'View collection' | escape }}</span>
                        <span class="button__icon" aria-hidden="true">{% render 'icon', name: 'button-arrow' %}</span>
                      </span>
                    {% endif %}
                  </div>
                {% else %}
                  <span class="collection-list__overlay" aria-hidden="true"></span>
                  <span class="collection-list__content collection-list__content--{{ section.settings.card_alignment }} collection-list__content--position-bottom">
                    <{{ section.settings.card_heading_tag | default: 'h3' }} class="collection-list__title collection-list__title--{{ section.settings.card_heading_size | default: 'h3' }} {% render 'typography-class', preset: section.settings.card_heading_size, fallback: 'h3' %}">
                      {{ card_title | escape }}
                    </{{ section.settings.card_heading_tag | default: 'h3' }}>
                    {% if block.settings.show_product_count != false and card_collection != blank %}
                      <span class="collection-list__count">
                        {{ 'collection.product_count' | t: count: card_product_count }}
                      </span>
                    {% endif %}
                  </span>
                {% endif %}

              {% if card_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
          </ul>
        </div>

        {% if section.settings.layout == 'grid' %}
          <button
            class="collection-list__navigation-button collection-list__navigation-button--previous"
            type="button"
            aria-label="{{ 'collection_list.previous_item' | t | escape }}"
            data-collection-list-previous
          >
            {% render 'icon', name: 'chevron-left' %}
          </button>
          <button
            class="collection-list__navigation-button collection-list__navigation-button--next"
            type="button"
            aria-label="{{ 'collection_list.next_item' | t | escape }}"
            data-collection-list-next
          >
            {% render 'icon', name: 'chevron-right' %}
          </button>
        {% endif %}
      </div>

      {% if section.settings.layout == 'grid' and section.settings.show_pagination %}
        <div class="collection-list__pagination" data-collection-list-pagination aria-hidden="true">
          <span data-collection-list-progress></span>
        </div>
      {% endif %}
    </div>
  </collection-list>
{% endif %}



{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "section-collection-list",
  "enabled_on": { "templates": ["index", "collection", "product"] },
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "split-promotions",
          "label": "Split promotions"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Desktop column gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Mobile column gap",
      "default": 12
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Header gap",
      "default": 48
    },
    {
      "type": "header",
      "content": "Legacy split promotions header",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "split_label",
      "label": "Label",
      "default": "COLLECTIONS / 05 HOUSE CODES",
      "visible_if": "{{ false }}"
    },
    {
      "type": "textarea",
      "id": "split_heading",
      "label": "Heading",
      "default": "Shop the\nhouse collections.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "select",
      "id": "split_heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "t:typography_options.display_large" },
        { "value": "h2", "label": "t:typography_options.display_medium" },
        { "value": "h3", "label": "t:typography_options.heading_extra_large" },
        { "value": "h4", "label": "t:typography_options.heading_large" }
      ],
      "default": "h2",
      "visible_if": "{{ false }}"
    },
    {
      "type": "richtext",
      "id": "split_text",
      "label": "Text",
      "default": "<p>Five signatures shaped by stone and light.<br>Choose the one that feels like yours.</p>",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "split_button_label",
      "label": "Button label",
      "default": "Explore all 05 house codes",
      "visible_if": "{{ false }}"
    },
    {
      "type": "url",
      "id": "split_button_link",
      "label": "Button link",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "content": "Grid",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Desktop layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slideshow"
        }
      ],
      "default": "slider",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slideshow"
        }
      ],
      "default": "slider",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Slideshow progress",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns / items",
      "default": 3,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns / items",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt", "label": "Adapt"
        },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "2-3", "label": "2:3" },
        { "value": "3-4", "label": "3:4" },
        { "value": "4-5", "label": "4:5" },
        { "value": "6-7", "label": "6:7" },
        { "value": "3-2", "label": "3:2" },
        { "value": "4-3", "label": "4:3" },
        { "value": "16-9", "label": "16:9" }
      ],
      "default": "4-5",
      "info": "For Split promotions, desktop and tablet height still follows the layout height settings. This ratio controls the responsive card proportions on mobile."
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Card content gap",
      "default": 20,
      "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
    },
    {
      "type": "select",
      "id": "card_heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "t:typography_options.display_extra_large"
        },
        {
          "value": "h1",
          "label": "t:typography_options.display_large"
        },
        {
          "value": "h2",
          "label": "t:typography_options.display_medium"
        },
        {
          "value": "h3",
          "label": "t:typography_options.heading_extra_large"
        },
        {
          "value": "h4",
          "label": "t:typography_options.heading_large"
        },
        {
          "value": "h5",
          "label": "t:typography_options.heading_medium"
        },
        {
          "value": "h6",
          "label": "t:typography_options.heading_small"
        },
        {
          "value": "h7",
          "label": "t:typography_options.heading_extra_small"
        },
        {
          "value": "custom",
          "label": "t:typography_options.custom"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "card_heading_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Split promotion heights",
      "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Desktop height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
