{% render 'section-stylesheet', asset: 'section-horizontal-banners.css', defer_on_home: true %}

{% if section.blocks.size > 0 %}
  <horizontal-scrolling-banners
    class="horizontal-banners color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% else %} horizontal-banners--contained{% endif %}{% if section.settings.animate %} horizontal-banners--animate{% endif %}"
    style="--horizontal-banners-desktop-height: {{ section.settings.desktop_height }}dvh; --horizontal-banners-mobile-height: {{ section.settings.mobile_height }}dvh; --horizontal-banners-cue-color: {{ section.settings.scroll_text_color }};"
    data-horizontal-banners
    data-deferred-module="{{ 'section-horizontal-banners.js' | asset_url }}"
    role="region"
    aria-label="{{ section.settings.accessibility_label | escape }}"
  >
    <div class="horizontal-banners__scene" data-horizontal-banners-scene>
      <div class="horizontal-banners__sticky" data-horizontal-banners-sticky>
        <div class="horizontal-banners__track" data-horizontal-banners-track tabindex="0">
          {% for block in section.blocks %}
            {% liquid
              assign panel_color_scheme_id = block.settings.color_scheme.id | default: 'scheme-1'
              assign media_focal_point = block.settings.video_focal_point | default: 'center center'
              assign media_fit = 'cover'
              if block.settings.fit_media
                assign media_fit = 'contain'
              endif
            %}

            <article
              class="horizontal-banners__panel horizontal-banners__panel--{{ block.type }} horizontal-banners__panel--size-{{ block.settings.desktop_size }}{% if block.type == 'media_with_text' %} horizontal-banners__panel--content-{{ block.settings.content_position }}{% endif %} color-scheme color-{{ panel_color_scheme_id }}"
              style="--horizontal-banners-focal-point: {{ media_focal_point }}; --horizontal-banners-media-fit: {{ media_fit }}; --horizontal-banners-overlay-color: {{ block.settings.image_overlay | default: '#000000' }}; --horizontal-banners-overlay-gradient: {{ block.settings.image_overlay_gradient | default: 'none' }}; --horizontal-banners-overlay-opacity: {{ block.settings.image_overlay_opacity | default: 0 | divided_by: 100.0 }}; --horizontal-banners-heading-color: {{ block.settings.heading_color | default: 'var(--color-heading)' }}; --horizontal-banners-heading-gradient: {{ block.settings.heading_gradient | default: 'none' }}; --horizontal-banners-panel-background: {{ block.settings.background_color | default: 'var(--gradient-background, var(--color-background))' }}; --horizontal-banners-panel-text: {{ block.settings.text_color | default: 'var(--color-text)' }}; --horizontal-banners-media-background: {{ block.settings.media_background | default: 'var(--color-variant-component-background)' }};"
              data-horizontal-banners-panel
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {% case block.type %}
                {% when 'media' %}
                  <div class="horizontal-banners__media">
                    {% if block.settings.video != blank %}
                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: false,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          class: 'horizontal-banners__media-element'
                      }}
                    {% else %}
                      {% render 'responsive-media',
                        image: block.settings.image,
                        max_width: 2400,
                        widths: '480, 750, 960, 1200, 1600, 2000, 2400',
                        sizes: '(min-width: 1150px) 100vw, 90vw',
                        class: 'horizontal-banners__media-element',
                        alt: block.settings.image_alt,
                        loading: 'lazy',
                        placeholder_asset: 'placeholder-image-default-1.svg',
                        placeholder_class: 'horizontal-banners__placeholder'
                      %}
                    {% endif %}
                  </div>

                {% when 'text' %}
                  {% render 'horizontal-banner-content', block: block %}

                {% when 'media_with_text' %}
                  <div class="horizontal-banners__media">
                    {% if block.settings.video != blank %}
                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: false,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          class: 'horizontal-banners__media-element'
                      }}
                    {% else %}
                      {% render 'responsive-media',
                        image: block.settings.image,
                        max_width: 2000,
                        widths: '480, 750, 960, 1200, 1600, 2000',
                        sizes: '(min-width: 1150px) 62vw, 90vw',
                        class: 'horizontal-banners__media-element',
                        alt: block.settings.image_alt,
                        loading: 'lazy',
                        placeholder_asset: 'placeholder-image-default-2.svg',
                        placeholder_class: 'horizontal-banners__placeholder'
                      %}
                    {% endif %}
                    <span class="horizontal-banners__overlay" aria-hidden="true"></span>
                  </div>
                  {% render 'horizontal-banner-content', block: block %}
              {% endcase %}
            </article>
          {% endfor %}
        </div>

        {% liquid
          assign scroll_text_size = section.settings.scroll_text_size | default: 'large'
          case scroll_text_size
            when 'lg'
              assign scroll_text_size = 'x-large'
            when 'md'
              assign scroll_text_size = 'large'
            when 'sm'
              assign scroll_text_size = 'medium'
            when 'xs', 'label_uppercase'
              assign scroll_text_size = 'small'
          endcase
        %}
        {% if section.settings.show_scroll_text and section.settings.scroll_text != blank %}
          <div class="horizontal-banners__cue horizontal-banners__cue--{{ section.settings.scroll_text_position }} horizontal-banners__type--{{ section.settings.scroll_text_size }} spinel-text--{{ scroll_text_size }}" data-horizontal-banners-cue aria-hidden="true">
            <span>{{ section.settings.scroll_text | escape }}</span>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M14 7l5 5-5 5"/>
            </svg>
          </div>
        {% endif %}
      </div>
    </div>
  </horizontal-scrolling-banners>
{% endif %}




