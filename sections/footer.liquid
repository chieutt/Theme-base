{% render 'section-stylesheet', asset: 'section-footer.css', defer_on_home: true %}
{% render 'section-stylesheet', asset: 'section-footer-redesign.css', defer_on_home: true %}

{% liquid
  assign localization_form_id = 'FooterLocalizationForm-' | append: section.id
  assign copyright_name = section.settings.copyright_name
  assign footer_background = section.settings.background_color
  if footer_background == blank
    assign footer_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
  if copyright_name == blank
    assign copyright_name = shop.name
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ footer_background }};
  }
{% endstyle %}

<footer-house
  class="footer-house color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  data-deferred-module="{{ 'section-footer.js' | asset_url }}"
>
  <footer
    class="footer"
    style="
      --footer-padding-top: {{ section.settings.padding_top }}px;
      --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="footer__inner">
      <div class="footer__lead">
        {% content_for 'block', type: '_footer-newsletter', id: 'newsletter' %}
        {% if section.settings.show_appointment %}
          {% content_for 'block', type: '_footer-appointment', id: 'appointment' %}
        {% endif %}
      </div>

      <div class="footer__menus">
        {% content_for 'blocks' %}
      </div>

      {% content_for 'block', type: '_footer-signature', id: 'signature' %}

      <div class="footer__utility">
        <div class="footer__utility-start">
          {% if section.settings.show_country_selector or section.settings.show_language_selector %}
            <footer-localization class="footer__localization">
              {% form 'localization', id: localization_form_id %}
                <div class="footer__region">
                  {% if section.settings.show_country_selector %}
                    {% if localization.available_countries.size > 1 %}
                      <label class="visually-hidden" for="FooterCountry-{{ section.id }}">{{ 'footer.country_region' | t }}</label>
                      <span class="footer__localization-select">
                        <select id="FooterCountry-{{ section.id }}" name="country_code" data-footer-localization-select>
                          {% for country in localization.available_countries %}
                            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                              {{ country.name | escape }} / {{ country.currency.iso_code | escape }}
                            </option>
                          {% endfor %}
                        </select>
                        <span class="footer__localization-select-icon" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                      </span>
                    {% else %}
                      <span>{{ localization.country.name | escape }} / {{ localization.country.currency.iso_code | escape }}</span>
                    {% endif %}
                  {% endif %}

                  {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
                    {% if section.settings.show_country_selector %}<span class="footer__utility-divider" aria-hidden="true">/</span>{% endif %}
                    <label class="visually-hidden" for="FooterLanguage-{{ section.id }}">{{ 'footer.language' | t }}</label>
                    <span class="footer__localization-select">
                      <select id="FooterLanguage-{{ section.id }}" name="locale_code" data-footer-localization-select>
                        {% for language in localization.available_languages %}
                          <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                            {{ language.endonym_name | capitalize | escape }}
                          </option>
                        {% endfor %}
                      </select>
                      <span class="footer__localization-select-icon" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                    </span>
                  {% endif %}
                </div>
                <noscript><button type="submit">{{ 'footer.apply' | t }}</button></noscript>
              {% endform %}
            </footer-localization>
          {% endif %}
        </div>

        <div class="footer__copyright">
          &copy; {{ copyright_name | escape }} {{ 'now' | date: '%Y' }}
        </div>

        <div class="footer__utility-end">
          {% if section.settings.legal_menu != blank and section.settings.legal_menu.links.size > 0 %}
            <nav class="footer__legal" aria-label="{{ 'footer.legal' | t | escape }}">
              {% for link in section.settings.legal_menu.links %}
                <a href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% endfor %}
            </nav>
          {% elsif shop.policies.size > 0 %}
            <nav class="footer__legal" aria-label="{{ 'footer.legal' | t | escape }}">
              {% for policy in shop.policies %}
                {% if policy.url != blank and policy.body != blank %}
                <a href="{{ policy.url | escape }}">{{ policy.title | escape }}</a>
                {% endif %}
              {% endfor %}
            </nav>
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="footer__payments" aria-label="{{ 'footer.payment_methods' | t | escape }}">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.show_follow_on_shop %}
        <div class="footer__follow-on-shop">
          {{ shop | login_button: action: 'follow' }}
        </div>
      {% endif %}
    </div>
  </footer>
</footer-house>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Content display"
    },
    {
      "type": "checkbox",
      "id": "show_appointment",
      "label": "Show private appointment callout",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_signup_heading",
      "label": "Newsletter heading",
      "default": "Private notes from the atelier."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "header",
      "content": "Store utilities"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Language selector",
      "default": false
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "info": "Uses the shop name when left blank.",
      "default": "ORLUNE"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Payment icons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "Show Follow on Shop",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "footer-menu"
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "category": "Theme layout",
      "blocks": [
        {
          "type": "_footer-newsletter",
          "id": "newsletter",
          "static": true,
          "blocks": [
            {
              "type": "label",
              "id": "newsletter_eyebrow",
              "static": true,
              "settings": {
                "text": "<p>PRIVATE NOTES / OCCASIONAL LETTERS</p>"
              }
            },
            {
              "type": "heading",
              "id": "newsletter_heading",
              "static": true,
              "settings": {
                "heading": "<h2>Keep close to<br>what endures.</h2>",
                "type_preset": "h1"
              }
            },
            {
              "type": "text",
              "id": "newsletter_text",
              "static": true,
              "settings": {
                "text": "<p>Notes on rare stones and atelier work.<br>Objects made to endure.</p>",
                "type_preset": "md"
              }
            },
            {
              "type": "newsletter-form",
              "id": "newsletter_form",
              "static": true,
              "settings": {
                "email_label": "Email address",
                "email_placeholder": "YOUR EMAIL ADDRESS",
                "hide_label": true,
                "show_required_marker": false,
                "button_label": "JOIN THE LIST",
                "button_style": "primary",
                "icon": "arrow-right",
                "form_layout": "inline",
                "success_message": "Thank you for subscribing."
              }
            },
            {
              "type": "label",
              "id": "newsletter_note",
              "static": true,
              "settings": {
                "text": "<p>OCCASIONAL LETTERS. UNSUBSCRIBE AT ANY TIME.</p>"
              }
            }
              ]
            },
        {
          "type": "_footer-appointment",
          "id": "appointment",
          "static": true,
          "settings": {
            "color_scheme": "scheme-5",
            "background_color": "",
            "padding_top": 28,
            "padding_right": 32,
            "padding_bottom": 30,
            "padding_left": 32
          },
          "blocks": [
            {
              "type": "label",
              "id": "appointment_eyebrow",
              "static": true,
              "settings": {
                "text": "<p>PRIVATE APPOINTMENTS</p>"
              }
            },
            {
              "type": "heading",
              "id": "appointment_heading",
              "static": true,
              "settings": {
                "heading": "<h2>Discover Orlune,<br>one piece at a time.</h2>",
                "type_preset": "xl"
              }
            },
            {
              "type": "text",
              "id": "appointment_text",
              "static": true,
              "settings": {
                "text": "<p>Private consultations shaped around your intention,<br>timing and next piece.</p>",
                "type_preset": "sm"
              }
            },
            {
              "type": "button",
              "id": "appointment_button",
              "static": true,
              "settings": {
                "label": "BOOK AN APPOINTMENT",
                "link": "/pages/contact",
                "style": "secondary",
                "icon": "arrow-right"
              }
            }
          ]
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>SHOP</h3>",
            "type_preset": "h7",
            "font": "body",
            "menu": "footer-shop",
            "show_external_indicator": true
          }
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>THE HOUSE</h3>",
            "type_preset": "h7",
            "font": "body",
            "menu": "footer-about",
            "show_external_indicator": true
          }
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>CLIENT CARE</h3>",
            "type_preset": "h7",
            "font": "body",
            "menu": "footer-help",
            "show_external_indicator": true
          }
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>CONNECT</h3>",
            "type_preset": "h7",
            "font": "body",
            "menu": "footer",
            "show_external_indicator": true
          }
        },
        {
          "type": "_footer-signature",
          "id": "signature",
          "static": true,
          "settings": {
            "image_opacity": 100,
            "show_image_mobile": true
          },
          "blocks": [
            {
              "type": "label",
              "id": "signature_eyebrow",
              "static": true,
              "settings": {
                "text": "<p>THE HOUSE OF ORLUNE / NEW YORK</p>"
              }
            },
            {
              "type": "heading",
              "id": "signature_wordmark",
              "static": true,
              "settings": {
                "heading": "<p>ORLUNE</p>",
                "type_preset": "h1",
                "width": "100%",
                "width_mobile": "100%"
              }
            },
            {
              "type": "label",
              "id": "signature_principles",
              "static": true,
              "settings": {
                "text": "<p>NATURAL STONES<br>SCULPTURAL GOLD<br>MADE WITH INTENT</p>"
              }
            },
            {
              "type": "label",
              "id": "signature_tagline",
              "static": true,
              "settings": {
                "text": "<p>OBJECTS OF COLOUR, CHARACTER AND CONSEQUENCE.</p>"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
