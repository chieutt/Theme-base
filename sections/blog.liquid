{% liquid
  assign featured_block = section.blocks | where: 'type', 'featured_article' | first
  assign grid_block = section.blocks | where: 'type', 'article_grid' | first
  assign featured_article = blank
  assign featured_height = 480
  assign card_gap = 20
  assign mobile_card_gap = 12

  if featured_block != blank
    assign featured_article = featured_block.settings.article
    assign featured_height = featured_block.settings.hero_height
    if featured_article == blank and featured_block.settings.use_latest_article
      assign featured_article = blog.articles.first
    endif
  endif

  if grid_block != blank
    assign card_gap = grid_block.settings.card_gap
    assign mobile_card_gap = grid_block.settings.mobile_card_gap | default: 12
  endif
%}

<div class="blog-index color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}" style="--blog-index-hero-height: {{ featured_height }}px; --blog-index-card-gap: {{ card_gap }}px; --blog-index-mobile-card-gap: {{ mobile_card_gap }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="blog-index__inner section-spacing">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'header' %}
          <header class="blog-index__header" {{ block.shopify_attributes }}>
            {% if block.settings.subheading != blank %}<p class="blog-index__subheading subheading-text">{{ block.settings.subheading | escape }}</p>{% endif %}
            <{{ block.settings.heading_tag | default: 'h1' }} class="blog-index__title {% render 'typography-class', preset: block.settings.heading_size, fallback: 'h1' %}">{{ block.settings.heading | default: blog.title | escape }}</{{ block.settings.heading_tag | default: 'h1' }}>
            {% if block.settings.intro != blank %}<p class="blog-index__intro">{{ block.settings.intro | escape }}</p>{% endif %}
          </header>

        {% when 'featured_article' %}
          {% if featured_article != blank %}
            <article class="blog-index__featured" {{ block.shopify_attributes }}>
              {% assign featured_article_image_alt = featured_article.image.alt | default: featured_article.title %}
              {% render 'responsive-media', image: featured_article.image, max_width: 1800, widths: '640, 960, 1200, 1600, 1800', sizes: '100vw', class: 'blog-index__featured-image media-cover', loading: 'eager', fetchpriority: 'high', alt: featured_article_image_alt, placeholder_asset: 'placeholder-image-default-2.svg', placeholder_class: 'blog-index__featured-image media-cover' %}
              <div class="blog-index__featured-overlay" aria-hidden="true"></div>
              <div class="blog-index__featured-copy">
                {% if block.settings.show_tag and featured_article.tags.first != blank %}<p class="blog-index__tag label-text">{{ featured_article.tags.first | escape }}</p>{% endif %}
                <h2 class="blog-index__featured-title heading-h2 heading-text"><a href="{{ featured_article.url | escape }}">{{ featured_article.title | escape }}</a></h2>
                {% if block.settings.show_date %}<p class="blog-index__metadata">{{ featured_article.published_at | time_tag: format: 'date' }}</p>{% endif %}
                {% if block.settings.show_button %}<a class="btn-secondary blog-index__featured-button" href="{{ featured_article.url | escape }}">{{ block.settings.button_label | escape }}</a>{% endif %}
              </div>
            </article>
          {% endif %}

        {% when 'article_grid' %}
          {% paginate blog.articles by block.settings.articles_per_page %}
            <div class="blog-index__grid" role="list" data-reveal-group {{ block.shopify_attributes }}>
              {% for article in blog.articles %}
                {% if article.id != featured_article.id or block.settings.show_featured_in_grid %}
                  <article class="blog-index__card" role="listitem" data-reveal-item style="--reveal-order: {{ forloop.index0 }};">
                    <a class="blog-index__card-media" href="{{ article.url | escape }}">
                      {% assign article_image_alt = article.image.alt | default: article.title %}
                      {% render 'responsive-media', image: article.image, max_width: 900, widths: '360, 540, 720, 900', sizes: '(min-width: 1150px) 33vw, (min-width: 768px) 50vw, 100vw', class: 'blog-index__card-image media-cover', loading: 'lazy', alt: article_image_alt, placeholder_asset: 'placeholder-image-default-1.svg', placeholder_class: 'blog-index__card-image media-cover' %}
                    </a>
                    <div class="blog-index__card-copy">
                      {% if block.settings.show_tags and article.tags.first != blank %}<p class="blog-index__tag label-text">{{ article.tags.first | escape }}</p>{% endif %}
                      <h2 class="blog-index__card-title heading-h2 heading-text"><a href="{{ article.url | escape }}">{{ article.title | escape }}</a></h2>
                      {% if block.settings.show_date or block.settings.show_author %}<p class="blog-index__metadata">{% if block.settings.show_date %}{{ article.published_at | time_tag: format: 'date' }}{% endif %}{% if block.settings.show_date and block.settings.show_author %}<span aria-hidden="true"> · </span>{% endif %}{% if block.settings.show_author %}{{ article.author | escape }}{% endif %}</p>{% endif %}
                      {% if block.settings.show_excerpt and article.excerpt != blank %}<div class="blog-index__excerpt rte">{{ article.excerpt | strip_html | truncatewords: block.settings.excerpt_words }}</div>{% endif %}
                      <a class="btn-tertiary blog-index__read-more" href="{{ article.url | escape }}" aria-label="{{ block.settings.read_more_label | escape }}: {{ article.title | escape }}"><span>{{ block.settings.read_more_label | escape }}</span><span class="button__icon" aria-hidden="true">{% render 'icon', name: 'button-arrow' %}</span></a>
                    </div>
                  </article>
                {% endif %}
              {% endfor %}
            </div>
            {% if block.settings.show_pagination %}
              {% render 'pagination',
                paginate: paginate,
                base_class: 'blog-index__pagination',
                aria_label: 'blog.pagination' | t,
                previous_label: 'blog.previous_page' | t,
                next_label: 'blog.next_page' | t
              %}
            {% endif %}
          {% endpaginate %}
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .blog-index { display: block; background: var(--gradient-background, var(--color-background)); color: var(--color-text); }
  .blog-index__inner { width: 100%; max-width: var(--page-width); margin-inline: auto; }
  .blog-index.full-width .blog-index__inner { max-width: none; padding-inline: var(--page-margin); }
  .blog-index__header { padding: 26px 0 42px; text-align: center; }
  .blog-index__subheading, .blog-index__tag { color: var(--color-text); }
  .blog-index__title { margin: 6px 0 0; }
  .blog-index__intro { max-width: 560px; margin: 18px auto 0; line-height: 1.5; }
  .blog-index__featured { position: relative; min-height: var(--blog-index-hero-height); overflow: hidden; color: #fff; }
  .blog-index__featured-image, .blog-index__featured-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .blog-index__featured-image { object-fit: cover; }
  .blog-index__featured-overlay { background: linear-gradient(90deg, rgb(0 0 0 / 58%), rgb(0 0 0 / 5%)); }
  .blog-index__featured-copy { position: relative; z-index: 1; display: flex; max-width: 640px; min-height: var(--blog-index-hero-height); flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(32px, 6vw, 92px); }
  .blog-index__featured-copy .blog-index__tag, .blog-index__featured-copy .blog-index__metadata { color: rgb(255 255 255 / 88%); }
  .blog-index__featured-title { margin: 12px 0 0; color: inherit; font-size: clamp(32px, 4vw, 58px); line-height: 1.05; }
  .blog-index__featured-title a, .blog-index__card-title a { color: inherit; text-decoration: none; }
  .blog-index__metadata { margin-top: 12px; font-size: var(--label-size); }
  .blog-index__featured-button { margin-top: 26px; }
  .blog-index__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--blog-index-card-gap); padding-top: 46px; }
  .blog-index__card { min-width: 0; }
  .blog-index__card-media { display: block; aspect-ratio: 1.25; overflow: hidden; background: var(--color-variant-component-background); }
  .blog-index__card-image { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .blog-index__card-media:hover .blog-index__card-image { transform: scale(1.03); }
  .blog-index__card-copy { padding: 18px 4px 0; }
  .blog-index__card-title { margin-top: 9px; font-size: clamp(20px, 2vw, 26px); line-height: 1.12; }
  .blog-index__excerpt { margin-top: 10px; color: var(--color-text); line-height: 1.45; }
  .blog-index__read-more { margin-top: 18px; color: var(--color-heading); }
  .blog-index__pagination { display: flex; justify-content: center; padding-top: 48px; }
  .blog-index__pagination a, .blog-index__pagination span { padding: 8px 12px; color: inherit; text-decoration: none; }
  @media screen and (max-width: 1149.98px) { .blog-index__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media screen and (max-width: 767.98px) { .blog-index__inner { padding-inline: var(--page-margin); } .blog-index.full-width .blog-index__inner { padding-inline: var(--page-margin); } .blog-index__header { padding-block: 24px 30px; } .blog-index__featured { min-height: 420px; } .blog-index__featured-copy { min-height: 420px; padding: 28px; } .blog-index__grid { grid-template-columns: 1fr; gap: var(--blog-index-mobile-card-gap); padding-top: 32px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "section-blog-index",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Theme settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "Blog header",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Blog header"
        },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Journal" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Journal" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "h0",
              "label": "t:typography_options.display_extra_large"
            },
            {
              "value": "h1",
              "label": "t:typography_options.display_large"
            },
            {
              "value": "h2",
              "label": "t:typography_options.display_medium"
            },
            {
              "value": "h3",
              "label": "t:typography_options.heading_extra_large"
            },
            {
              "value": "h4",
              "label": "t:typography_options.heading_large"
            },
            {
              "value": "h5",
              "label": "t:typography_options.heading_medium"
            },
            {
              "value": "h6",
              "label": "t:typography_options.heading_small"
            },
            {
              "value": "h7",
              "label": "t:typography_options.heading_extra_small"
            },
            {
              "value": "custom",
              "label": "t:typography_options.custom"
            }
          ],
          "default": "h1"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "HTML tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h1"
        },
        { "type": "textarea", "id": "intro", "label": "Intro" }
      ]
    },
    {
      "type": "featured_article",
      "name": "Featured article",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Featured article"
        },
        { "type": "article", "id": "article", "label": "Article" },
        { "type": "checkbox", "id": "use_latest_article", "label": "Use newest article when none is selected", "default": true },
        { "type": "range", "id": "hero_height", "min": 280, "max": 760, "step": 20, "unit": "px", "label": "Height", "default": 480 },
        { "type": "checkbox", "id": "show_tag", "label": "Show tag", "default": true },
        { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
        { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Read story" }
      ]
    },
    {
      "type": "article_grid",
      "name": "Article grid",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Article grid"
        },
        { "type": "range", "id": "articles_per_page", "min": 3, "max": 12, "step": 1, "label": "Articles per page", "default": 10 },
        { "type": "range", "id": "card_gap", "min": 12, "max": 48, "step": 4, "unit": "px", "label": "Desktop column gap", "default": 20 },
        { "type": "range", "id": "mobile_card_gap", "min": 0, "max": 48, "step": 4, "unit": "px", "label": "Mobile column gap", "default": 12 },
        { "type": "checkbox", "id": "show_featured_in_grid", "label": "Show featured article in grid", "default": false },
        { "type": "header", "content": "Card content" },
        { "type": "checkbox", "id": "show_tags", "label": "Show tags", "default": true },
        { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
        { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
        { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpts", "default": true },
        { "type": "range", "id": "excerpt_words", "min": 8, "max": 40, "step": 2, "label": "Excerpt length", "default": 18 },
        { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Read more" },
        { "type": "header", "content": "Pagination" },
        { "type": "checkbox", "id": "show_pagination", "label": "Show pagination", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog",
      "category": "Blog and pages",
      "blocks": [
        { "type": "header" },
        { "type": "featured_article" },
        { "type": "article_grid" }
      ]
    }
  ]
}
{% endschema %}
