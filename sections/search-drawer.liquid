    },
    { "type": "range", "id": "recently_viewed_heading_font_size", "label": "t:typography_blocks.size", "min": 8, "max": 100, "step": 2, "unit": "px", "default": 50, "visible_if": "{{ section.settings.show_recently_viewed and section.settings.recently_viewed_heading_size == 'custom' }}" },
    { "type": "range", "id": "recently_viewed_heading_font_size_mobile", "label": "t:typography_blocks.mobile_size", "min": 8, "max": 100, "step": 2, "unit": "px", "default": 30, "visible_if": "{{ section.settings.show_recently_viewed and section.settings.recently_viewed_heading_size == 'custom' }}" },
    { "type": "range", "id": "recently_viewed_limit", "label": "Product limit", "min": 1, "max": 6, "step": 1, "default": 6, "visible_if": "{{ section.settings.show_recently_viewed }}" },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick-add icon", "default": true, "visible_if": "{{ section.settings.show_recently_viewed }}" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "desktop_width", "label": "Desktop drawer width", "min": 360, "max": 600, "step": 10, "unit": "px", "default": 550 },
    { "type": "checkbox", "id": "indent_desktop", "label": "Indent on desktop", "default": false },
    { "type": "checkbox", "id": "blur_backdrop", "label": "Blur backdrop", "default": false }
  ],
  "presets": [
    {
      "name": "Search drawer"
    }
  ],
  "enabled_on": { "groups": ["custom.overlay"] }
}
{% endschema %}
