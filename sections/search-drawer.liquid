    { "type": "header", "content": "Recently viewed" },
    { "type": "checkbox", "id": "show_recently_viewed", "label": "Show recently viewed products", "default": true },
    { "type": "text", "id": "recently_viewed_heading", "label": "Heading", "default": "Recently viewed", "visible_if": "{{ section.settings.show_recently_viewed }}" },
    {
      "type": "select",
      "id": "recently_viewed_heading_size",
