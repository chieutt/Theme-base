{% liquid
  assign logo_image = section.settings.logo | default: settings.logo
  assign password_form_id = 'PasswordAccess-' | append: section.id
%}

<header class="password-header color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.show_border %} password-header--bordered{% endif %}" style="--password-header-padding: {{ section.settings.padding }}px;">
  <div class="password-header__inner">
    <a class="password-header__brand" href="{{ routes.root_url | escape }}" aria-label="{{ shop.name | escape }}">
      {% if logo_image != blank %}
        {{ logo_image | image_url: width: 500 | image_tag: class: 'password-header__logo', widths: '120, 180, 240, 360, 500', sizes: 'min(46vw, 220px)', alt: logo_image.alt | default: shop.name, loading: 'eager' }}
      {% else %}
        <span>{{ section.settings.logo_text | default: shop.name | escape }}</span>
      {% endif %}
    </a>

    {% if section.settings.show_password_access %}
      <details class="password-header__access">
        <summary class="btn-secondary">{{ section.settings.password_link_label | escape }}</summary>
        <div class="password-header__access-panel">
          <p class="password-header__access-heading">{{ section.settings.password_heading | escape }}</p>
          {% form 'storefront_password', id: password_form_id, class: 'password-header__access-form' %}
            {% if form.errors %}
              <div class="password-header__form-message password-header__form-message--error form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}
            <label class="visually-hidden" for="{{ password_form_id }}-input">{{ 'password.password' | t }}</label>
            <input class="form-control form-input" id="{{ password_form_id }}-input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
            <button class="btn-primary" type="submit">{{ 'password.enter' | t }}</button>
          {% endform %}
        </div>
      </details>
    {% endif %}
  </div>
</header>

{% stylesheet %}
  .password-header { position: relative; z-index: 3; background: var(--gradient-background, var(--color-background)); color: var(--color-text); }
  .password-header--bordered { border-bottom: 1px solid var(--color-variant-border); }
  .password-header__inner { display: flex; width: min(100%, var(--page-width)); min-height: calc(var(--control-height) + var(--password-header-padding) * 2); align-items: center; justify-content: space-between; gap: 20px; margin-inline: auto; padding: var(--password-header-padding) var(--page-margin); }
  .password-header__brand { display: inline-flex; max-width: min(46vw, 220px); align-items: center; color: var(--color-heading); font-family: var(--heading-font-family); font-size: var(--h4-size-lg); font-style: var(--heading-font-style); font-weight: var(--heading-font-weight); text-decoration: none; }
  .password-header__logo { width: 100%; height: auto; }
  .password-header__access { position: relative; }
  .password-header__access summary { list-style: none; cursor: pointer; }
  .password-header__access summary::-webkit-details-marker { display: none; }
  .password-header__access-panel { position: absolute; z-index: 4; top: calc(100% + 12px); right: 0; display: grid; width: min(340px, calc(100vw - var(--page-margin) * 2)); gap: 16px; padding: 20px; border: 1px solid var(--color-variant-border); background: var(--color-background); box-shadow: 0 18px 34px color-mix(in srgb, var(--color-shadow) 15%, transparent); }
  .password-header__access-heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font-family); font-size: var(--h5-size-md); font-style: var(--heading-font-style); font-weight: var(--heading-font-weight); }
  .password-header__access-form { display: grid; gap: 10px; }
  .password-header__access-form input { width: 100%; min-width: 0; min-height: var(--control-height); padding: 0 14px; border: 1px solid var(--color-variant-border); border-radius: var(--style-border-radius-inputs); background: var(--color-background); color: var(--color-text); font: inherit; }
  .password-header__access-form input:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  .password-header__access-form .button { width: 100%; }
  .password-header__form-message { margin: 0; color: var(--color-text); font-size: var(--p2-size-sm); line-height: 1.45; }
  .password-header__form-message--error { color: var(--color-sale-price); }
  .password-header__form-message--error ul { margin: 0; padding-left: 18px; }
  @media screen and (max-width: 767.98px) { .password-header__inner { gap: 14px; } .password-header__access-panel { right: calc(var(--page-margin) * -1); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Password header",
  "tag": "section",
  "class": "section-password-header",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "info": "Used when no logo image is selected." },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_border", "label": "Bottom border", "default": false },
    { "type": "checkbox", "id": "show_password_access", "label": "Password access", "default": true },
    { "type": "text", "id": "password_link_label", "label": "Link label", "default": "Enter with password" },
    { "type": "text", "id": "password_heading", "label": "Form heading", "default": "Enter password" },
    {
      "type": "header",
      "content": "Appearance"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
