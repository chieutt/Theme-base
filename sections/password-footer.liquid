<footer class="password-footer color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.show_border %} password-footer--bordered{% endif %}" style="--password-footer-padding: {{ section.settings.padding }}px;">
  <div class="password-footer__inner">
    <div class="password-footer__meta">
      {% if section.settings.copyright_text != blank %}
        <p>{{ section.settings.copyright_text | escape }}</p>
      {% else %}
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
      {% endif %}
      <span>{{ powered_by_link }}</span>
    </div>

    {% if section.settings.menu != blank %}
      <nav aria-label="{{ section.settings.menu_label | escape }}">
        <ul class="password-footer__menu" role="list">
          {% for link in section.settings.menu.links %}
            <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .password-footer { background: var(--gradient-background, var(--color-background)); color: var(--color-text); }
  .password-footer--bordered { border-top: 1px solid var(--color-variant-border); }
  .password-footer__inner { display: flex; width: min(100%, var(--page-width)); align-items: center; justify-content: space-between; gap: 20px; margin-inline: auto; padding: var(--password-footer-padding) var(--page-margin); }
  .password-footer__meta { display: flex; flex-wrap: wrap; gap: 8px 16px; color: var(--color-text); font-size: var(--label-size); line-height: 1.5; }
  .password-footer__meta p { margin: 0; }
  .password-footer__meta a, .password-footer__menu a { position: relative; display: inline-block; color: inherit; text-decoration: none; }
  .password-footer__meta a::after, .password-footer__menu a::after { position: absolute; right: 0; bottom: -3px; left: 0; height: 1px; background: currentcolor; content: ''; transform: scaleX(0); transform-origin: right center; transition: transform 400ms ease; }
  .password-footer__meta a:is(:hover, :focus-visible), .password-footer__menu a:is(:hover, :focus-visible) { color: var(--color-heading); }
  .password-footer__meta a:is(:hover, :focus-visible)::after, .password-footer__menu a:is(:hover, :focus-visible)::after { transform: scaleX(1); transform-origin: left center; }
  .password-footer__menu { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 18px; margin: 0; padding: 0; font-size: var(--label-size); list-style: none; }
  @media screen and (max-width: 767.98px) { .password-footer__inner { flex-direction: column; align-items: flex-start; } .password-footer__menu { justify-content: flex-start; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Password footer",
  "tag": "section",
  "class": "section-password-footer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer" },
    { "type": "text", "id": "menu_label", "label": "Menu label", "default": "Footer navigation" },
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "info": "Uses the shop name and current year when empty." },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "checkbox", "id": "show_border", "label": "Top border", "default": true },
    {
      "type": "header",
      "content": "Appearance"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
