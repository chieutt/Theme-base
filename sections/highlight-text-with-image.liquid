{% render 'section-stylesheet', asset: 'section-highlight-text-with-image.css', defer_on_home: true %}
<script src="{{ 'section-highlight-text-with-image.js' | asset_url }}" defer></script>

{% liquid
  assign highlight_section_background = section.settings.background_color
  if highlight_section_background == blank
    assign highlight_section_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign type_preset = section.settings.type_preset | default: 'h6'
  assign rendered_heading = section.settings.heading | escape
  assign marker_open = '<span class="highlight-text-with-image__marker highlight-text-with-image__marker--' | append: section.settings.marker_style | append: '">'
  if rendered_heading contains '[[' and rendered_heading contains ']]'
    assign rendered_heading = rendered_heading | replace: '[[', marker_open | replace: ']]', '</span>'
  endif

  for block in section.blocks
    assign placeholder = '[img' | append: forloop.index | append: ']'
    assign legacy_placeholder = '[image' | append: forloop.index | append: ']'
    assign image_alt = block.settings.alt | default: block.settings.image.alt
    assign image_ratio = block.settings.image_ratio | default: 'adapt'
    assign image_aspect_ratio = image_ratio
    case image_ratio
      when 'square', '1'
        assign image_aspect_ratio = '1 / 1'
      when '2-3'
        assign image_aspect_ratio = '2 / 3'
      when '3-4'
        assign image_aspect_ratio = '3 / 4'
      when '4-5'
        assign image_aspect_ratio = '4 / 5'
      when '6-7'
        assign image_aspect_ratio = '6 / 7'
      when '3-2', '1.5'
        assign image_aspect_ratio = '3 / 2'
      when '4-3', '1.3333'
        assign image_aspect_ratio = '4 / 3'
      when '16-9', '1.7778'
        assign image_aspect_ratio = '16 / 9'
    endcase
    assign link_label = block.settings.link_label | default: image_alt | default: 'View linked image'
    assign media_placeholder_modifier = ''
    if block.settings.image == blank
      assign media_placeholder_modifier = ' highlight-text-with-image__media--placeholder'
    endif

    capture inline_media
      if block.settings.link != blank
        echo '<a class="highlight-text-with-image__media highlight-text-with-image__media--' | append: block.settings.corner_style | append: ' highlight-text-with-image__media--ratio-' | append: image_ratio | append: media_placeholder_modifier | append: '" href="' | append: block.settings.link | escape | append: '"'
        if block.settings.open_in_new_tab
          echo ' target="_blank" rel="noopener noreferrer"'
        endif
        echo ' aria-label="' | append: link_label | escape | append: '" style="--highlight-media-width: ' | append: block.settings.width | append: 'px; --highlight-media-width-mobile: ' | append: block.settings.width_mobile | append: 'px;'
        if image_ratio != 'adapt'
          echo ' --highlight-media-ratio: ' | append: image_aspect_ratio | append: ';'
        endif
        echo '" ' | append: block.shopify_attributes | append: '>'
      else
        echo '<span class="highlight-text-with-image__media highlight-text-with-image__media--' | append: block.settings.corner_style | append: ' highlight-text-with-image__media--ratio-' | append: image_ratio | append: media_placeholder_modifier | append: '" style="--highlight-media-width: ' | append: block.settings.width | append: 'px; --highlight-media-width-mobile: ' | append: block.settings.width_mobile | append: 'px;'
        if image_ratio != 'adapt'
          echo ' --highlight-media-ratio: ' | append: image_aspect_ratio | append: ';'
        endif
        echo '" ' | append: block.shopify_attributes | append: '>'
      endif

      render 'responsive-media', image: block.settings.image, max_width: 480, widths: '32, 48, 64, 80, 120, 160, 240, 320, 480', sizes: '(min-width: 768px) 160px, 96px', class: 'highlight-text-with-image__image', alt: image_alt, decorative: false, loading: 'lazy', placeholder_asset: 'placeholder-image-default-1.svg', placeholder_class: 'highlight-text-with-image__image highlight-text-with-image__placeholder'

      if block.settings.link != blank
        echo '</a>'
      else
        echo '</span>'
      endif
    endcapture

    assign rendered_heading = rendered_heading | replace: placeholder, inline_media
    assign rendered_heading = rendered_heading | replace: legacy_placeholder, inline_media
  endfor

  for index in (1..8)
    assign unused_placeholder = '[img' | append: index | append: ']'
    assign unused_legacy_placeholder = '[image' | append: index | append: ']'
    assign rendered_heading = rendered_heading | replace: unused_placeholder, ''
    assign rendered_heading = rendered_heading | replace: unused_legacy_placeholder, ''
  endfor

  assign line_height = 'var(--heading-line-height)'
  unless section.settings.line_height == 'theme'
    assign line_height = 'var(--line-height-' | append: section.settings.line_height | append: ')'
  endunless
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ highlight_section_background }};
  }

  #shopify-section-{{ section.id }} .highlight-text-with-image {
    background: transparent;
  }
{% endstyle %}

<highlight-text-with-image
  class="highlight-text-with-image-controller"
  data-animation-speed="{{ section.settings.animation_speed }}"
>
  <div
    class="highlight-text-with-image highlight-text-with-image--height-{{ section.settings.section_height }}{% if section.settings.equal_line_height %} highlight-text-with-image--equal-line-height{% endif %} color-scheme color-{{ section.settings.color_scheme.id }} full-width"
    {% if section.settings.heading != blank %}aria-labelledby="HighlightHeading-{{ section.id }}"{% endif %}
    style="
      --highlight-fill-stop: 100%;
      --highlight-marker-color: {{ section.settings.highlight_color }};
      --highlight-padding-top: {{ section.settings.padding_top }}px;
      --highlight-padding-bottom: {{ section.settings.padding_bottom }}px;
      --highlight-content-width: {{ section.settings.content_width }}px;
      --text-align: {{ section.settings.alignment }};
      {% if type_preset == 'custom' %}
        --highlight-custom-font-size: {{ section.settings.font_size }}px;
        --highlight-custom-font-size-mobile: {{ section.settings.font_size_mobile }}px;
      {% endif %}
      --highlight-line-height: {{ line_height }};
    "
  >
    <div class="highlight-text-with-image__inner highlight-text-with-image__inner--{{ section.settings.section_width }}">
      {% if section.settings.heading != blank %}
        <{{ heading_tag }}
          id="HighlightHeading-{{ section.id }}"
          class="highlight-text-with-image__heading {% render 'typography-class', preset: type_preset, fallback: 'h6' %}"
        >{{- rendered_heading -}}</{{ heading_tag }}>
      {% endif %}
    </div>
  </div>
</highlight-text-with-image>

{% schema %}
{
  "name": "Highlight text with image",
  "tag": "section",
  "class": "section-highlight-text-with-image",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "image",
      "name": "Inline image",
      "settings": [
        {
          "type": "paragraph",
          "content": "Images are inserted into the heading in block order using [img1], [img2], and so on."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Leave blank for decorative images."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Used by screen readers when the image is linked.",
          "visible_if": "{{ block.settings.link != blank }}"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in a new tab",
          "default": false,
          "visible_if": "{{ block.settings.link != blank }}"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image ratio",
          "options": [
            { "value": "adapt", "label": "Adapt" },
            { "value": "square", "label": "Square (1:1)" },
            { "value": "2-3", "label": "2:3" },
            { "value": "3-4", "label": "3:4" },
            { "value": "4-5", "label": "4:5" },
            { "value": "6-7", "label": "6:7" },
            { "value": "3-2", "label": "3:2" },
            { "value": "4-3", "label": "4:3" },
            { "value": "16-9", "label": "16:9" }
          ],
          "default": "adapt"
        },
        {
          "type": "select",
          "id": "corner_style",
          "label": "Corner style",
          "options": [
            { "value": "theme", "label": "Theme" },
            { "value": "square", "label": "Square" },
            { "value": "round", "label": "Round" }
          ],
          "default": "theme"
        },
        {
          "type": "range",
          "id": "width",
          "label": "Desktop width",
          "min": 16,
          "max": 240,
          "step": 4,
          "unit": "px",
          "default": 72
        },
        {
          "type": "range",
          "id": "width_mobile",
          "label": "Mobile width",
          "min": 12,
          "max": 160,
          "step": 4,
          "unit": "px",
          "default": 40
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Jewels for [img1] the moments we mark, chosen with intention, [img2] worn with meaning, [img3] kept for generations."
    },
    {
      "type": "paragraph",
      "content": "To specify image positions, insert placeholders [img1], [img2], and so on. The numbers correspond to the image order in the section. To add heading highlights, wrap your text between [[]]. E.g: Adding [[marker]] will underline [[highlight]] text."
    },
    {
      "type": "select",
      "id": "marker_style",
      "label": "Marker",
      "options": [
        { "value": "underline", "label": "Underline" },
        { "value": "font_highlight", "label": "Font highlight" }
      ],
      "default": "underline"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#81233E"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "t:typography_options.display_extra_large"
        },
        {
          "value": "h1",
          "label": "t:typography_options.display_large"
        },
        {
          "value": "h2",
          "label": "t:typography_options.display_medium"
        },
        {
          "value": "h3",
          "label": "t:typography_options.heading_extra_large"
        },
        {
          "value": "h4",
          "label": "t:typography_options.heading_large"
        },
        {
          "value": "h5",
          "label": "t:typography_options.heading_medium"
        },
        {
          "value": "h6",
          "label": "t:typography_options.heading_small"
        },
        {
          "value": "h7",
          "label": "t:typography_options.heading_extra_small"
        },
        {
          "value": "custom",
          "label": "t:typography_options.custom"
        }
      ],
      "default": "h6"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Custom desktop size",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.type_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Custom mobile size",
      "min": 14,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ section.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        { "value": "theme", "label": "Theme" },
        { "value": "tight", "label": "Tight" },
        { "value": "normal", "label": "Normal" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "theme"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "fit", "label": "Fit content" },
        { "value": "fullscreen", "label": "Fullscreen" }
      ],
      "default": "fit"
    },
    {
      "type": "checkbox",
      "id": "equal_line_height",
      "label": "Enable equal line height",
      "info": "Ensures consistent line spacing when inline images have different heights.",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 480,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 700
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Scroll animation speed",
      "options": [
        { "value": "slow", "label": "Slow" },
        { "value": "medium", "label": "Medium" },
        { "value": "fast", "label": "Fast" }
      ],
      "default": "medium"
    },
    {
      "type": "paragraph",
      "content": "With fit content height, animation timing also responds to the section's position within the viewport."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Highlight text with image",
      "category": "Text",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
    { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
