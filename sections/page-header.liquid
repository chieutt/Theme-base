{% style %}
  #shopify-section-{{ section.id }} {
    --color-background: {{ section.settings.color_scheme.settings.background }};
    --gradient-background: {{ section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background }};
    --color-heading: {{ section.settings.color_scheme.settings.heading }};
    --color-text: {{ section.settings.color_scheme.settings.text }};
    --color-foreground: {{ section.settings.color_scheme.settings.text }};
    --color-variant-overlay: {{ section.settings.color_scheme.settings.variant_overlay }};
    --color-variant-border: color-mix(in srgb, {{ section.settings.color_scheme.settings.variant_border }} 42%, {{ section.settings.color_scheme.settings.background }});
    --color-variant-bar-background: {{ section.settings.color_scheme.settings.variant_bar_background }};
    --color-variant-component-background: {{ section.settings.color_scheme.settings.variant_component_background }};
    --color-primary-button: {{ section.settings.color_scheme.settings.primary_button }};
    --color-primary-button-label: {{ section.settings.color_scheme.settings.primary_button_label }};
    --color-primary-button-outline: {{ section.settings.color_scheme.settings.primary_button_outline }};
    --color-secondary-button: {{ section.settings.color_scheme.settings.secondary_button }};
    --color-secondary-button-label: {{ section.settings.color_scheme.settings.secondary_button_label }};
    --color-secondary-button-outline: {{ section.settings.color_scheme.settings.secondary_button_outline }};
    --color-tertiary-button: {{ section.settings.color_scheme.settings.tertiary_button }};
    --color-shadow: {{ section.settings.color_scheme.settings.shadow }};
    background: var(--gradient-background, var(--color-background));
  }
{% endstyle %}

{% assign page_header_image = section.settings.image | default: section.settings.mobile_image %}

<header
  class="page-header full-width page-header--align-{{ section.settings.content_alignment }}{% if section.settings.section_width == 'full' %} page-header--content-full{% endif %}{% if page_header_image != blank %} page-header--has-image{% endif %}"
  style="--page-header-padding-top: {{ section.settings.padding_top }}px; --page-header-padding-bottom: {{ section.settings.padding_bottom }}px; --page-header-overlay-opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};"
>
  {% if page_header_image != blank %}
    <div class="page-header__media" aria-hidden="true">
      {% render 'responsive-picture', image: page_header_image, mobile_image: section.settings.mobile_image, max_width: 2400, mobile_max_width: 1400, widths: '640, 960, 1200, 1600, 2000, 2400', mobile_widths: '480, 640, 750, 960, 1200, 1400', sizes: '100vw', class: 'page-header__image', loading: 'eager', fetchpriority: 'high', decorative: true %}
      <span class="page-header__overlay"></span>
    </div>
  {% endif %}

  <div class="page-header__inner">
    {% if section.settings.show_breadcrumbs %}
      <nav class="page-header__breadcrumbs" aria-label="{{ 'accessibility.breadcrumb' | t | escape }}">
        <a href="{{ routes.root_url | escape }}">{{ section.settings.home_label | escape }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ page.title | escape }}</span>
      </nav>
    {% endif %}

    {% if section.settings.show_title and page.title != blank %}
      <h1 class="page-header__title {% render 'typography-class', preset: section.settings.title_size, fallback: 'h1' %}">{{ page.title | escape }}</h1>
    {% endif %}
  </div>
</header>

{% stylesheet %}
  .page-header { position: relative; isolation: isolate; color: var(--color-text); }
  .page-header__media, .page-header__image, .page-header__overlay { position: absolute; inset: 0; }
  .page-header__media { z-index: -1; overflow: hidden; }
  .page-header__image { width: 100%; height: 100%; object-fit: cover; }
  .page-header__overlay { background: rgb(0 0 0 / var(--page-header-overlay-opacity)); }
  .page-header__inner { position: relative; width: min(100%, var(--page-width)); margin-inline: auto; padding: var(--page-header-padding-top) var(--page-margin) var(--page-header-padding-bottom); }
  .page-header--content-full .page-header__inner { width: 100%; }
  .page-header__breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; color: var(--color-text); font-size: var(--label-size); line-height: 1.3; }
  .page-header__breadcrumbs a { position: relative; display: inline-block; color: inherit; text-decoration: none; }
  .page-header__breadcrumbs a::after { position: absolute; right: 0; bottom: -3px; left: 0; height: 1px; background: currentcolor; content: ''; transform: scaleX(0); transform-origin: right center; transition: transform 400ms ease; }
  .page-header__breadcrumbs a:is(:hover, :focus-visible) { color: var(--color-heading); }
  .page-header__breadcrumbs a:is(:hover, :focus-visible)::after { transform: scaleX(1); transform-origin: left center; }
  .page-header__breadcrumbs span:last-child { color: var(--color-heading); }
  .page-header__title { margin: 0; color: var(--color-heading); }
  .page-header--align-left .page-header__inner { text-align: left; }
  .page-header--align-center .page-header__inner { text-align: center; }
  .page-header--align-center .page-header__breadcrumbs { justify-content: center; }
  .page-header--align-right .page-header__inner { text-align: right; }
  .page-header--align-right .page-header__breadcrumbs { justify-content: flex-end; }
  @media screen and (min-width: 768px) and (max-width: 1149.98px) { .page-header__inner { padding-top: calc(var(--page-header-padding-top) * .75); padding-bottom: calc(var(--page-header-padding-bottom) * .75); } }
  @media screen and (max-width: 767.98px) { .page-header__inner { padding-top: calc(var(--page-header-padding-top) * .5); padding-bottom: calc(var(--page-header-padding-bottom) * .5); } .page-header__breadcrumbs { margin-bottom: 14px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Page header",
  "tag": "section",
  "class": "section-page-header",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    { "type": "range", "id": "image_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 75, "step": 5, "unit": "%", "default": 20 },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "home_label", "label": "Home label", "default": "Home" },
    { "type": "checkbox", "id": "show_title", "label": "Page title", "default": true },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "h0", "label": "t:typography_options.display_extra_large" },
        { "value": "h1", "label": "t:typography_options.display_large" },
        { "value": "h2", "label": "t:typography_options.display_medium" },
        { "value": "h3", "label": "t:typography_options.heading_extra_large" },
        { "value": "h4", "label": "t:typography_options.heading_large" },
        { "value": "h5", "label": "t:typography_options.heading_medium" },
        { "value": "h6", "label": "t:typography_options.heading_small" },
        { "value": "h7", "label": "t:typography_options.heading_extra_small" },
        { "value": "custom", "label": "t:typography_options.custom" }
      ],
      "default": "h2"
    },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "page" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
