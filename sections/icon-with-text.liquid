{% render 'section-stylesheet', asset: 'section-icon-with-text.css', defer_on_home: true %}

{% liquid
  assign item_count = section.blocks | where: 'type', 'item' | size
  assign header_count = section.blocks | where: 'type', 'header' | size
  assign section_background = section.settings.background_color
  if section_background == blank
    assign section_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif

  assign item_alignment = section.settings.content_alignment | default: 'center'
  assign item_flex_alignment = 'center'
  if item_alignment == 'left'
    assign item_flex_alignment = 'flex-start'
  elsif item_alignment == 'right'
    assign item_flex_alignment = 'flex-end'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section_background }};
  }
{% endstyle %}

{% if item_count > 0 or header_count > 0 %}
  <div
    class="icon-with-text icon-with-text--icon-{{ section.settings.icon_size | default: 'small' }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top | default: 10 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px; --icon-with-text-column-gap: {{ section.settings.column_gap | default: 20 }}px; --icon-with-text-mobile-column-gap: {{ section.settings.mobile_column_gap | default: 12 }}px; --icon-with-text-row-gap: {{ section.settings.row_gap | default: 40 }}px; --icon-with-text-content-gap: {{ section.settings.content_gap | default: 24 }}px; --icon-with-text-item-alignment: {{ item_flex_alignment }}; --icon-with-text-item-text-alignment: {{ item_alignment }}; --icon-with-text-columns-desktop: {{ section.settings.columns_desktop | default: 1 }}; --icon-with-text-columns-tablet: {{ section.settings.columns_desktop | default: 1 }}; --icon-with-text-columns-mobile: {{ section.settings.columns_mobile | default: 1 }};"
  >
    <div class="icon-with-text__inner section-spacing">
      {% if header_count > 0 %}
        <header class="icon-with-text__header">
          {% for block in section.blocks %}
            {% if block.type == 'header' %}
              {% assign icon_with_text_header_text_class = 'icon-with-text__intro content-text content-text--' | append: block.settings.text_size %}
              {% capture header_attributes %}{{ block.shopify_attributes }}{% endcapture %}
              {% render 'section-header',
                heading: block.settings.heading,
                heading_tag: block.settings.heading_tag,
                heading_size: block.settings.heading_size,
                heading_class: 'icon-with-text__heading',
                text: block.settings.text,
                text_class: icon_with_text_header_text_class,
                alignment: 'center',
                class: 'icon-with-text__header-content',
                tag: 'div',
                attributes: header_attributes
              %}
            {% endif %}
          {% endfor %}
        </header>
      {% endif %}

      {% if item_count > 0 %}
        <div class="icon-with-text__list" role="list" data-reveal-group>
            {% assign icon_with_text_reveal_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'item' %}
                {% assign item_heading = block.settings.title | default: block.settings.heading %}
                {% assign item_anchor = block.settings.anchor_id | handleize %}
                {% if item_anchor != blank %}
                  <a class="icon-with-text__item-link" href="#{{ item_anchor }}">
                {% endif %}
                <div class="icon-with-text__item icon-with-text__item--{{ section.settings.item_style | default: 'default' }}" role="listitem" data-reveal-item style="--reveal-order: {{ icon_with_text_reveal_index }};" {{ block.shopify_attributes }}>
                  <div class="icon-with-text__icon" aria-hidden="true">
                    {% if block.settings.icon != blank %}
                      {% render 'responsive-image',
                        image: block.settings.icon,
                        max_width: 96,
                        widths: '32, 48, 64, 96',
                        sizes: '32px',
                        class: 'icon-with-text__icon-image',
                        loading: 'lazy',
                        decorative: true
                      %}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'icon-with-text__icon-placeholder' }}
                    {% endif %}
                  </div>

                  <div class="icon-with-text__content">
                    {% if item_heading != blank %}
                      <{{ section.settings.heading_tag }} class="icon-with-text__heading {% render 'typography-class', preset: section.settings.heading_size, fallback: 'h4' %}">
                        {{ item_heading | escape }}
                      </{{ section.settings.heading_tag }}>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <div class="icon-with-text__text content-text spinel-text--{{ section.settings.text_size }} content-text--{{ section.settings.text_size }} rte">
                        {{ block.settings.text }}
                      </div>
                    {% endif %}
                  </div>
                </div>
                {% if item_anchor != blank %}
                  </a>
                {% endif %}
                {% assign icon_with_text_reveal_index = icon_with_text_reveal_index | plus: 1 %}
              {% endif %}
            {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}



{% schema %}
