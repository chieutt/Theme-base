{% render 'section-stylesheet', asset: 'section-image-with-text.css', defer_on_home: true %}

{% liquid
  assign image_with_text_background = section.settings.background_color
  assign image_with_text_collage_border = section.settings.background_color
  if image_with_text_background == blank
    assign image_with_text_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
    assign image_with_text_collage_border = section.settings.color_scheme.settings.background
  endif
%}

{% capture image_with_text_hero_block %}
  {% content_for 'block', type: 'media', id: 'hero_image' %}
{% endcapture %}
{% capture image_with_text_portrait_block %}
  {% content_for 'block', type: 'media', id: 'portrait_image' %}
{% endcapture %}

{% style %}
  #shopify-section-{{ section.id }} { background: {{ image_with_text_background }}; }
  #shopify-section-{{ section.id }} .image-with-text { background: transparent; }
{% endstyle %}

<div
  class="image-with-text image-with-text--layout-{{ section.settings.layout | default: 'standard' }} image-with-text--media-{{ section.settings.media_position }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} image-with-text--full full-width{% endif %}"
  style="--image-with-text-column-gap: {{ section.settings.column_gap }}px; --image-with-text-story-height: {{ section.settings.story_collage_height | default: 580 }}px; --image-with-text-collage-border: {{ image_with_text_collage_border }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="image-with-text__inner section-spacing">
    {% if section.settings.layout == 'story-collage' %}
      <div class="image-with-text__story-collage" data-reveal-group>
        <div class="image-with-text__story-media image-with-text__story-media--main" data-reveal-item style="--reveal-order: 0;">
          {{ image_with_text_hero_block }}
        </div>
        <div class="image-with-text__story-media image-with-text__story-media--detail" data-reveal-item style="--reveal-order: 1;">
          {% content_for 'block', type: 'media', id: 'detail_image' %}
        </div>
        <div class="image-with-text__story-media image-with-text__story-media--portrait" data-reveal-item style="--reveal-order: 2;">
          {{ image_with_text_portrait_block }}
        </div>
        <div class="image-with-text__story-location" data-reveal-item style="--reveal-order: 3;">
          {% content_for 'block', type: 'label', id: 'location_label' %}
        </div>
      </div>
    {% else %}
      <div class="image-with-text__media-collage">
        <div class="image-with-text__media image-with-text__media--base">
          {{ image_with_text_hero_block }}
        </div>
      </div>
    {% endif %}

    <div class="image-with-text__content image-with-text__content--{{ section.settings.content_alignment }}">
      {% unless section.settings.layout == 'story-collage' %}
        <div class="image-with-text__heading-block image-with-text__heading">
          {% content_for 'block', type: 'label', id: 'eyebrow' %}
        </div>
      {% endunless %}
      <div class="image-with-text__heading-block image-with-text__heading">
        {% content_for 'block', type: 'heading', id: 'heading' %}
      </div>
      {% unless section.settings.layout == 'story-collage' %}
        <div class="image-with-text__heading-block image-with-text__heading">
          {% content_for 'block', type: 'heading', id: 'highlight_heading' %}
        </div>
      {% endunless %}
      <div class="image-with-text__text">
        {% content_for 'block', type: 'text', id: 'text' %}
      </div>
      <div class="image-with-text__button-block">
        {% content_for 'block', type: 'button', id: 'button' %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "image-with-text-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "standard", "label": "Image and text" }, { "value": "story-collage", "label": "Story collage" }], "default": "standard" },
    { "type": "select", "id": "media_position", "label": "Media position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text_alignment", "id": "content_alignment", "label": "Content alignment", "default": "left" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "page" },
    { "type": "range", "id": "column_gap", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Content column gap", "default": 40 },
    { "type": "range", "id": "story_collage_height", "min": 420, "max": 760, "step": 20, "unit": "px", "label": "Desktop collage height", "default": 580, "visible_if": "{{ section.settings.layout == 'story-collage' }}" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    {
      "name": "Image with text — Story collage",
      "category": "Editorial content",
      "settings": {
        "layout": "story-collage",
        "media_position": "left",
        "content_alignment": "left",
        "section_width": "page",
        "column_gap": 64,
        "story_collage_height": 580,
        "padding_top": 96,
        "padding_bottom": 96,
        "color_scheme": "scheme-1"
      },
      "blocks": [
        { "type": "media", "id": "hero_image", "static": true, "settings": { "ratio": "portrait" } },
        { "type": "media", "id": "detail_image", "static": true, "settings": { "ratio": "landscape" } },
        { "type": "media", "id": "portrait_image", "static": true, "settings": { "ratio": "portrait" } },
        { "type": "label", "id": "location_label", "static": true, "settings": { "text": "<p>PARIS 8E · EST. 2012</p>", "reveal_type": "fade-up", "reveal_delay": 300 } },
        { "type": "heading", "id": "heading", "static": true, "settings": { "heading": "<h2>Crafted for the<br>Quiet Hours</h2>", "type_preset": "h3", "reveal_type": "fade-up", "reveal_delay": 0 } },
        { "type": "text", "id": "text", "static": true, "settings": { "text": "<p>Spinel was born from a belief that the finest jewelry doesn’t announce itself loudly — it whispers. Each piece is handcrafted in our Parisian atelier by artisans who have spent decades perfecting their craft.</p><p>We work exclusively with ethically sourced metals and stones, and we produce in limited quantities. Because the things worth owning are never mass-produced.</p>", "type_preset": "sm", "width": "100%", "reveal_type": "fade-up", "reveal_delay": 150 } },
        { "type": "button", "id": "button", "static": true, "settings": { "label": "Our story", "style": "secondary", "icon": "arrow-right", "reveal_type": "fade-up", "reveal_delay": 300 } }
      ]
    }
  ]
}
{% endschema %}
